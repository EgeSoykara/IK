@using IK.Web.Models
@using IK.Web.Services

<div class="personnel-document-files">
    <div>
        <label for="@InputId">Belge dosyası</label>
        <InputFile id="@InputId"
                   OnChange="OnFileSelected"
                   accept=".pdf,.docx,.jpg,.jpeg,.png,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png"
                   disabled="@IsUploading"
                   class="dashboard-file-input"
                   aria-label="Belge dosyası seç" />
        <p class="dashboard-upload-hint">PDF, DOCX, JPG veya PNG · En fazla 20 MB</p>
        @if (IsUploading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="dashboard-upload-progress" />
        }
    </div>

    <MudTable Items="Documents" Dense="true" Hover="true" Class="management-data-table">
        <HeaderContent>
            <MudTh>Dosya</MudTh>
            <MudTh>Yüklenme</MudTh>
            <MudTh>İşlem</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Dosya">@context.OriginalFileName</MudTd>
            <MudTd DataLabel="Yüklenme">@context.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="İşlem">
                @if (EmployeeFileContentPolicy.CanPreviewDocument(context.ContentType))
                {
                    <MudTooltip Text="Önizle">
                        <MudIconButton Href="@($"/employee-files/documents/{context.EmployeeDocumentId}/preview")"
                                       Target="_blank"
                                       Rel="noopener noreferrer"
                                       Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Info"
                                       aria-label="@($"{context.OriginalFileName} belgesini önizle")" />
                    </MudTooltip>
                }
                <MudTooltip Text="İndir">
                    <MudIconButton Href="@($"/employee-files/documents/{context.EmployeeDocumentId}")"
                                   Icon="@Icons.Material.Filled.Download"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   aria-label="@($"{context.OriginalFileName} belgesini indir")" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Bu kayda bağlı belge bulunmuyor.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>

@code {
    [Parameter, EditorRequired]
    public string InputId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<EmployeeDocument> Documents { get; set; } = [];

    [Parameter]
    public bool IsUploading { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }
}
