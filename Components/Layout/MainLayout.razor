@inherits LayoutComponentBase
@using IK.Web.Services

<MudThemeProvider Theme="@StitchTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized Context="auth">
            <MudAppBar Elevation="1" Class="app-shell-bar">
                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Primary"
                               Edge="Edge.Start"
                               aria-label="Menüyü aç/kapat"
                               OnClick="@((e) => DrawerToggle())" />
                <div class="app-shell-title">
                    <MudText Typo="Typo.caption">KOOPBANK · İnsan Kaynakları</MudText>
                    <MudText Typo="Typo.h6">İK Personel Sicil ve İzin Modülü</MudText>
                </div>
                <MudSpacer />
                <div class="app-shell-user">
                    <MudText Typo="Typo.caption">Aktif oturum</MudText>
                    <MudText Typo="Typo.body2">@auth.User.GetDisplayName()</MudText>
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Logout" Href="/logout">
                    Çıkış Yap
                </MudButton>
            </MudAppBar>
            <MudDrawer @bind-Open="@_drawerOpen" Elevation="0" Class="app-shell-drawer">
                <div class="app-shell-brand" aria-label="KOOPBANK İnsan Kaynakları">
                    <span class="app-shell-brand-mark" aria-hidden="true">K</span>
                    <span>
                        <strong>KOOPBANK</strong>
                        <small>İnsan Kaynakları</small>
                    </span>
                </div>
                <NavMenu/>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
    <MudMainContent Class="app-shell-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="app-shell-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
