    private IQueryable<LeaveCancellationRequest> ApplyCancellationHistorySearch(
        IQueryable<LeaveCancellationRequest> query)
    {
        if (SearchForm.RequestId.HasValue)
            query = query.Where(item => item.LeaveRequestId == SearchForm.RequestId.Value);

        if (!string.IsNullOrWhiteSpace(SearchForm.RequesterName))
        {
            var requesterName = SearchForm.RequesterName.Trim();
            query = query.Where(item =>
                item.LeaveRequest.Employee.FirstName.Contains(requesterName) ||
                item.LeaveRequest.Employee.LastName.Contains(requesterName) ||
                (item.LeaveRequest.Employee.FirstName + " "
                    + item.LeaveRequest.Employee.LastName).Contains(requesterName));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.LeaveTypeName))
        {
            var leaveTypeName = SearchForm.LeaveTypeName.Trim();
            query = query.Where(item =>
                (item.LeaveRequest.Category == LeaveRequestCategory.AnnualLeave
                    && leaveTypeName == "Yıllık İzin")
                || (item.LeaveRequest.Category == LeaveRequestCategory.SpecificLeaveType
                    && item.LeaveRequest.LeaveType != null
                    && item.LeaveRequest.LeaveType.Name.Contains(leaveTypeName)));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.ApproverName))
        {
            var approverName = SearchForm.ApproverName.Trim();
            query = query.Where(item => item.Approvals.Any(approval =>
                approval.ApproverEmployee != null
                && (approval.ApproverEmployee.FirstName.Contains(approverName)
                    || approval.ApproverEmployee.LastName.Contains(approverName)
                    || (approval.ApproverEmployee.FirstName + " "
                        + approval.ApproverEmployee.LastName).Contains(approverName)))
                || (item.IsDirectCancellation
                    && item.RequestedByEmployee != null
                    && (item.RequestedByEmployee.FirstName.Contains(approverName)
                        || item.RequestedByEmployee.LastName.Contains(approverName)
                        || (item.RequestedByEmployee.FirstName + " "
                            + item.RequestedByEmployee.LastName).Contains(approverName)))
                || (item.IsDirectCancellation
                    && item.RequestedByDisplayName != null
                    && item.RequestedByDisplayName.Contains(approverName)));
        }

        if (SearchForm.ApproverRole.HasValue)
            query = query.Where(item => item.Approvals.Any(
                approval => approval.ApproverRole == SearchForm.ApproverRole.Value));
        if (SearchForm.Decision.HasValue)
        {
            var status = SearchForm.Decision.Value == LeaveApprovalDecision.Approved
                ? LeaveRequestStatus.Approved
                : LeaveRequestStatus.Rejected;
            query = query.Where(item => item.CurrentStatus == status);
        }

        return query;
    }

    private async Task ReloadLeaveApprovalTablesAsync(bool resetPage = false)
    {
        var reloadTasks = new List<Task>(4);

        if (IncomingApprovalTable is not null)
        {
            if (resetPage && IncomingApprovalTable.CurrentPage != 0)
            {
                IncomingApprovalTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(IncomingApprovalTable.ReloadServerData());
            }
        }

        if (DecisionHistoryTable is not null)
        {
            if (resetPage && DecisionHistoryTable.CurrentPage != 0)
            {
                DecisionHistoryTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(DecisionHistoryTable.ReloadServerData());
            }
        }

        if (CancellationApprovalTable is not null)
        {
            if (resetPage && CancellationApprovalTable.CurrentPage != 0)
            {
                CancellationApprovalTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(CancellationApprovalTable.ReloadServerData());
            }
        }

        if (CancellationHistoryTable is not null)
        {
            if (resetPage && CancellationHistoryTable.CurrentPage != 0)
            {
                CancellationHistoryTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(CancellationHistoryTable.ReloadServerData());
            }
        }

        await Task.WhenAll(reloadTasks);
    }

    private IQueryable<LeaveApproval> BuildVisibleLeaveApprovalsDisplayQuery(IQueryable<LeaveApproval> query)
    {
        return query
            .VisibleTo(CurrentUser)
            .Include(approval => approval.Request)
                .ThenInclude(request => request.Employee)
            .Include(approval => approval.Request)
                .ThenInclude(request => request.LeaveType)
            .Include(approval => approval.ApproverEmployee);
    }

    private static string BuildSuccessMessage(LeaveApproverRole approverRole, bool approve)
    {
        return approverRole switch
        {
            LeaveApproverRole.Manager when approve =>
                "Yönetici onayı kaydedildi ve insan kaynakları adımı beklemeye alındı.",
            LeaveApproverRole.Manager =>
                "Yönetici reddi kaydedildi ve talep kapatıldı.",
            LeaveApproverRole.HumanResources when approve =>
                "İnsan kaynakları onayı kaydedildi ve izin bakiyesi güncellendi.",
            _ =>
                "İnsan kaynakları reddi kaydedildi ve talep kapatıldı."
        };
    }

    private static string FormatDecisionDate(DateTimeOffset? decisionDate)
    {
        return decisionDate?.ToLocalTime().ToString("g") ?? "-";
    }

    private static string FormatRequestedDays(decimal requestedDays)
    {
        return requestedDays.ToString("0.##");
    }

    private static string FormatEmployeeName(Employee? employee)
    {
        if (employee is null)
        {
            return "-";
        }

        var fullName = $"{employee.FirstName} {employee.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "-" : fullName;
    }

    private static string FormatApproverRole(LeaveApproverRole approverRole)
    {
        return approverRole switch
        {
            LeaveApproverRole.Manager => "Yönetici",
            LeaveApproverRole.HumanResources => "İnsan Kaynakları",
            _ => approverRole.ToString()
        };
    }

    private static string FormatApprovalDecision(LeaveApprovalDecision decision)
    {
        return decision switch
        {
            LeaveApprovalDecision.Pending => "Beklemede",
            LeaveApprovalDecision.Approved => "Onaylandı",
            LeaveApprovalDecision.Rejected => "Reddedildi",
            _ => decision.ToString()
        };
    }

    private static string ApprovalStatusClass(LeaveApprovalDecision decision)
    {
        return decision switch
        {
            LeaveApprovalDecision.Approved => "leave-approval-status leave-approval-status-approved",
            LeaveApprovalDecision.Rejected => "leave-approval-status leave-approval-status-rejected",
            _ => "leave-approval-status leave-approval-status-pending"
        };
    }

    private static string FormatCancellationRange(LeaveCancellationRequest request) =>
        request.CancellationStartDate.Date == request.CancellationEndDate.Date
            ? request.CancellationStartDate.ToString("dd.MM.yyyy")
            : $"{request.CancellationStartDate:dd.MM.yyyy} – {request.CancellationEndDate:dd.MM.yyyy}";

    private static string FormatCancellationHistoryStatus(LeaveCancellationRequest request) =>
        request.IsDirectCancellation
            ? "Doğrudan iptal edildi"
            : request.CurrentStatus == LeaveRequestStatus.Approved
                ? "İptal onaylandı"
                : "İptal reddedildi";

    private static string CancellationHistoryStatusClass(LeaveCancellationRequest request) =>
        request.CurrentStatus == LeaveRequestStatus.Approved && !request.IsDirectCancellation
            ? "leave-approval-status leave-approval-status-approved"
            : "leave-approval-status leave-approval-status-rejected";

    private static string FormatCancellationDecisionBy(LeaveCancellationRequest request)
    {
        if (request.IsDirectCancellation)
        {
            if (request.RequestedByEmployee is not null)
            {
                return FormatEmployeeName(request.RequestedByEmployee);
            }

            return string.IsNullOrWhiteSpace(request.RequestedByDisplayName)
                ? "Geçiş öncesi kayıt"
                : request.RequestedByDisplayName;
        }

        var approval = request.Approvals
            .Where(item => item.Decision != LeaveApprovalDecision.Pending)
            .OrderByDescending(item => item.DecisionDate)
            .ThenByDescending(item => item.CancellationApprovalId)
            .FirstOrDefault();
        return approval?.ApproverEmployee is null
            ? "Sistem"
            : FormatEmployeeName(approval.ApproverEmployee);
    }

    private void SetFeedback(Severity severity, string message)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = message;
    }

    private int ActorId() => CurrentUser.GetRequiredEmployeeId();

    private sealed class LeaveApprovalDecisionForm : IValidatableObject
    {
        [Range(1, int.MaxValue, ErrorMessage = "Talep ID zorunludur.")]
        public int RequestId { get; set; }

        public LeaveApproverRole? ApproverRole { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Onaylayıcı zorunludur.")]
        public int ApproverEmployeeId { get; set; }

        public LeaveApprovalDecision? Decision { get; set; }

        [MaxLength(500)]
        public string? Comment { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (ApproverRole is null)
            {
                yield return new ValidationResult("Onaylayıcı rolü zorunludur.", [nameof(ApproverRole)]);
            }

            if (Decision is null)
            {
                yield return new ValidationResult("Karar zorunludur.", [nameof(Decision)]);
            }

            if (Decision == LeaveApprovalDecision.Rejected && string.IsNullOrWhiteSpace(Comment))
            {
                yield return new ValidationResult(
                    "Reddedilen onaylarda gerekçe belirtilmelidir.",
                    [nameof(Comment)]);
            }
        }
    }

    private sealed class LeaveApprovalSearchForm
    {
        public int? RequestId { get; set; }
        public string? RequesterName { get; set; }
        public string? LeaveTypeName { get; set; }
        public string? ApproverName { get; set; }
        public LeaveApproverRole? ApproverRole { get; set; }
        public LeaveApprovalDecision? Decision { get; set; }

        public LeaveApprovalSearchForm Clone()
        {
            return new LeaveApprovalSearchForm
            {
                RequestId = RequestId,
                RequesterName = RequesterName,
                LeaveTypeName = LeaveTypeName,
                ApproverName = ApproverName,
                ApproverRole = ApproverRole,
                Decision = Decision
            };
        }

        public LeaveApprovalSearchForm Normalize()
        {
            var normalized = Clone();
            normalized.RequesterName = ManagementFilterValue.Normalize(normalized.RequesterName);
            normalized.LeaveTypeName = ManagementFilterValue.Normalize(normalized.LeaveTypeName);
            normalized.ApproverName = ManagementFilterValue.Normalize(normalized.ApproverName);
            return normalized;
        }
    }
