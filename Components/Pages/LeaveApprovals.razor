    private async Task TransferDelegationAsync()
    {
        if (TransferContext is null || !CurrentEmployeeId.HasValue || !TransferDelegateEmployeeId.HasValue)
        {
            SetFeedback(Severity.Error, "Yeni aktif vekil seçimi zorunludur.");
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Vekâlet Devrini Onayla",
            "Aktif yöneticilik yetkisini seçilen çalışana devretmek istediğinizden emin misiniz?",
            yesText: "Devret",
            cancelText: "İptal");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await ManagerDelegationService.TransferActiveDelegationAsync(
                TransferContext.DepartmentId,
                CurrentEmployeeId.Value,
                TransferDelegateEmployeeId.Value,
                ActorId());
            IsTransferDialogOpen = false;
            TransferDelegateEmployeeId = null;
            NavigationManager.NavigateTo(
                "/LeaveTracking",
                forceLoad: true,
                replace: true);
        }
        catch (InvalidOperationException exception)
        {
            SetFeedback(Severity.Error, exception.Message);
        }
    }

