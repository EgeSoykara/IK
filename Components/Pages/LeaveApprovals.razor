    private IReadOnlyList<ManagementFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ManagementFilter>();
            if (SearchForm.RequestId.HasValue) filters.Add(new(nameof(LeaveApprovalSearchForm.RequestId), $"Talep ID: {SearchForm.RequestId}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.RequesterName)) filters.Add(new(nameof(LeaveApprovalSearchForm.RequesterName), $"Talep eden: {SearchForm.RequesterName.Trim()}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.LeaveTypeName)) filters.Add(new(nameof(LeaveApprovalSearchForm.LeaveTypeName), $"İzin türü: {SearchForm.LeaveTypeName.Trim()}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.ApproverName)) filters.Add(new(nameof(LeaveApprovalSearchForm.ApproverName), $"Onaylayıcı: {SearchForm.ApproverName.Trim()}"));
            if (SearchForm.ApproverRole.HasValue) filters.Add(new(nameof(LeaveApprovalSearchForm.ApproverRole), $"Rol: {FormatApproverRole(SearchForm.ApproverRole.Value)}"));
            if (SearchForm.Decision.HasValue) filters.Add(new(nameof(LeaveApprovalSearchForm.Decision), $"Karar: {FormatApprovalDecision(SearchForm.Decision.Value)}"));
            return filters;
        }
    }

    private async Task<TableData<LeaveApproval>> LoadIncomingApprovalsAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        await using var readDatabase = await DatabaseFactory.CreateDbContextAsync(cancellationToken);
        var query = ApplyLeaveApprovalSearch(
            BuildVisibleLeaveApprovalsDisplayQuery(readDatabase.LeaveApprovals.AsNoTracking()))
            .Where(approval => approval.Decision == LeaveApprovalDecision.Pending);

        return await query
            .OrderByDescending(a => a.CreatedAt)
            .ThenByDescending(a => a.ApprovalId)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
    }

    private async Task<TableData<LeaveApproval>> LoadDecisionHistoryAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        await using var readDatabase = await DatabaseFactory.CreateDbContextAsync(cancellationToken);
        var query = ApplyLeaveApprovalSearch(
            BuildVisibleLeaveApprovalsDisplayQuery(readDatabase.LeaveApprovals.AsNoTracking()))
            .Where(approval => approval.Decision != LeaveApprovalDecision.Pending);

        return await query
            .OrderByDescending(approval => approval.DecisionDate)
            .ThenByDescending(approval => approval.ApprovalId)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
    }

    private IQueryable<LeaveApproval> ApplyLeaveApprovalSearch(IQueryable<LeaveApproval> query)
    {
        if (SearchForm.RequestId.HasValue)
            query = query.Where(a => a.RequestId == SearchForm.RequestId.Value);

        if (!string.IsNullOrWhiteSpace(SearchForm.RequesterName))
        {
            var requesterName = SearchForm.RequesterName.Trim();
            query = query.Where(a =>
                a.Request.Employee.FirstName.Contains(requesterName) ||
                a.Request.Employee.LastName.Contains(requesterName) ||
                (a.Request.Employee.FirstName + " " + a.Request.Employee.LastName).Contains(requesterName));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.LeaveTypeName))
        {
            var leaveTypeName = SearchForm.LeaveTypeName.Trim();
            query = query.Where(approval =>
                (approval.Request.Category == LeaveRequestCategory.AnnualLeave
                    && leaveTypeName == "Yıllık İzin")
                || (approval.Request.Category == LeaveRequestCategory.SpecificLeaveType
                    && approval.Request.LeaveType != null
                    && approval.Request.LeaveType.Name.Contains(leaveTypeName)));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.ApproverName))
        {
            var approverName = SearchForm.ApproverName.Trim();
            query = query.Where(a =>
                a.ApproverEmployee != null &&
                (a.ApproverEmployee.FirstName.Contains(approverName) ||
                 a.ApproverEmployee.LastName.Contains(approverName) ||
                 (a.ApproverEmployee.FirstName + " " + a.ApproverEmployee.LastName).Contains(approverName)));
        }

        if (SearchForm.ApproverRole.HasValue)
            query = query.Where(a => a.ApproverRole == SearchForm.ApproverRole.Value);
        if (SearchForm.Decision.HasValue)
            query = query.Where(a => a.Decision == SearchForm.Decision.Value);

        return query;
    }

    private async Task ReloadLeaveApprovalTablesAsync(bool resetPage = false)
    {
        var reloadTasks = new List<Task>(2);

        if (IncomingApprovalTable is not null)
        {
            if (resetPage && IncomingApprovalTable.CurrentPage != 0)
            {
                IncomingApprovalTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(IncomingApprovalTable.ReloadServerData());
            }
        }

        if (DecisionHistoryTable is not null)
        {
            if (resetPage && DecisionHistoryTable.CurrentPage != 0)
            {
                DecisionHistoryTable.NavigateTo(0);
            }
            else
            {
                reloadTasks.Add(DecisionHistoryTable.ReloadServerData());
            }
        }

        await Task.WhenAll(reloadTasks);
    }

    private IQueryable<LeaveApproval> BuildVisibleLeaveApprovalsDisplayQuery(IQueryable<LeaveApproval> query)
    {
        return query
            .VisibleTo(CurrentUser)
            .Include(approval => approval.Request)
                .ThenInclude(request => request.Employee)
            .Include(approval => approval.Request)
                .ThenInclude(request => request.LeaveType)
            .Include(approval => approval.ApproverEmployee);
    }

    private static string BuildSuccessMessage(LeaveApproverRole approverRole, bool approve)
    {
        return approverRole switch
        {
            LeaveApproverRole.Manager when approve =>
                "Yönetici onayı kaydedildi ve insan kaynakları adımı beklemeye alındı.",
            LeaveApproverRole.Manager =>
                "Yönetici reddi kaydedildi ve talep kapatıldı.",
            LeaveApproverRole.HumanResources when approve =>
                "İnsan kaynakları onayı kaydedildi ve izin bakiyesi güncellendi.",
            _ =>
                "İnsan kaynakları reddi kaydedildi ve talep kapatıldı."
        };
    }

    private static string FormatDecisionDate(DateTimeOffset? decisionDate)
    {
        return decisionDate?.ToLocalTime().ToString("g") ?? "-";
    }

    private static string FormatRequestedDays(decimal requestedDays)
    {
        return requestedDays.ToString("0.##");
    }

    private static string FormatEmployeeName(Employee? employee)
    {
        if (employee is null)
        {
            return "-";
        }

        var fullName = $"{employee.FirstName} {employee.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? "-" : fullName;
    }

    private static string FormatApproverRole(LeaveApproverRole approverRole)
    {
        return approverRole switch
        {
            LeaveApproverRole.Manager => "Yönetici",
            LeaveApproverRole.HumanResources => "İnsan Kaynakları",
            _ => approverRole.ToString()
        };
    }

    private static string FormatApprovalDecision(LeaveApprovalDecision decision)
    {
        return decision switch
        {
            LeaveApprovalDecision.Pending => "Beklemede",
            LeaveApprovalDecision.Approved => "Onaylandı",
            LeaveApprovalDecision.Rejected => "Reddedildi",
            _ => decision.ToString()
        };
    }

    private static string ApprovalStatusClass(LeaveApprovalDecision decision)
    {
        return decision switch
        {
            LeaveApprovalDecision.Approved => "leave-approval-status leave-approval-status-approved",
            LeaveApprovalDecision.Rejected => "leave-approval-status leave-approval-status-rejected",
            _ => "leave-approval-status leave-approval-status-pending"
        };
    }

