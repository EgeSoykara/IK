@attribute [Authorize]
@page "/LeaveApprovals"
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService
@inject ManagerDelegationService ManagerDelegationService

<div class="management-shell leave-approval-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Yönetim</MudText>
            <h1>İzin Onayları</h1>
            <p>Bekleyen izin onaylarını değerlendirin ve karar geçmişini izleyin.</p>
        </div>
        @if (TransferContext is not null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.SwapHoriz"
                       OnClick="OpenTransferDialog">
                Vekâleti Devret
            </MudButton>
        }
    </section>

@if (FeedbackMessage is not null && !IsLeaveApprovalDialogOpen)
{
    <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
}
<MudDialog @bind-Visible="IsTransferDialogOpen" Options="TransferDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Aktif Vekâleti Devret</MudText>
    </TitleContent>
    <DialogContent>
        @if (FeedbackMessage is not null)
        {
            <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
        }
        <MudText Class="mb-3">
            @TransferContext?.DepartmentName departmanındaki aktif yöneticilik, izin talebi oluşturmadan seçtiğiniz çalışana geçer.
            Ana yönetici döndüğünde vekâlet zinciri otomatik kapanır.
        </MudText>
        @if (TransferContext?.Candidates.Count > 0)
        {
            <MudSelect T="int?"
                       @bind-Value="TransferDelegateEmployeeId"
                       Label="Yeni Aktif Vekil"
                       Required="true"
                       RequiredError="Yeni aktif vekil seçimi zorunludur.">
                @foreach (var candidate in TransferContext.Candidates)
                {
                    <MudSelectItem T="int?" Value="@((int?)candidate.EmployeeId)">
                        @($"{candidate.EmployeeName} ({candidate.SicilNo})")
                    </MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                Vekâlet devri için uygun başka bir aktif çalışan bulunmuyor.
            </MudAlert>
        }
        <div class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseTransferDialog">İptal</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(TransferContext is null || TransferContext.Candidates.Count == 0)"
                       OnClick="TransferDelegationAsync">
                Vekâleti Devret
            </MudButton>
        </div>
    </DialogContent>
</MudDialog>
<MudDialog @bind-Visible="IsLeaveApprovalDialogOpen" Options="LeaveApprovalDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">İzin Onay İşlemi</MudText>
    </TitleContent>
    <DialogContent>
        @if (FeedbackMessage is not null)
        {
            <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
        }
        <EditForm Model="@Form" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit" FormName="LeaveApprovalsForm">
            <DataAnnotationsValidator />
            @if (SelectedApproval is not null)
            {
                <section class="leave-approval-request-summary" aria-label="Talep özeti">
                    <div>
                        <span>Talep ID</span>
                        <strong>#@SelectedApproval.RequestId</strong>
                    </div>
                    <div>
                        <span>Talep Eden</span>
                        <strong>@FormatEmployeeName(SelectedApproval.Request.Employee)</strong>
                    </div>
                    <div>
                        <span>İzin Türü</span>
                        <strong>@SelectedApproval.Request.DisplayName()</strong>
                    </div>
                    <div>
                        <span>Talep Edilen Gün</span>
                        <strong>@FormatRequestedDays(SelectedApproval.Request.RequestedDays) gün</strong>
                    </div>
                    <div>
                        <span>Onaylayıcı Rolü</span>
                        <strong>@FormatApproverRole(SelectedApproval.ApproverRole)</strong>
                    </div>
                    <div>
                        <span>Onaylayıcı</span>
                        <strong>@CurrentUser?.Identity?.Name</strong>
                    </div>
                </section>
            }

            <fieldset class="leave-approval-decision-fieldset">
                <legend>Kararınızı seçin</legend>
                <div class="leave-approval-decision-options">
                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Outlined"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Class="@DecisionOptionClass(LeaveApprovalDecision.Approved)"
                               aria-pressed="@(Form.Decision == LeaveApprovalDecision.Approved)"
                               OnClick="@(() => SelectDecision(LeaveApprovalDecision.Approved))">
                        Onayla
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Cancel"
                               Class="@DecisionOptionClass(LeaveApprovalDecision.Rejected)"
                               aria-pressed="@(Form.Decision == LeaveApprovalDecision.Rejected)"
                               OnClick="@(() => SelectDecision(LeaveApprovalDecision.Rejected))">
                        Reddet
                    </MudButton>
                </div>
                <ValidationMessage For="@(() => Form.Decision)" />
            </fieldset>

            <MudTextField T="string"
                          @bind-Value="Form.Comment"
                          Label="@(Form.Decision == LeaveApprovalDecision.Rejected ? "Ret gerekçesi" : "Karar notu (isteğe bağlı)")"
                          HelperText="@(Form.Decision == LeaveApprovalDecision.Rejected ? "Ret kararında gerekçe zorunludur." : "Karara ilişkin ek bilgi paylaşabilirsiniz.")"
                          Lines="3"
                          For="@(() => Form.Comment)" />
            <div class="leave-approval-dialog-actions">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseLeaveApprovalDialog">
                    Vazgeç
                </MudButton>
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="@DecisionSubmitColor"
                           StartIcon="@DecisionSubmitIcon"
                           Disabled="@(Form.Decision is null)">
                    @DecisionSubmitLabel
                </MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="IsSearchDialogOpen" Options="LeaveApprovalDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">İzin Onayı Ara</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="int?" @bind-Value="SearchDraft.RequestId" Label="Talep ID" />
        <MudAutocomplete T="string"
                         @bind-Value="SearchDraft.RequesterName"
                         Label="Talep Eden"
                         SearchFunc="SearchRequesterNamesAsync"
                         CoerceValue="true"
                         ResetValueOnEmptyText="true"
                         Clearable="true" />
        <MudAutocomplete T="string"
                         @bind-Value="SearchDraft.LeaveTypeName"
                         Label="İzin Türü"
                         SearchFunc="SearchLeaveTypeNamesAsync"
                         CoerceValue="true"
                         ResetValueOnEmptyText="true"
                         Clearable="true" />
        <MudAutocomplete T="string"
                         @bind-Value="SearchDraft.ApproverName"
                         Label="Onaylayıcı"
                         SearchFunc="SearchApproverNamesAsync"
                         CoerceValue="true"
                         ResetValueOnEmptyText="true"
                         Clearable="true" />
        <MudSelect T="LeaveApproverRole?" @bind-Value="SearchDraft.ApproverRole" Label="Onaylayıcı Rolü" Clearable="true">
            <MudSelectItem T="LeaveApproverRole?" Value="@(null)">Tümü</MudSelectItem>
            <MudSelectItem T="LeaveApproverRole?" Value="@((LeaveApproverRole?)LeaveApproverRole.Manager)">Yönetici</MudSelectItem>
            <MudSelectItem T="LeaveApproverRole?" Value="@((LeaveApproverRole?)LeaveApproverRole.HumanResources)">İnsan Kaynakları</MudSelectItem>
        </MudSelect>
        <MudSelect T="LeaveApprovalDecision?" @bind-Value="SearchDraft.Decision" Label="Karar" Clearable="true">
            <MudSelectItem T="LeaveApprovalDecision?" Value="@(null)">Tümü</MudSelectItem>
            <MudSelectItem T="LeaveApprovalDecision?" Value="@((LeaveApprovalDecision?)LeaveApprovalDecision.Approved)">Onaylandı</MudSelectItem>
            <MudSelectItem T="LeaveApprovalDecision?" Value="@((LeaveApprovalDecision?)LeaveApprovalDecision.Rejected)">Reddedildi</MudSelectItem>
        </MudSelect>
        <div class="management-search-actions">
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">Filtreleri Temizle</MudButton>
            <div class="management-search-actions-primary">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">İptal</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">Ara</MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="IsCommentDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">Onay Açıklaması</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere;">@SelectedComment</MudText>
        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseCommentDialog">Kapat</MudButton>
        </div>
    </DialogContent>
</MudDialog>

@if (IsPageReady)
{
    <section class="leave-approval-section leave-approval-inbox" aria-labelledby="incoming-approvals-title">
        <div class="leave-approval-section-header">
            <div>
                <div class="leave-approval-section-title-row">
                    <h2 id="incoming-approvals-title">Gelen Talepler</h2>
                    <span class="leave-approval-count">@PendingApprovalCount bekleyen</span>
                </div>
                <p>Kararınızı bekleyen izin taleplerini inceleyin.</p>
            </div>
            <MudTooltip Text="Gelen taleplerde ara ve filtrele">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterList"
                           OnClick="OpenSearchDialog"
                           aria-label="Gelen taleplerde ara ve filtrele">
                    Filtrele
                </MudButton>
            </MudTooltip>
        </div>
        <ManagementActiveFilters Filters="ActiveFilters"
                                 OnRemove="RemoveFilterAsync"
                                 OnClearAll="ClearFiltersAsync" />
        <MudTable @ref="IncomingApprovalTable"
                  ServerData="LoadIncomingApprovalsAsync"
                  RowsPerPage="25"
                  Dense="true"
                  Hover="true"
                  Class="management-data-table">
            <HeaderContent>
                <MudTh>Talep ID</MudTh>
                <MudTh>Talep Eden</MudTh>
                <MudTh>İzin Türü</MudTh>
                <MudTh>Gün Sayısı</MudTh>
                <MudTh>Onaylayıcı Rolü</MudTh>
                <MudTh>Açıklama</MudTh>
                <MudTh>Durum</MudTh>
                <MudTh>İşlemler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Talep ID"><strong>#@context.RequestId</strong></MudTd>
                <MudTd DataLabel="Talep Eden">@FormatEmployeeName(context.Request.Employee)</MudTd>
                <MudTd DataLabel="İzin Türü">@context.Request.DisplayName()</MudTd>
                <MudTd DataLabel="Gün Sayısı">@FormatRequestedDays(context.Request.RequestedDays) gün</MudTd>
                <MudTd DataLabel="Onaylayıcı Rolü">@FormatApproverRole(context.ApproverRole)</MudTd>
                <MudTd DataLabel="Açıklama">
                    @if (string.IsNullOrWhiteSpace(context.Request.Reason))
                    {
                        @:-
                    }
                    else if (!RequiresExpandedTextDisplay(context.Request.Reason))
                    {
                        @context.Request.Reason
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   aria-label="Onay açıklama detayını görüntüle"
                                   OnClick="@(() => OpenCommentDialog(context.Request.Reason))">
                            Açıklamayı Gör
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="Durum"><span class="leave-approval-status leave-approval-status-pending">Beklemede</span></MudTd>
                <MudTd DataLabel="İşlemler">
                    <div class="leave-approval-row-actions">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.FactCheck"
                                   Class="leave-approval-decide-button"
                                   aria-label="@($"Talep {context.RequestId} için karar ver")"
                                   OnClick="@(() => OpenLeaveApprovalDialog(context))">
                            Karar Ver
                        </MudButton>
                        <MudTooltip Text="Sil">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Text"
                                           Color="Color.Error"
                                           Icon="@Icons.Material.Filled.Delete"
                                           aria-label="@($"Onay {context.ApprovalId} kaydını sil")"
                                           OnClick="@(() => DeleteLeaveApprovalAsync(context.ApprovalId))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Kararınızı bekleyen izin talebi bulunmuyor.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                               RowsPerPageString="Sayfa başına kayıt:"
                               InfoFormat="{first_item}-{last_item} / {all_items}" />
            </PagerContent>
        </MudTable>
    </section>

    <section class="leave-approval-section leave-approval-history" aria-labelledby="approval-history-title">
        <div class="leave-approval-section-header">
            <div>
                <h2 id="approval-history-title">Karar Geçmişi</h2>
                <p>Sonuçlandırılmış onay ve ret kayıtlarını izleyin.</p>
            </div>
        </div>
        <MudTable @ref="DecisionHistoryTable"
                  ServerData="LoadDecisionHistoryAsync"
                  RowsPerPage="25"
                  Dense="true"
                  Hover="true"
                  Class="management-data-table leave-approval-table leave-approval-history-table">
            <HeaderContent>
                <MudTh>Talep ID</MudTh>
                <MudTh>Talep Eden</MudTh>
                <MudTh>İzin Türü</MudTh>
                <MudTh>Gün Sayısı</MudTh>
                <MudTh>Onaylayıcı Rolü</MudTh>
                <MudTh>Onaylayıcı</MudTh>
                <MudTh>Karar</MudTh>
                <MudTh>Karar Tarihi</MudTh>
                <MudTh>Açıklama</MudTh>
                <MudTh>İşlemler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Talep ID">#@context.RequestId</MudTd>
                <MudTd DataLabel="Talep Eden">@FormatEmployeeName(context.Request.Employee)</MudTd>
                <MudTd DataLabel="İzin Türü">@context.Request.DisplayName()</MudTd>
                <MudTd DataLabel="Gün Sayısı">@FormatRequestedDays(context.Request.RequestedDays) gün</MudTd>
                <MudTd DataLabel="Onaylayıcı Rolü">@FormatApproverRole(context.ApproverRole)</MudTd>
                <MudTd DataLabel="Onaylayıcı">@FormatEmployeeName(context.ApproverEmployee)</MudTd>
                <MudTd DataLabel="Karar">
                    <span class="@ApprovalStatusClass(context.Decision)">@FormatApprovalDecision(context.Decision)</span>
                </MudTd>
                <MudTd DataLabel="Karar Tarihi">@FormatDecisionDate(context.DecisionDate)</MudTd>
                <MudTd DataLabel="Açıklama">
                    @if (string.IsNullOrWhiteSpace(context.Comment))
                    {
                        @:-
                    }
                    else if (!RequiresExpandedTextDisplay(context.Comment))
                    {
                        @context.Comment
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   aria-label="Onay açıklama detayını görüntüle"
                                   OnClick="@(() => OpenCommentDialog(context.Comment!))">
                            @BuildPreviewLabel(context.Comment!)
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="İşlemler">
                    <MudTooltip Text="Sil">
                        <MudIconButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Error"
                                       Icon="@Icons.Material.Filled.Delete"
                                       aria-label="@($"Onay {context.ApprovalId} kaydını sil")"
                                       OnClick="@(() => DeleteLeaveApprovalAsync(context.ApprovalId))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Henüz sonuçlandırılmış karar bulunmuyor.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                               RowsPerPageString="Sayfa başına kayıt:"
                               InfoFormat="{first_item}-{last_item} / {all_items}" />
            </PagerContent>
        </MudTable>
    </section>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private bool IsLeaveApprovalDialogOpen { get; set; }
    private bool IsSearchDialogOpen { get; set; }
    private bool IsCommentDialogOpen { get; set; }
    private bool IsTransferDialogOpen { get; set; }
    private bool IsPageReady { get; set; }
    private static readonly DialogOptions LeaveApprovalDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Medium, FullWidth = true
    };
    private static readonly DialogOptions TransferDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private LeaveApprovalDecisionForm Form { get; set; } = new();
    private LeaveApproval? SelectedApproval { get; set; }
    private LeaveApprovalSearchForm SearchForm { get; set; } = new();
    private LeaveApprovalSearchForm SearchDraft { get; set; } = new();
    private List<string> RequesterFilterOptions { get; set; } = [];
    private List<string> ApproverFilterOptions { get; set; } = [];
    private List<string> LeaveTypeFilterOptions { get; set; } = [];
    private ActiveDelegationTransferContext? TransferContext { get; set; }
    private int? TransferDelegateEmployeeId { get; set; }
    private MudTable<LeaveApproval>? IncomingApprovalTable { get; set; }
    private MudTable<LeaveApproval>? DecisionHistoryTable { get; set; }
    private static readonly int[] ManagementPageSizeOptions = [10, 25, 50, 100];
    private int? CurrentEmployeeId => CurrentUser.GetEmployeeId();
    private int PendingApprovalCount { get; set; }

    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private string SelectedComment { get; set; } = string.Empty;

    [Inject]
    public HumanResourcesDbContext Database { get; set; } = null!;

    [Inject]
    public IDbContextFactory<HumanResourcesDbContext> DatabaseFactory { get; set; } = null!;

    [Inject]
    public LeaveRequestService LeaveRequestService { get; set; } = null!;

    [Inject]
    public IDialogService DialogService { get; set; } = null!;

    [Inject]
    public AuditLogService AuditLogService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;

        if (!await PageAccessService.CanAccessLeaveApprovalsAsync(CurrentUser))
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }
        Form = new LeaveApprovalDecisionForm();
        await LoadDataAsync();
        IsPageReady = true;
    }

    private async Task OnValidSubmit(EditContext context)
    {
        try
        {
            var approve = Form.Decision == LeaveApprovalDecision.Approved;

            if (Form.ApproverRole == LeaveApproverRole.Manager)
            {
                await LeaveRequestService.ManagerDecisionAsync(
                    Form.RequestId, Form.ApproverEmployeeId, approve, Form.Comment, ActorId());
            }
            else
            {
                await LeaveRequestService.HumanResourcesDecisionAsync(
                    Form.RequestId, Form.ApproverEmployeeId, approve, Form.Comment, ActorId());
            }

            SetFeedback(Severity.Success, BuildSuccessMessage(Form.ApproverRole!.Value, approve));
            Form = new LeaveApprovalDecisionForm();
            SelectedApproval = null;
            IsLeaveApprovalDialogOpen = false;
            await LoadDataAsync();
            await ReloadLeaveApprovalTablesAsync();
        }
        catch (InvalidOperationException ex)
        {
            SetFeedback(Severity.Error, ex.Message);
        }
        catch (DbUpdateException)
        {
            SetFeedback(Severity.Error, "Onay kararı kaydedilirken beklenmeyen bir veritabanı hatası oluştu.");
        }
    }

    private void OnInvalidSubmit(EditContext context)
    {
        SetFeedback(Severity.Error, "Lütfen doğrulama hatalarını düzeltip yeniden gönderin.");
    }
    private void OpenLeaveApprovalDialog(LeaveApproval approval)
    {
        SelectedApproval = approval;
        Form = new LeaveApprovalDecisionForm
        {
            ApproverRole = approval.ApproverRole,
            ApproverEmployeeId = CurrentEmployeeId ?? 0,
            RequestId = approval.RequestId
        };
    
        FeedbackMessage = null;
        IsLeaveApprovalDialogOpen = true;
    }

    private void CloseLeaveApprovalDialog()
    {
        Form = new LeaveApprovalDecisionForm();
        SelectedApproval = null;
        FeedbackMessage = null;
        IsLeaveApprovalDialogOpen = false;
    }

    private void SelectDecision(LeaveApprovalDecision decision)
    {
        Form.Decision = decision;
    }

    private string DecisionOptionClass(LeaveApprovalDecision decision)
    {
        return Form.Decision == decision
            ? "leave-approval-decision-option leave-approval-decision-option-selected"
            : "leave-approval-decision-option";
    }

    private Color DecisionSubmitColor => Form.Decision switch
    {
        LeaveApprovalDecision.Approved => Color.Success,
        LeaveApprovalDecision.Rejected => Color.Error,
        _ => Color.Default
    };

    private string DecisionSubmitIcon => Form.Decision switch
    {
        LeaveApprovalDecision.Approved => Icons.Material.Filled.CheckCircle,
        LeaveApprovalDecision.Rejected => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.FactCheck
    };

    private string DecisionSubmitLabel => Form.Decision switch
    {
        LeaveApprovalDecision.Approved => "Onay Kararını Kaydet",
        LeaveApprovalDecision.Rejected => "Ret Kararını Kaydet",
        _ => "Kararınızı Seçin"
    };

    private async Task DeleteLeaveApprovalAsync(int approvalId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Silmeyi Onayla",
            "Bu onayı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil", cancelText: "İptal");
        if (confirmed != true) return;

        try
        {
            var approval = await Database.LeaveApprovals
                .VisibleTo(CurrentUser)
                .FirstOrDefaultAsync(a => a.ApprovalId == approvalId);
            if (approval is null) { SetFeedback(Severity.Error, "Onay kaydı bulunamadı."); return; }

            Database.LeaveApprovals.Remove(approval);
            await AuditLogService.AppendAsync(AuditActionType.LeaveApprovalDeleted, nameof(LeaveApproval), approvalId.ToString(), ActorId(), null);
            await Database.SaveChangesAsync();
            SetFeedback(Severity.Success, "Onay kaydı silindi.");
            await LoadDataAsync();
            await ReloadLeaveApprovalTablesAsync();
        }
        catch (DbUpdateException)
        {
            SetFeedback(Severity.Error, "Onay kaydı silinemedi. Beklenmeyen bir veritabanı hatası oluştu.");
        }
    }

    private async Task LoadDataAsync()
    {
        await using var readDatabase = await DatabaseFactory.CreateDbContextAsync();
        var filterOptionQuery = readDatabase.LeaveApprovals.AsNoTracking();

        RequesterFilterOptions = await filterOptionQuery.VisibleRequesterNames(CurrentUser).ToListAsync();
        ApproverFilterOptions = await filterOptionQuery.VisibleApproverNames(CurrentUser).ToListAsync();
        LeaveTypeFilterOptions = await filterOptionQuery.VisibleLeaveTypeNames(CurrentUser).ToListAsync();
        PendingApprovalCount = await readDatabase.LeaveApprovals
            .AsNoTracking()
            .VisibleTo(CurrentUser)
            .CountAsync(approval => approval.Decision == LeaveApprovalDecision.Pending);
        TransferContext = CurrentEmployeeId.HasValue
            ? await ManagerDelegationService.GetTransferContextAsync(CurrentEmployeeId.Value)
            : null;
    }

    private void OpenTransferDialog()
    {
        TransferDelegateEmployeeId = null;
        FeedbackMessage = null;
        IsTransferDialogOpen = true;
    }

