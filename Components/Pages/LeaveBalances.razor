@attribute [Authorize]
@page "/LeaveBalances"
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService

<div class="management-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Yönetim</MudText>
            <h1>İzin Bakiyeleri</h1>
            <p>İzin hakkını bir çalışana, departmandaki aktif çalışanlara veya tüm aktif çalışanlara güvenle atayın.</p>
        </div>
    </section>

    @if (FeedbackMessage is not null && !IsLeaveBalanceDialogOpen)
    {
        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }

    <MudDialog @bind-Visible="IsLeaveBalanceDialogOpen" Options="LeaveBalanceDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@(IsEditing ? "İzin Bakiyesini Düzenle" : "İzin Hakkı Ata")</MudText>
        </TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
            }

            <EditForm Model="@Form"
                      OnValidSubmit="OnValidSubmit"
                      OnInvalidSubmit="OnInvalidSubmit"
                      FormName="LeaveBalancesForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!IsEditing)
                {
                    <MudSelect T="LeaveBalanceTargetScope"
                               @bind-Value="Form.TargetScope"
                               Label="Atama Kapsamı"
                               Required="true">
                        <MudSelectItem Value="LeaveBalanceTargetScope.Employee">Bir çalışan</MudSelectItem>
                        <MudSelectItem Value="LeaveBalanceTargetScope.Department">Bir departman</MudSelectItem>
                        <MudSelectItem Value="LeaveBalanceTargetScope.AllEmployees">Tüm aktif çalışanlar</MudSelectItem>
                    </MudSelect>
                }

                @if (IsEditing || Form.TargetScope == LeaveBalanceTargetScope.Employee)
                {
                    <MudAutocomplete T="Employee"
                                     Label="Çalışan"
                                     Value="@SelectedEmployee"
                                     ValueChanged="OnEmployeeSelected"
                                     SearchFunc="SearchEmployeesAsync"
                                     ToStringFunc="@(employee => employee is null ? string.Empty : FormatEmployeeName(employee))"
                                     ResetValueOnEmptyText="true"
                                     Clearable="@(!IsEditing)"
                                     Disabled="@IsEditing"
                                     Required="true"
                                     RequiredError="Çalışan seçimi zorunludur." />
                }
                else if (Form.TargetScope == LeaveBalanceTargetScope.Department)
                {
                    <MudAutocomplete T="Department"
                                     Label="Departman"
                                     Value="@SelectedDepartment"
                                     ValueChanged="OnDepartmentSelected"
                                     SearchFunc="SearchDepartmentsAsync"
                                     ToStringFunc="@(department => department?.DepartmentName ?? string.Empty)"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     Required="true"
                                     RequiredError="Departman seçimi zorunludur." />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Bu işlem, izin türüne uygun tüm aktif çalışanları kapsar.
                    </MudAlert>
                }

                <MudSelect T="int?"
                           @bind-Value="Form.LeaveTypeId"
                           Label="İzin Türü"
                           Disabled="@IsEditing"
                           Required="true"
                           RequiredError="İzin türü seçimi zorunludur.">
                    @foreach (var type in ExistingLeaveTypes)
                    {
                        <MudSelectItem T="int?" Value="@((int?)type.LeaveTypeId)">@type.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudNumericField T="int"
                                 @bind-Value="Form.Year"
                                 Label="Yıl"
                                 Min="2000"
                                 Disabled="@IsEditing" />

                @if (IsEditing)
                {
                    <MudNumericField T="decimal"
                                     @bind-Value="Form.EntitledDays"
                                     Label="Hak Edilen Gün"
                                     Min="0" />
                    <MudNumericField T="decimal"
                                     @bind-Value="Form.CarryOverDays"
                                     Label="Devreden Gün"
                                     Min="0" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2">
                        Gün sayısı, seçilen izin türünün kuralı ve çalışanın uygunluğu üzerinden hesaplanır.
                    </MudText>
                }

                @if (ShowOverLimitConfirmation)
                {
                    <MudCheckBox T="bool"
                                 @bind-Value="Form.ConfirmedOverLimit"
                                 Label="50 günlük azami birikim uyarısını gördüm ve işlemi onaylıyorum." />
                }

                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseLeaveBalanceDialog">
                        İptal
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        @(IsEditing ? "Güncelle" : "İzin Hakkını Ata")
                    </MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsSearchDialogOpen" Options="LeaveBalanceDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">İzin Bakiyesi Ara</MudText>
        </TitleContent>
        <DialogContent>
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.EmployeeName"
                             Label="Çalışan"
                             SearchFunc="SearchEmployeeNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.DepartmentName"
                             Label="Departman"
                             SearchFunc="SearchDepartmentNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.LeaveTypeName"
                             Label="İzin Türü"
                             SearchFunc="SearchLeaveTypeNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudTextField T="int?" @bind-Value="SearchDraft.Year" Label="Yıl" />
            <div class="management-search-actions">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">
                    Filtreleri Temizle
                </MudButton>
                <div class="management-search-actions-primary">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">Ara</MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>

    @if (IsPageReady)
    {
        <MudTable @ref="LeaveBalanceTable"
                  ServerData="LoadLeaveBalancesAsync"
                  RowsPerPage="25"
                  Dense="true"
                  Hover="true"
                  Class="management-data-table">
            <ToolBarContent>
                <ManagementActiveFilters Filters="ActiveFilters"
                                         OnRemove="RemoveFilterAsync"
                                         OnClearAll="ClearFiltersAsync" />
                <MudSpacer />
                <MudTooltip Text="İzin bakiyesi ara">
                    <MudIconButton Class="mr-5"
                                   OnClick="OpenSearchDialog"
                                   Icon="@Icons.Material.Filled.Search"
                                   Color="Color.Primary"
                                   aria-label="İzin bakiyesi ara" />
                </MudTooltip>
                <MudTooltip Text="İzin hakkı ata">
                    <MudFab OnClick="OpenLeaveBalanceDialog"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            Size="Size.Small"
                            aria-label="İzin hakkı ata" />
                </MudTooltip>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Çalışan</MudTh>
                <MudTh>Departman</MudTh>
                <MudTh>İzin Türü</MudTh>
                <MudTh>Yıl</MudTh>
                <MudTh>Hak Edilen</MudTh>
                <MudTh>Devreden</MudTh>
                <MudTh>Kullanılan</MudTh>
                <MudTh>Kalan</MudTh>
                <MudTh>İşlemler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Çalışan">@FormatEmployeeName(context.Employee)</MudTd>
                <MudTd DataLabel="Departman">@context.Employee.Department.DepartmentName</MudTd>
                <MudTd DataLabel="İzin Türü">@context.LeaveType.Name</MudTd>
                <MudTd DataLabel="Yıl">@context.Year</MudTd>
                <MudTd DataLabel="Hak Edilen">@context.EntitledDays.ToString("0.##")</MudTd>
                <MudTd DataLabel="Devreden">@context.CarryOverDays.ToString("0.##")</MudTd>
                <MudTd DataLabel="Kullanılan">@context.UsedDays.ToString("0.##")</MudTd>
                <MudTd DataLabel="Kalan">
                    <MudText Color="@(context.RemainingDays < 0 ? Color.Error : Color.Default)">
                        @context.RemainingDays.ToString("0.##")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="İşlemler">
                    <div class="d-flex gap-2">
                        <MudTooltip Text="Düzenle">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           Icon="@Icons.Material.Filled.Edit"
                                           aria-label="@($"{FormatEmployeeName(context.Employee)} izin bakiyesini düzenle")"
                                           OnClick="@(() => EditLeaveBalanceAsync(context.BalanceId))" />
                        </MudTooltip>
                        <MudTooltip Text="Sil">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Icon="@Icons.Material.Filled.Delete"
                                           aria-label="@($"{FormatEmployeeName(context.Employee)} izin bakiyesini sil")"
                                           OnClick="@(() => DeleteLeaveBalanceAsync(context.BalanceId))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Arama ölçütlerine uygun izin bakiyesi bulunmuyor.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                               RowsPerPageString="Sayfa başına kayıt:"
                               InfoFormat="{first_item}-{last_item} / {all_items}" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private bool IsEditing { get; set; }
    private bool IsLeaveBalanceDialogOpen { get; set; }
    private bool IsSearchDialogOpen { get; set; }
    private bool IsPageReady { get; set; }
    private bool ShowOverLimitConfirmation { get; set; }
    private static readonly DialogOptions LeaveBalanceDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };
    private static readonly int[] ManagementPageSizeOptions = [10, 25, 50, 100];

    private LeaveBalanceEntryForm Form { get; set; } = LeaveBalanceEntryForm.CreateDefault();
    private LeaveBalanceSearchForm SearchForm { get; set; } = new();
    private LeaveBalanceSearchForm SearchDraft { get; set; } = new();
    private List<Employee> ExistingEmployees { get; set; } = [];
    private List<Department> ExistingDepartments { get; set; } = [];
    private List<LeaveType> ExistingLeaveTypes { get; set; } = [];
    private MudTable<LeaveBalance>? LeaveBalanceTable { get; set; }
    private Employee? SelectedEmployee { get; set; }
    private Department? SelectedDepartment { get; set; }
    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }

    [Inject] public HumanResourcesDbContext Database { get; set; } = null!;
    [Inject] public LeaveBalanceService LeaveBalanceService { get; set; } = null!;
    [Inject] public IDialogService DialogService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;
        if (!await PageAccessService.CanAccessLeaveBalanceAsync(CurrentUser))
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }

        await LoadDataAsync();
        IsPageReady = true;
    }

    private Task<IEnumerable<Employee>> SearchEmployeesAsync(string value, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        var employees = string.IsNullOrWhiteSpace(value)
            ? ExistingEmployees.Take(10)
            : ExistingEmployees
                .Where(employee =>
                    FormatEmployeeName(employee).Contains(value, StringComparison.OrdinalIgnoreCase)
                    || employee.SicilNo.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(20);
        return Task.FromResult(employees);
    }

    private Task<IEnumerable<Department>> SearchDepartmentsAsync(string value, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        var departments = string.IsNullOrWhiteSpace(value)
            ? ExistingDepartments.Take(10)
            : ExistingDepartments
                .Where(department =>
                    department.DepartmentName.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(20);
        return Task.FromResult(departments);
    }

    private Task<IEnumerable<string>> SearchEmployeeNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(
            ExistingEmployees.Select(FormatEmployeeName),
            value,
            token);

    private Task<IEnumerable<string>> SearchDepartmentNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(
            ExistingDepartments.Select(department => department.DepartmentName),
            value,
            token);

    private Task<IEnumerable<string>> SearchLeaveTypeNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(
            ExistingLeaveTypes.Select(leaveType => leaveType.Name),
            value,
            token);

    private void OnEmployeeSelected(Employee? employee)
    {
        SelectedEmployee = employee;
        Form.EmployeeId = employee?.EmployeeId;
    }

    private void OnDepartmentSelected(Department? department)
    {
        SelectedDepartment = department;
        Form.DepartmentId = department?.DepartmentId;
    }

    private async Task OnValidSubmit(EditContext context)
    {
        try
        {
            if (!Form.LeaveTypeId.HasValue)
            {
                SetFeedback(Severity.Error, "İzin türü seçimi zorunludur.");
                return;
            }

            if (IsEditing && Form.BalanceId.HasValue)
            {
                var result = await LeaveBalanceService.UpdateAsync(
                    CurrentUser,
                    Form.BalanceId.Value,
                    Form.EmployeeId ?? 0,
                    Form.LeaveTypeId.Value,
                    Form.Year,
                    Form.EntitledDays,
                    Form.CarryOverDays,
                    Form.RowVersion,
                    ActorId(),
                    Form.ConfirmedOverLimit);

                if (result.RequiresConfirmation)
                {
                    ShowOverLimitConfirmation = true;
                    SetFeedback(Severity.Warning, result.Message);
                    return;
                }

                CloseLeaveBalanceDialog(clearFeedback: false);
                SetFeedback(
                    Severity.Success,
                    $"İzin bakiyesi güncellendi. Kalan gün: {result.Balance!.RemainingDays:0.##}.");
            }
            else
            {
                var result = await LeaveBalanceService.AssignManualAsync(
                    CurrentUser,
                    new LeaveBalanceAssignmentRequest(
                        Form.TargetScope,
                        Form.EmployeeId,
                        Form.DepartmentId,
                        Form.LeaveTypeId.Value,
                        Form.Year),
                    ActorId(),
                    Form.ConfirmedOverLimit);

                if (result.RequiresConfirmation)
                {
                    ShowOverLimitConfirmation = true;
                    SetFeedback(Severity.Warning, result.Message);
                    return;
                }

                CloseLeaveBalanceDialog(clearFeedback: false);
                SetFeedback(Severity.Success, result.Message);
            }

            await LoadDataAsync();
            await ReloadLeaveBalanceTableAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/unauthorized", replace: true);
        }
        catch (InvalidOperationException ex)
        {
            SetFeedback(Severity.Error, ex.Message);
        }
        catch (DbUpdateConcurrencyException)
        {
            SetFeedback(
                Severity.Error,
                "Kayıt başka bir kullanıcı tarafından değiştirildi. Listeyi yenileyip tekrar deneyin.");
        }
        catch (DbUpdateException)
        {
            SetFeedback(
                Severity.Error,
                "İzin bakiyesi kaydedilirken beklenmeyen bir veritabanı hatası oluştu.");
        }
    }

    private void OnInvalidSubmit(EditContext context) =>
        SetFeedback(Severity.Error, "Lütfen doğrulama hatalarını düzeltip yeniden gönderin.");

    private void OpenLeaveBalanceDialog()
    {
        Form = LeaveBalanceEntryForm.CreateDefault();
        SelectedEmployee = null;
        SelectedDepartment = null;
        IsEditing = false;
        FeedbackMessage = null;
        ShowOverLimitConfirmation = false;
        IsLeaveBalanceDialogOpen = true;
    }

    private void CloseLeaveBalanceDialog() => CloseLeaveBalanceDialog(clearFeedback: true);

    private void CloseLeaveBalanceDialog(bool clearFeedback)
    {
        Form = LeaveBalanceEntryForm.CreateDefault();
        SelectedEmployee = null;
        SelectedDepartment = null;
        IsEditing = false;
        if (clearFeedback)
        {
            FeedbackMessage = null;
        }

        ShowOverLimitConfirmation = false;
        IsLeaveBalanceDialogOpen = false;
    }

    private async Task EditLeaveBalanceAsync(int balanceId)
    {
        var balance = await Database.LeaveBalances
            .AsNoTracking()
            .SingleOrDefaultAsync(item => item.BalanceId == balanceId);
        if (balance is null)
        {
            SetFeedback(Severity.Error, "İzin bakiyesi bulunamadı.");
            return;
        }

        Form = new LeaveBalanceEntryForm
        {
            BalanceId = balance.BalanceId,
            EmployeeId = balance.EmployeeId,
            LeaveTypeId = balance.LeaveTypeId,
            Year = balance.Year,
            EntitledDays = balance.EntitledDays,
            CarryOverDays = balance.CarryOverDays,
            RowVersion = balance.RowVersion.ToArray()
        };
        SelectedEmployee = ExistingEmployees
            .FirstOrDefault(employee => employee.EmployeeId == balance.EmployeeId);
        IsEditing = true;
        FeedbackMessage = null;
        ShowOverLimitConfirmation = false;
        IsLeaveBalanceDialogOpen = true;
    }

    private async Task DeleteLeaveBalanceAsync(int balanceId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Silmeyi Onayla",
            "Bu izin bakiyesini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil",
            cancelText: "İptal");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            var balance = await Database.LeaveBalances
                .AsNoTracking()
                .SingleOrDefaultAsync(item => item.BalanceId == balanceId);
            if (balance is null)
            {
                SetFeedback(Severity.Error, "İzin bakiyesi bulunamadı.");
                return;
            }

            await LeaveBalanceService.DeleteAsync(
                CurrentUser,
                balance.BalanceId,
                balance.RowVersion,
                ActorId());
            SetFeedback(Severity.Success, "İzin bakiyesi silindi.");
            await ReloadLeaveBalanceTableAsync();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/unauthorized", replace: true);
        }
        catch (DbUpdateConcurrencyException)
        {
            SetFeedback(
                Severity.Error,
                "Kayıt başka bir kullanıcı tarafından değiştirildi. Listeyi yenileyip tekrar deneyin.");
        }
        catch (InvalidOperationException ex)
        {
            SetFeedback(Severity.Error, ex.Message);
        }
        catch (DbUpdateException)
        {
            SetFeedback(
                Severity.Error,
                "İzin bakiyesi silinirken beklenmeyen bir veritabanı hatası oluştu.");
        }
    }

    private async Task LoadDataAsync()
    {
        ExistingEmployees = await Database.Employees
            .AsNoTracking()
            .Where(employee => employee.Status == EmploymentStatus.Active)
            .OrderBy(employee => employee.FirstName)
            .ThenBy(employee => employee.LastName)
            .ToListAsync();
        ExistingDepartments = await Database.Departments
            .AsNoTracking()
            .OrderBy(department => department.DepartmentName)
            .ToListAsync();
        ExistingLeaveTypes = await Database.LeaveTypes
            .AsNoTracking()
            .OrderBy(leaveType => leaveType.Name)
            .ToListAsync();
    }

    private void SetFeedback(Severity severity, string message)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = message;
    }

    private void OpenSearchDialog()
    {
        SearchDraft = SearchForm.Clone();
        IsSearchDialogOpen = true;
    }

    private void CloseSearchDialog()
    {
        SearchDraft = SearchForm.Clone();
        IsSearchDialogOpen = false;
    }

    private async Task PerformSearchAsync()
    {
        SearchForm = SearchDraft.Normalize();
        IsSearchDialogOpen = false;
        await ReloadLeaveBalanceTableAsync(resetPage: true);
    }

    private async Task ClearFiltersAsync()
    {
        SearchForm = new LeaveBalanceSearchForm();
        SearchDraft = new LeaveBalanceSearchForm();
        IsSearchDialogOpen = false;
        await ReloadLeaveBalanceTableAsync(resetPage: true);
    }

    private async Task RemoveFilterAsync(string key)
    {
        switch (key)
        {
            case nameof(LeaveBalanceSearchForm.EmployeeName):
                SearchForm.EmployeeName = null;
                break;
            case nameof(LeaveBalanceSearchForm.DepartmentName):
                SearchForm.DepartmentName = null;
                break;
            case nameof(LeaveBalanceSearchForm.LeaveTypeName):
                SearchForm.LeaveTypeName = null;
                break;
            case nameof(LeaveBalanceSearchForm.Year):
                SearchForm.Year = null;
                break;
            default:
                return;
        }

        SearchDraft = SearchForm.Clone();
        await ReloadLeaveBalanceTableAsync(resetPage: true);
    }

    private IReadOnlyList<ManagementFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ManagementFilter>();
            if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName))
            {
                filters.Add(new(
                    nameof(LeaveBalanceSearchForm.EmployeeName),
                    $"Çalışan: {SearchForm.EmployeeName.Trim()}"));
            }

            if (!string.IsNullOrWhiteSpace(SearchForm.DepartmentName))
            {
                filters.Add(new(
                    nameof(LeaveBalanceSearchForm.DepartmentName),
                    $"Departman: {SearchForm.DepartmentName.Trim()}"));
            }

            if (!string.IsNullOrWhiteSpace(SearchForm.LeaveTypeName))
            {
                filters.Add(new(
                    nameof(LeaveBalanceSearchForm.LeaveTypeName),
                    $"İzin türü: {SearchForm.LeaveTypeName.Trim()}"));
            }

            if (SearchForm.Year.HasValue)
            {
                filters.Add(new(nameof(LeaveBalanceSearchForm.Year), $"Yıl: {SearchForm.Year}"));
            }

            return filters;
        }
    }

    private async Task<TableData<LeaveBalance>> LoadLeaveBalancesAsync(
        TableState state,
        CancellationToken cancellationToken)
    {
        var query = ApplyLeaveBalanceSearch(
            Database.LeaveBalances
                .AsNoTracking()
                .Include(balance => balance.Employee)
                .ThenInclude(employee => employee.Department)
                .Include(balance => balance.LeaveType)
                .AsQueryable());

        return await query
            .OrderByDescending(balance => balance.Year)
            .ThenBy(balance => balance.Employee.FirstName)
            .ThenBy(balance => balance.Employee.LastName)
            .ThenBy(balance => balance.LeaveType.Name)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
    }

    private IQueryable<LeaveBalance> ApplyLeaveBalanceSearch(IQueryable<LeaveBalance> query)
    {
        if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName))
        {
            var employeeName = SearchForm.EmployeeName.Trim();
            query = query.Where(balance =>
                balance.Employee.FirstName.Contains(employeeName)
                || balance.Employee.LastName.Contains(employeeName)
                || (balance.Employee.FirstName + " " + balance.Employee.LastName)
                    .Contains(employeeName));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.DepartmentName))
        {
            var departmentName = SearchForm.DepartmentName.Trim();
            query = query.Where(balance =>
                balance.Employee.Department.DepartmentName.Contains(departmentName));
        }

        if (!string.IsNullOrWhiteSpace(SearchForm.LeaveTypeName))
        {
            var leaveTypeName = SearchForm.LeaveTypeName.Trim();
            query = query.Where(balance => balance.LeaveType.Name.Contains(leaveTypeName));
        }

        if (SearchForm.Year.HasValue)
        {
            query = query.Where(balance => balance.Year == SearchForm.Year.Value);
        }

        return query;
    }

    private Task ReloadLeaveBalanceTableAsync(bool resetPage = false)
    {
        if (LeaveBalanceTable is null)
        {
            return Task.CompletedTask;
        }

        if (resetPage && LeaveBalanceTable.CurrentPage != 0)
        {
            LeaveBalanceTable.NavigateTo(0);
            return Task.CompletedTask;
        }

        return LeaveBalanceTable.ReloadServerData();
    }

    private static string FormatEmployeeName(Employee employee) =>
        $"{employee.FirstName} {employee.LastName}";

    private string ActorId() => CurrentUser?.Identity?.Name ?? "System";

    private sealed class LeaveBalanceEntryForm
    {
        public int? BalanceId { get; set; }
        public LeaveBalanceTargetScope TargetScope { get; set; } = LeaveBalanceTargetScope.Employee;
        public int? EmployeeId { get; set; }
        public int? DepartmentId { get; set; }
        public int? LeaveTypeId { get; set; }

        [Range(2000, int.MaxValue, ErrorMessage = "Yıl 2000 veya sonrası olmalıdır.")]
        public int Year { get; set; }

        [Range(0d, double.MaxValue, ErrorMessage = "Hak edilen gün negatif olamaz.")]
        public decimal EntitledDays { get; set; }

        [Range(0d, double.MaxValue, ErrorMessage = "Devreden gün negatif olamaz.")]
        public decimal CarryOverDays { get; set; }

        public bool ConfirmedOverLimit { get; set; }
        public byte[] RowVersion { get; set; } = [];

        public static LeaveBalanceEntryForm CreateDefault() =>
            new() { Year = DateTime.Today.Year };
    }

    private sealed class LeaveBalanceSearchForm
    {
        public string? EmployeeName { get; set; }
        public string? DepartmentName { get; set; }
        public string? LeaveTypeName { get; set; }
        public int? Year { get; set; }

        public LeaveBalanceSearchForm Clone() =>
            new()
            {
                EmployeeName = EmployeeName,
                DepartmentName = DepartmentName,
                LeaveTypeName = LeaveTypeName,
                Year = Year
            };

        public LeaveBalanceSearchForm Normalize()
        {
            var normalized = Clone();
            normalized.EmployeeName = ManagementFilterValue.Normalize(normalized.EmployeeName);
            normalized.DepartmentName = ManagementFilterValue.Normalize(normalized.DepartmentName);
            normalized.LeaveTypeName = ManagementFilterValue.Normalize(normalized.LeaveTypeName);
            return normalized;
        }
    }
