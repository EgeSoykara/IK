@attribute [Authorize]
@page "/LeaveRequests"
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService

<div class="management-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Yönetim</MudText>
            <h1>İzin Talepleri</h1>
            <p>İzin taleplerini oluşturun, arayın ve yetkinize göre düzenleyin.</p>
        </div>
    </section>

    @if (FeedbackMessage is not null && !IsLeaveRequestDialogOpen)
    {
        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }
    
    <MudDialog @bind-Visible="IsLeaveRequestDialogOpen" Options="LeaveRequestDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@(IsEditing ? "İzin Talebini Düzenle" : "İzin Talebi Oluştur")</MudText>
        </TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
            }
            <EditForm Model="@Form" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit" FormName="LeaveRequestsForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                <MudAutocomplete T="Employee"
                                 Label="Çalışan Ara..."
                                 Value="@SelectedEmployee"
                                 ValueChanged="OnEmployeeSelected"
                                 SearchFunc="SearchEmployeesAsync"
                                 ToStringFunc="@(e => e == null ? string.Empty : $"{e.FirstName} {e.LastName}")"
                                 ResetValueOnEmptyText="true"
                                 Clearable="true"
                                 Validation="@(new Func<Employee, string?>(e => e == null ? "Çalışan seçimi zorunludur." : null))" />

                @if (CanSelectDelegate)
                {
                    <MudSelect T="int?"
                               @bind-Value="Form.DelegateEmployeeId"
                               Label="İzin Süresince Vekil"
                               Required="true"
                               RequiredError="Yönetici izin talebinde vekil seçimi zorunludur."
                               HelperText="Vekâlet yalnız İK onayından sonra izin başlangıç tarihinde etkinleşir.">
                        @foreach (var employee in DelegateCandidates)
                        {
                            <MudSelectItem T="int?" Value="@((int?)employee.EmployeeId)">
                                @($"{employee.FirstName} {employee.LastName} ({employee.SicilNo})")
                            </MudSelectItem>
                        }
                    </MudSelect>
                }
                
                <MudSelect T="LeaveRequestCategory"
                           Value="@Form.Category"
                           ValueChanged="OnCategoryChangedAsync"
                           Label="İzin Kategorisi">
                    @foreach (var category in Enum.GetValues<LeaveRequestCategory>())
                    {
                        <MudSelectItem T="LeaveRequestCategory" Value="@category">
                            @category.DisplayName()
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudGrid Class="mt-2 mb-2">
                    <MudItem xs="12">
                        @if (Form.IsHalfDay)
                        {
                            <MudDatePicker Date="@Form.StartDate"
                                           DateChanged="OnHalfDayDateChanged"
                                           Label="Yarım Gün Tarihi"
                                           MinDate="@Today"
                                           AutoClose="true" />
                        }
                        else
                        {
                            <MudDateRangePicker @bind-DateRange="Form.SelectedDateRange"
                                                @bind-DateRange:after="UpdateRequestedDayPreviewAsync"
                                                Label="İzin Tarih Aralığı"
                                                PlaceholderStart="Başlangıç"
                                                PlaceholderEnd="Bitiş"
                                                MinDate="@Today"
                                                AutoClose="true" />
                        }
                    </MudItem>
                </MudGrid>

                <MudSwitch T="bool"
                           Value="@Form.IsHalfDay"
                           ValueChanged="OnHalfDayChanged"
                           Color="Color.Primary"
                           Label="Yarım gün izin" />

                @if (RequestedDayPreviewState.Days is { } requestedDays)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2 mb-2">
                        Seçilen tarih aralığı @FormatDayCount(requestedDays) iş günüdür. Hafta sonları ve tanımlı resmî tatiller hesaba katılmaz.
                        @if (SelectedCategoryRemainingDays is { } totalRemainingDays)
                        {
                            @if (requestedDays > totalRemainingDays)
                            {
                                <text> Bu talep onaylanırsa seçili çalışanın @Form.Category.DisplayName() bakiyesi @FormatDayCount(LeaveBalanceDashboardSummary.ProjectRemainingDays(totalRemainingDays, requestedDays)) gün olacak. (Uyarı: Talep edilen gün sayısı mevcut kategori bakiyesinden fazla.)</text>
                            }
                            else
                            {
                                <text> Bu talep onaylanırsa seçili çalışanın @Form.Category.DisplayName() bakiyesi @FormatDayCount(LeaveBalanceDashboardSummary.ProjectRemainingDays(totalRemainingDays, requestedDays)) gün olacak.</text>
                            }
                        }
                    </MudAlert>
                }
                else if (RequestedDayPreviewState.Error is { } previewError)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 mb-2">@previewError</MudAlert>
                }

                <MudTextField T="string" @bind-Value="Form.Reason" Label="İzin Talep Nedeni" Lines="3" />
                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseLeaveRequestDialog">
                        İptal
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        @(IsEditing ? "Güncelle" : "Talebi Gönder")
                    </MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsSearchDialogOpen" Options="LeaveRequestDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">İzin Talebi Ara</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField T="int?" @bind-Value="SearchDraft.RequestId" Label="Talep ID" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.EmployeeName"
                             Label="Çalışan"
                             SearchFunc="SearchEmployeeNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudSelect T="LeaveRequestCategory?" @bind-Value="SearchDraft.Category" Label="İzin Kategorisi" Clearable="true">
                <MudSelectItem T="LeaveRequestCategory?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var category in Enum.GetValues<LeaveRequestCategory>())
                {
                    <MudSelectItem T="LeaveRequestCategory?" Value="@((LeaveRequestCategory?)category)">@category.DisplayName()</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="LeaveRequestStatus?" @bind-Value="SearchDraft.Status" Label="Durum" Clearable="true">
                <MudSelectItem T="LeaveRequestStatus?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var s in Enum.GetValues<LeaveRequestStatus>())
                {
                    <MudSelectItem T="LeaveRequestStatus?" Value="@(s)">@FormatRequestStatus(s)</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="SearchDraft.StartDate" Label="Başlangıç Tarihi" />
            <MudDatePicker @bind-Date="SearchDraft.EndDate" Label="Bitiş Tarihi" />
            <div class="management-search-actions">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">Filtreleri Temizle</MudButton>
                <div class="management-search-actions-primary">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">Ara</MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsReasonDialogOpen">
        <TitleContent>
            <MudText Typo="Typo.h6">İzin Talep Nedeni</MudText>
        </TitleContent>
        <DialogContent>
            <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere;">@SelectedReason</MudText>
            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseReasonDialog">Kapat</MudButton>
            </div>
        </DialogContent>
    </MudDialog>

    @if (IsPageReady)
    {
    <MudTable @ref="LeaveRequestTable"
              ServerData="LoadLeaveRequestsAsync"
              RowsPerPage="25"
              Dense="true"
              Hover="true"
              Class="management-data-table">
        <ToolBarContent>
            <ManagementActiveFilters Filters="ActiveFilters"
                                     OnRemove="RemoveFilterAsync"
                                     OnClearAll="ClearFiltersAsync" />
            <MudSpacer />
            <MudTooltip Text="İzin talebi ara">
                <MudIconButton class="mr-5" OnClick="OpenSearchDialog" Icon="@Icons.Material.Filled.Search" Color="Color.Primary" aria-label="İzin talebi ara" />
            </MudTooltip>
            @if (CanManageLeaveRequests)
            {
                <MudTooltip Text="İzin talebi oluştur">
                    <MudFab OnClick="OpenLeaveRequestDialog" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="İzin talebi oluştur" />
                </MudTooltip>
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Talep ID</MudTh>
            <MudTh>Çalışan</MudTh>
            <MudTh>İzin Kategorisi</MudTh>
            <MudTh>Başlangıç Tarihi</MudTh>
            <MudTh>Bitiş Tarihi</MudTh>
            <MudTh>Talep Edilen Gün</MudTh>
            <MudTh>Neden</MudTh>
            <MudTh>Durum</MudTh>
            @if (CanEditDeleteLeaveRequests)
            {
            <MudTh>İşlemler</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Talep ID">@context.RequestId</MudTd>
            <MudTd DataLabel="Çalışan">@FormatEmployeeName(context.Employee)</MudTd>
            <MudTd DataLabel="İzin Kategorisi">@context.Category.DisplayName()</MudTd>
            <MudTd DataLabel="Başlangıç Tarihi">@FormatDate(context.StartDate)</MudTd>
            <MudTd DataLabel="Bitiş Tarihi">@FormatDate(context.EndDate)</MudTd>
            <MudTd DataLabel="Talep Edilen Gün">@context.RequestedDays</MudTd>
            <MudTd DataLabel="Neden">
                @if (string.IsNullOrWhiteSpace(context.Reason))
                {
                    @:-
                }
                else if (!RequiresExpandedTextDisplay(context.Reason))
                {
                    @context.Reason
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               aria-label="@($"Talep {context.RequestId} neden detayını görüntüle")"
                               OnClick="@(() => OpenReasonDialog(context.Reason))">
                        @BuildPreviewLabel(context.Reason)
                    </MudButton>
                }
            </MudTd>
            <MudTd DataLabel="Durum">@FormatRequestStatus(context.CurrentStatus)</MudTd>
                @if (CanEditDeleteLeaveRequests)
                {
                    <MudTd DataLabel="İşlemler">
                    <div class="d-flex gap-2">
                        @if (context.CurrentStatus == LeaveRequestStatus.ManagerReview)
                        {
                            <MudTooltip Text="Düzenle">
                                <MudIconButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               Icon="@Icons.Material.Filled.Edit"
                                               aria-label="@($"Talep {context.RequestId} kaydını düzenle")"
                                               OnClick="@(() => EditLeaveRequestAsync(context.RequestId))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Sil">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Icon="@Icons.Material.Filled.Delete"
                                           aria-label="@($"Talep {context.RequestId} kaydını sil")"
                                           OnClick="@(() => DeleteLeaveRequestAsync(context.RequestId))" />
                        </MudTooltip>
                    </div>
                    </MudTd>
                }
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Henüz kayıtlı izin talebi bulunmuyor.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                           RowsPerPageString="Sayfa başına kayıt:"
                           InfoFormat="{first_item}-{last_item} / {all_items}" />
        </PagerContent>
    </MudTable>
    }
</div>


@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private bool IsEditing { get; set; }
    private bool IsLeaveRequestDialogOpen { get; set; }
    private bool IsSearchDialogOpen { get; set; }
    private bool IsReasonDialogOpen { get; set; }
    private bool IsPageReady { get; set; }
    private static readonly DialogOptions LeaveRequestDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Medium, FullWidth = true
    };
    
    private LeaveRequestEntryForm Form { get; set; } = new();
    private LeaveRequestSearchForm SearchForm { get; set; } = new();
    private LeaveRequestSearchForm SearchDraft { get; set; } = new();
    private List<Employee> ExistingEmployees { get; set; } = [];
    private MudTable<LeaveRequest>? LeaveRequestTable { get; set; }
    private static readonly int[] ManagementPageSizeOptions = [10, 25, 50, 100];

    private Employee? SelectedEmployee { get; set; }
    private List<Employee> DelegateCandidates { get; set; } = [];
    private bool CanSelectDelegate { get; set; }
    private decimal? SelectedCategoryRemainingDays { get; set; }

    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private string SelectedReason { get; set; } = string.Empty;
    private RequestedDayPreview RequestedDayPreviewState { get; set; } = new(null, null);
    private bool CanManageLeaveRequests => PageAccessService.CanManageLeaveRequests(CurrentUser);
    private bool CanEditDeleteLeaveRequests => PageAccessService.CanEditDeleteLeaveRequests(CurrentUser);
    private int? CurrentEmployeeId => CurrentUser.GetEmployeeId();
    private DateTime Today => DateTime.Today;
    private bool CanViewAllLeaveRequests =>
        PageAccessService.CanViewLeaveRequests(CurrentUser)
        || CanEditDeleteLeaveRequests;

    [Inject]
    public HumanResourcesDbContext Database { get; set; } = null!;

    [Inject]
    public LeaveRequestService LeaveRequestService { get; set; } = null!;

    [Inject]
    public IDialogService DialogService { get; set; } = null!;

    [Inject]
    public AuditLogService AuditLogService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;

        if (!await PageAccessService.CanAccessLeaveRequestsAsync(CurrentUser))
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }
        Form = new LeaveRequestEntryForm();
        await LoadDataAsync();
        IsPageReady = true;
    }

    private Task<IEnumerable<Employee>> SearchEmployeesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(ExistingEmployees.Take(10));

        var filtered = ExistingEmployees.Where(e => 
            e.FirstName.Contains(value, StringComparison.OrdinalIgnoreCase) || 
            e.LastName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            $"{e.FirstName} {e.LastName}".Contains(value, StringComparison.OrdinalIgnoreCase)
        ).Take(20);

        return Task.FromResult(filtered);
    }

    private Task<IEnumerable<string>> SearchEmployeeNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(FormatEmployeeName), value, token);

    private async Task OnEmployeeSelected(Employee? employee)
    {
        SelectedEmployee = employee;
        Form.EmployeeId = employee?.EmployeeId ?? 0;
        await LoadDelegateCandidatesAsync();
        await UpdateRequestedDayPreviewAsync();
    }

    private async Task OnCategoryChangedAsync(LeaveRequestCategory category)
    {
        Form.Category = category;
        await UpdateRequestedDayPreviewAsync();
    }

    private async Task LoadDelegateCandidatesAsync()
    {
        DelegateCandidates = [];
        CanSelectDelegate = false;
        Form.DelegateRequired = false;

        if (SelectedEmployee is null)
        {
            if (!IsEditing)
            {
                Form.DelegateEmployeeId = null;
            }
            return;
        }

        var managedDepartment = await Database.Departments
            .AsNoTracking()
            .SingleOrDefaultAsync(department =>
                department.ManagerEmployeeId == SelectedEmployee.EmployeeId
                || department.ActiveDelegateEmployeeId == SelectedEmployee.EmployeeId);
        if (managedDepartment is null)
        {
            Form.DelegateEmployeeId = null;
            return;
        }

        var unavailableEmployeeIds = (await Database.ManagerDelegations
                .AsNoTracking()
                .Where(item => item.DepartmentId == managedDepartment.DepartmentId
                               && item.RestoredAt == null)
                .ToListAsync())
            .SelectMany(item => new[] { item.ManagerEmployeeId, item.DelegateEmployeeId })
            .Append(managedDepartment.ManagerEmployeeId ?? 0)
            .ToHashSet();
        DelegateCandidates = await Database.Employees
            .AsNoTracking()
            .Where(employee =>
                employee.DepartmentId == SelectedEmployee.DepartmentId
                && employee.EmployeeId != SelectedEmployee.EmployeeId
                && !unavailableEmployeeIds.Contains(employee.EmployeeId)
                && employee.Status == EmploymentStatus.Active)
            .OrderBy(employee => employee.FirstName)
            .ThenBy(employee => employee.LastName)
            .ToListAsync();
        CanSelectDelegate = true;
        Form.DelegateRequired = true;
    }

    private async Task OnHalfDayChanged(bool isHalfDay)
    {
        Form.IsHalfDay = isHalfDay;

        if (isHalfDay && Form.StartDate is { } startDate)
        {
            Form.SelectedDateRange = new DateRange(startDate, startDate);
        }

        await UpdateRequestedDayPreviewAsync();
    }

    private async Task OnHalfDayDateChanged(DateTime? selectedDate)
    {
        var date = selectedDate?.Date;
        Form.SelectedDateRange = new DateRange(date, date);
        await UpdateRequestedDayPreviewAsync();
    }

    private async Task OnValidSubmit(EditContext context)
    {
        if (!IsEditing && !CanManageLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin talebi oluşturma yetkiniz yok.");
            return;
        }

        if (IsEditing && !CanEditDeleteLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini düzenleme yetkiniz yok.");
            return;
        }

        try
        {
            if (!CanViewAllLeaveRequests
                && CurrentEmployeeId is not null
                && Form.EmployeeId != CurrentEmployeeId.Value)
            {
                SetFeedback(Severity.Error, "Sadece kendi adınıza izin talebi oluşturabilirsiniz.");
                return;
            }

            var finalStart = Form.BuildStartDate();
            var finalEnd = Form.BuildEndDate();
            var requestedDays = await LeaveRequestService.CalculateRequestedDaysAsync(
                DateOnly.FromDateTime(finalStart),
                DateOnly.FromDateTime(finalEnd),
                Form.IsHalfDay);

            var confirmed = await DialogService.ShowMessageBoxAsync(
                IsEditing ? "İzin Talebi Güncellemesini Onayla" : "İzin Talebini Göndermeyi Onayla",
                $"Talep nihai onaylandığında izin bakiyesinden {FormatDayCount(requestedDays)} iş günü düşülecektir. Emin misiniz?",
                yesText: IsEditing ? "Güncelle" : "Gönder",
                cancelText: "İptal");
            if (confirmed != true)
            {
                return;
            }

            if (IsEditing && Form.RequestId is not null)
            {
                var request = await LeaveRequestService.UpdateRequestAsync(
                    Form.RequestId.Value,
                    Form.EmployeeId,
                    Form.Category,
                    finalStart,
                    finalEnd,
                    Form.Reason,
                    ActorId(),
                    Form.IsHalfDay,
                    delegateEmployeeId: Form.DelegateEmployeeId,
                    actorEmployeeId: CurrentEmployeeId);

                SetFeedback(Severity.Success, $"İzin talebi {request.RequestId} güncellendi.");
                Form = new LeaveRequestEntryForm();
                SelectedEmployee = null;
                IsEditing = false;
                IsLeaveRequestDialogOpen = false;
                await LoadDataAsync();
                await ReloadLeaveRequestTableAsync();
            }
            else
            {
                var request = await LeaveRequestService.CreateRequestAsync(
                    Form.EmployeeId,
                    Form.Category,
                    finalStart,
                    finalEnd,
                    Form.Reason,
                    ActorId(),
                    Form.IsHalfDay,
                    delegateEmployeeId: Form.DelegateEmployeeId,
                    actorEmployeeId: CurrentEmployeeId);

                SetFeedback(Severity.Success,
                    $"İzin talebi {request.RequestId} oluşturuldu ve yönetici onayına gönderildi.");
                Form = new LeaveRequestEntryForm();
                SelectedEmployee = null;
                IsLeaveRequestDialogOpen = false;
                await LoadDataAsync();
                await ReloadLeaveRequestTableAsync();
            }
        }
        catch (InvalidOperationException ex)
        {
            SetFeedback(Severity.Error, ex.Message);
        }
        catch (DbUpdateException)
        {
            Database.ChangeTracker.Clear();
            SetFeedback(Severity.Error, "İzin talebi kaydedilirken beklenmeyen bir veritabanı hatası oluştu.");
        }
    }

    private void OnInvalidSubmit(EditContext context)
    {
        SetFeedback(Severity.Error, "Lütfen doğrulama hatalarını düzeltip yeniden gönderin.");
    }

    private async Task OpenLeaveRequestDialog()
    {
        if (!CanManageLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini oluşturma yetkiniz yok.");
            return;
        }

        if (ExistingEmployees.Count == 0)
        {
            SetFeedback(Severity.Error, "Giriş yapan kullanıcıya bağlı çalışan kaydı bulunamadı.");
            return;
        }

        Form = new LeaveRequestEntryForm
        {
            EmployeeId = ExistingEmployees[0].EmployeeId,
            Category = LeaveRequestCategory.AnnualLeave,
            SelectedDateRange = new DateRange(Today, Today)
        };
        SelectedEmployee = ExistingEmployees[0];
        await LoadDelegateCandidatesAsync();

        IsEditing = false;
        FeedbackMessage = null;
        IsLeaveRequestDialogOpen = true;
        await UpdateRequestedDayPreviewAsync();
    }

    private void CloseLeaveRequestDialog()
    {
        Form = new LeaveRequestEntryForm();
        SelectedEmployee = null;
        DelegateCandidates = [];
        CanSelectDelegate = false;
        IsEditing = false;
        FeedbackMessage = null;
        IsLeaveRequestDialogOpen = false;
        RequestedDayPreviewState = new(null, null);
    }

    private async Task EditLeaveRequestAsync(int requestId)
    {
        if (!CanEditDeleteLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini düzenleme yetkiniz yok.");
            return;
        }

        var request = await Database.LeaveRequests.AsNoTracking()
            .FirstOrDefaultAsync(r => r.RequestId == requestId);
        if (request is null) { SetFeedback(Severity.Error, "İzin talebi bulunamadı."); return; }
        if (request.CurrentStatus != LeaveRequestStatus.ManagerReview)
        {
            SetFeedback(Severity.Error, "Yalnızca yönetici onayı bekleyen izin talepleri düzenlenebilir.");
            return;
        }

        Form = new LeaveRequestEntryForm
        {
            RequestId = request.RequestId,
            EmployeeId = request.EmployeeId,
            Category = request.Category,
            SelectedDateRange = new DateRange(request.StartDate?.Date, request.EndDate?.Date),
            IsHalfDay = request.RequestedDays == 0.5m,
            Reason = request.Reason,
            DelegateEmployeeId = request.DelegateEmployeeId
        };

        SelectedEmployee = ExistingEmployees.FirstOrDefault(e => e.EmployeeId == request.EmployeeId);
        await LoadDelegateCandidatesAsync();
        
        IsEditing = true;
        FeedbackMessage = null;
        IsLeaveRequestDialogOpen = true;
        await UpdateRequestedDayPreviewAsync();
    }

    private async Task DeleteLeaveRequestAsync(int requestId)
    {
        if (!CanEditDeleteLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini silme yetkiniz yok.");
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Silmeyi Onayla",
            "Bu izin talebini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil", cancelText: "İptal");
        if (confirmed != true) return;

        try
        {
            var request = await Database.LeaveRequests.FirstOrDefaultAsync(r => r.RequestId == requestId);
            if (request is null) { SetFeedback(Severity.Error, "İzin talebi bulunamadı."); return; }

            var hasApprovals = await Database.LeaveApprovals.AnyAsync(a => a.RequestId == requestId);
            if (hasApprovals) { SetFeedback(Severity.Error, $"İzin talebi {requestId} silinemiyor; onay kayıtları mevcut. Önce onları silin."); return; }

            Database.LeaveRequests.Remove(request);
            await AuditLogService.AppendAsync(AuditActionType.LeaveRequestDeleted, nameof(LeaveRequest), requestId.ToString(), ActorId(), null);
            await Database.SaveChangesAsync();
            SetFeedback(Severity.Success, $"İzin talebi {requestId} silindi.");
            await LoadDataAsync();
            await ReloadLeaveRequestTableAsync();
        }
        catch (DbUpdateException)
        {
            SetFeedback(Severity.Error, "Bu izin talebi silinemiyor; başka kayıtlar tarafından hâlâ kullanılıyor.");
        }
    }

    private async Task LoadDataAsync()
    {
        var employeeQuery = Database.Employees.AsNoTracking();

        ExistingEmployees = CanViewAllLeaveRequests
            ? await employeeQuery
                .OrderBy(e => e.FirstName)
                .ThenBy(e => e.LastName)
                .ToListAsync()
            : CurrentEmployeeId is null
                ? []
                : await employeeQuery
                    .Where(e => e.EmployeeId == CurrentEmployeeId.Value)
                    .ToListAsync();

        SelectedCategoryRemainingDays = null;
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToString("yyyy-MM-dd") ?? "-";
    }

    private async Task UpdateRequestedDayPreviewAsync()
    {
        if (Form.StartDate is null || Form.EndDate is null)
        {
            RequestedDayPreviewState = new(null, null);
            SelectedCategoryRemainingDays = null;
            return;
        }

        try
        {
            var days = await LeaveRequestService.CalculateRequestedDaysAsync(
                DateOnly.FromDateTime(Form.StartDate.Value.Date),
                DateOnly.FromDateTime(Form.EndDate.Value.Date),
                Form.IsHalfDay);
            SelectedCategoryRemainingDays = SelectedEmployee is null
                ? null
                : await LeaveRequestService.GetAvailableDaysAsync(
                    SelectedEmployee.EmployeeId,
                    Form.Category,
                    Form.StartDate.Value.Year);
            RequestedDayPreviewState = new(days, null);
        }
        catch (InvalidOperationException ex)
        {
            RequestedDayPreviewState = new(null, ex.Message);
            SelectedCategoryRemainingDays = null;
        }
    }

