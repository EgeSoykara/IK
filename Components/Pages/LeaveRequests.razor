    private IReadOnlyList<ManagementFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ManagementFilter>();
            if (SearchForm.RequestId.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.RequestId), $"Talep ID: {SearchForm.RequestId}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName)) filters.Add(new(nameof(LeaveRequestSearchForm.EmployeeName), $"Çalışan: {SearchForm.EmployeeName.Trim()}"));
            if (SearchForm.Category.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.Category), $"İzin kategorisi: {SearchForm.Category.Value.DisplayName()}"));
            if (SearchForm.Status.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.Status), $"Durum: {FormatRequestStatus(SearchForm.Status.Value)}"));
            if (SearchForm.StartDate.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.StartDate), $"Başlangıç: {SearchForm.StartDate:yyyy-MM-dd}"));
            if (SearchForm.EndDate.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.EndDate), $"Bitiş: {SearchForm.EndDate:yyyy-MM-dd}"));
            return filters;
        }
    }

    private async Task<TableData<LeaveRequest>> LoadLeaveRequestsAsync(TableState state, CancellationToken cancellationToken)
    {
        var query = BuildLeaveRequestDisplayQuery(
            ApplyLeaveRequestSearch(
                ApplyLeaveRequestVisibilityScope(Database.LeaveRequests.AsNoTracking())));

        return await query
            .OrderByDescending(r => r.CreatedAt)
            .ThenByDescending(r => r.RequestId)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
    }

    private IQueryable<LeaveRequest> ApplyLeaveRequestSearch(IQueryable<LeaveRequest> query)
    {
        if (SearchForm.RequestId.HasValue)
            query = query.Where(r => r.RequestId == SearchForm.RequestId.Value);

        if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName))
        {
            var employeeName = SearchForm.EmployeeName.Trim();
            query = query.Where(r =>
                r.Employee.FirstName.Contains(employeeName) ||
                r.Employee.LastName.Contains(employeeName) ||
                (r.Employee.FirstName + " " + r.Employee.LastName).Contains(employeeName));
        }

        if (SearchForm.Category.HasValue)
            query = query.Where(r => r.Category == SearchForm.Category.Value);

        if (SearchForm.Status.HasValue)
            query = query.Where(r => r.CurrentStatus == SearchForm.Status.Value);
        if (SearchForm.StartDate.HasValue)
        {
            var exactStart = SearchForm.StartDate.Value.Date;
            var nextDay = exactStart.AddDays(1);
            query = query.Where(r => r.StartDate >= exactStart && r.StartDate < nextDay);
        }
        if (SearchForm.EndDate.HasValue)
        {
            var exactEnd = SearchForm.EndDate.Value.Date;
            var nextDay = exactEnd.AddDays(1);
            query = query.Where(r => r.EndDate >= exactEnd && r.EndDate < nextDay);
        }

        return query;
    }

    private Task ReloadLeaveRequestTableAsync(bool resetPage = false)
    {
        if (LeaveRequestTable is null)
        {
            return Task.CompletedTask;
        }

        if (resetPage && LeaveRequestTable.CurrentPage != 0)
        {
            LeaveRequestTable.NavigateTo(0);
            return Task.CompletedTask;
        }

        return LeaveRequestTable.ReloadServerData();
    }

    private static IQueryable<LeaveRequest> BuildLeaveRequestDisplayQuery(IQueryable<LeaveRequest> query)
    {
        return query
            .Include(request => request.Employee);
    }

    private IQueryable<LeaveRequest> ApplyLeaveRequestVisibilityScope(IQueryable<LeaveRequest> query)
    {
        if (CanViewAllLeaveRequests)
        {
            return query;
        }

        var currentEmployeeId = CurrentUser.GetEmployeeId();
        return currentEmployeeId is null
            ? query.Where(_ => false)
            : query.Where(request => request.EmployeeId == currentEmployeeId.Value);
    }

