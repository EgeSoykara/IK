    private async Task UpdateRequestedDayPreviewAsync()
    {
        if (Form.StartDate is null || Form.EndDate is null)
        {
            RequestedDayPreviewState = new(null, null);
            SelectedLeaveRemainingDays = null;
            return;
        }

        try
        {
            await LoadAvailableLeaveRequestOptionsAsync();
            if (!Form.LeaveOptionId.HasValue)
            {
                throw new InvalidOperationException(
                    "Seçili çalışan ve yıl için talep edilebilir izin bakiyesi bulunamadı.");
            }
            var days = await LeaveRequestService.CalculateRequestedDaysAsync(
                DateOnly.FromDateTime(Form.StartDate.Value.Date),
                DateOnly.FromDateTime(Form.EndDate.Value.Date),
                Form.IsHalfDay);
            SelectedLeaveRemainingDays = AvailableLeaveRequestOptions
                .Single(option => option.OptionId == Form.LeaveOptionId)
                .RemainingDays;
            RequestedDayPreviewState = new(days, null);
        }
        catch (InvalidOperationException ex)
        {
            RequestedDayPreviewState = new(null, ex.Message);
            SelectedLeaveRemainingDays = null;
        }
    }

