    private async Task OpenLeaveRequestEditorForEmployee(Employee? initialEmployee)
    {
        if (!CanManageLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini oluşturma yetkiniz yok.");
            return;
        }

        if (ExistingEmployees.Count == 0)
        {
            SetFeedback(Severity.Error, "Giriş yapan kullanıcıya bağlı çalışan kaydı bulunamadı.");
            return;
        }

        var requestEmployee = initialEmployee ?? ExistingEmployees[0];
        Form = new LeaveRequestEntryForm
        {
            EmployeeId = requestEmployee.EmployeeId,
            SelectedDateRange = new DateRange(Today, Today)
        };
        SelectedEmployee = requestEmployee;
        await LoadDelegateCandidatesAsync();
        await LoadAvailableLeaveRequestOptionsAsync();
        if (AvailableLeaveRequestOptions.Count == 0)
        {
            SetFeedback(Severity.Warning, "Seçili çalışan için talep edilebilir izin bakiyesi bulunamadı.");
            return;
        }

        IsEditing = false;
        FeedbackMessage = null;
        IsLeaveRequestEditorOpen = true;
        await UpdateRequestedDayPreviewAsync();
    }

