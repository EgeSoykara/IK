    private async Task EditLeaveRequestAsync(int requestId)
    {
        if (!CanEditDeleteLeaveRequests)
        {
            SetFeedback(Severity.Error, "İzin taleplerini düzenleme yetkiniz yok.");
            return;
        }

        var request = await Database.LeaveRequests.AsNoTracking()
            .FirstOrDefaultAsync(r => r.RequestId == requestId);
        if (request is null) { SetFeedback(Severity.Error, "İzin talebi bulunamadı."); return; }
        if (request.CurrentStatus != LeaveRequestStatus.ManagerReview)
        {
            SetFeedback(Severity.Error, "Yalnızca yönetici onayı bekleyen izin talepleri düzenlenebilir.");
            return;
        }

        Form = new LeaveRequestEntryForm
        {
            RequestId = request.RequestId,
            EmployeeId = request.EmployeeId,
            LeaveOptionId = request.Category == LeaveRequestCategory.AnnualLeave
                ? 0
                : request.LeaveTypeId,
            SelectedDateRange = new DateRange(request.StartDate?.Date, request.EndDate?.Date),
            IsHalfDay = request.RequestedDays == 0.5m,
            IsRetrospective = request.IsRetrospective,
            Reason = request.Reason,
            DelegateEmployeeId = request.DelegateEmployeeId
        };

        SelectedEmployee = ExistingEmployees.FirstOrDefault(e => e.EmployeeId == request.EmployeeId);
        await LoadDelegateCandidatesAsync();
        await LoadAvailableLeaveRequestOptionsAsync();
        
        IsEditing = true;
        FeedbackMessage = null;
        IsLeaveRequestEditorOpen = true;
        await UpdateRequestedDayPreviewAsync();
    }

    private bool IsOwnerOrEditor(LeaveRequest request) =>
        CurrentEmployeeId == request.EmployeeId || CanEditDeleteLeaveRequests;

    private static LeaveCancellationRequest? LatestCancellation(LeaveRequest request) =>
        request.CancellationRequests
            .OrderByDescending(item => item.CreatedAt)
            .ThenByDescending(item => item.CancellationRequestId)
            .FirstOrDefault();

    private bool CanDirectlyCancel(LeaveRequest request) =>
        IsOwnerOrEditor(request) && request.CurrentStatus == LeaveRequestStatus.ManagerReview;

    private bool CanRequestCancellation(LeaveRequest request)
    {
        var latest = LatestCancellation(request);
        var hasPending = latest?.CurrentStatus is LeaveRequestStatus.ManagerReview
            or LeaveRequestStatus.HumanResourcesReview;
        return IsOwnerOrEditor(request)
               && request.CurrentStatus == LeaveRequestStatus.Approved
               && request.EndDate?.Date >= Today
               && !hasPending;
    }

    private static string FormatCancellationStatus(LeaveRequest request)
    {
        var cancellation = LatestCancellation(request);
        if (request.CurrentStatus == LeaveRequestStatus.Cancelled)
        {
            return "İzin iptal edildi";
        }
        return cancellation?.CurrentStatus switch
        {
            LeaveRequestStatus.ManagerReview => "Müdür onayı bekleniyor",
            LeaveRequestStatus.HumanResourcesReview => "İK onayı bekleniyor",
            LeaveRequestStatus.Approved => $"Onaylandı · {FormatDayCount(cancellation.RequestedRefundDays)} gün iade",
            LeaveRequestStatus.Rejected => "İptal talebi reddedildi",
            _ => "—"
        };
    }

    private async Task CancelPendingRequestAsync(LeaveRequest request)
