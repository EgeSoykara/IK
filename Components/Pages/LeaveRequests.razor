@attribute [Authorize]
@page "/LeaveRequests"
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService
@inject LeaveCancellationService LeaveCancellationService

<div class="management-shell">
    <MudDialog @bind-Visible="IsLeaveRequestEditorOpen" Options="LeaveRequestDialogOptions">
        <TitleContent>
            <section class="leave-request-editor-header" aria-labelledby="leave-request-editor-title">
                <div>
                    <MudText Typo="Typo.overline">@(IsEditing ? "Talebi Düzenle" : "Yeni Talep")</MudText>
                    <h2 id="leave-request-editor-title">@(IsEditing ? "İzin Talebini Düzenle" : "İzin Talebi Oluştur")</h2>
                    <p>İzin bilgilerini eksiksiz girerek talebinizi onaya gönderin.</p>
                </div>
            </section>
        </TitleContent>
        <DialogContent>
            <EditForm Model="@Form" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit" FormName="LeaveRequestsForm">
            <DataAnnotationsValidator />
            <div class="leave-request-editor-layout">
                <main class="leave-request-editor-card">
                    @if (FeedbackMessage is not null)
                    {
                        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
                    }
                    <ValidationSummary />

                    <section class="leave-request-form-section" aria-labelledby="request-owner-title">
                        <div class="leave-request-form-section-heading">
                            <MudIcon Icon="@Icons.Material.Filled.Person" aria-hidden="true" />
                            <h2 id="request-owner-title">Talep Sahibi</h2>
                        </div>
                        <div class="leave-request-owner-grid">
                            <MudAutocomplete T="Employee"
                                             Label="Çalışan Ara..."
                                             Value="@SelectedEmployee"
                                             ValueChanged="OnEmployeeSelected"
                                             SearchFunc="SearchEmployeesAsync"
                                             ToStringFunc="@(e => e == null ? string.Empty : $"{e.FirstName} {e.LastName} ({e.SicilNo})")"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Required="true"
                                             RequiredError="Çalışan seçimi zorunludur."
                                             Validation="@(new Func<Employee, string?>(e => e == null ? "Çalışan seçimi zorunludur." : null))" />

                            @if (CanSelectDelegate)
                            {
                                <MudSelect T="int?"
                                           @bind-Value="Form.DelegateEmployeeId"
                                           Label="İzin Süresince Vekil"
                                           Required="true"
                                           RequiredError="Yönetici izin talebinde vekil seçimi zorunludur."
                                           HelperText="Vekâlet yalnız İK onayından sonra izin başlangıç tarihinde etkinleşir.">
                                    @foreach (var employee in DelegateCandidates)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)employee.EmployeeId)">
                                            @($"{employee.FirstName} {employee.LastName} ({employee.SicilNo})")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </div>
                    </section>

                    <section class="leave-request-form-section" aria-labelledby="request-details-title">
                        <div class="leave-request-form-section-heading">
                            <MudIcon Icon="@Icons.Material.Filled.Event" aria-hidden="true" />
                            <h2 id="request-details-title">İzin Bilgileri</h2>
                        </div>

                        <div class="leave-request-leave-type-field">
                            @if (SelectedLeaveRemainingDays is { } remainingDays)
                            {
                                <span class="leave-request-balance-chip">Kalan: @FormatDayCount(remainingDays) gün</span>
                            }
                            <MudSelect T="int?"
                                       Value="@Form.LeaveOptionId"
                                       ValueChanged="OnLeaveOptionChangedAsync"
                                       Label="İzin Türü"
                                       Required="true"
                                       RequiredError="İzin türü seçimi zorunludur.">
                                @foreach (var option in AvailableLeaveRequestOptions)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)option.OptionId)">
                                        @option.Name (@FormatDayCount(option.RemainingDays) gün)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>

                        <div class="leave-request-date-field">
                            @if (Form.IsHalfDay)
                            {
                                <MudDatePicker Date="@Form.StartDate"
                                               DateChanged="OnHalfDayDateChanged"
                                               Label="Yarım Gün Tarihi"
                                               MinDate="@MinimumRequestDate"
                                               Required="true"
                                               RequiredError="Başlangıç ve bitiş tarihleri zorunludur."
                                               AutoClose="true" />
                            }
                            else
                            {
                                <MudDateRangePicker @bind-DateRange="Form.SelectedDateRange"
                                                    @bind-DateRange:after="UpdateRequestedDayPreviewAsync"
                                                    Label="İzin Tarih Aralığı"
                                                    PlaceholderStart="Başlangıç"
                                                    PlaceholderEnd="Bitiş"
                                                    MinDate="@MinimumRequestDate"
                                                    Required="true"
                                                    RequiredError="Başlangıç ve bitiş tarihleri zorunludur."
                                                    AutoClose="true" />
                            }
                        </div>

                        <div class="leave-request-retrospective-panel">
                            <MudCheckBox T="bool"
                                         @bind-Value="Form.IsRetrospective"
                                         @bind-Value:after="UpdateRequestedDayPreviewAsync"
                                         Label="Geriye dönük izin talebi" />
                            <p>Geçmişte gerçekleşmiş devamsızlığı izin sürecine almak için işaretleyin.</p>
                        </div>

                        <div class="leave-request-half-day-panel">
                            <div>
                                <MudSwitch T="bool"
                                           Value="@Form.IsHalfDay"
                                           ValueChanged="OnHalfDayChanged"
                                           Color="Color.Primary"
                                           Label="Yarım gün izin" />
                                <p>İzin tek bir yarım iş günü sürecekse işaretleyin.</p>
                            </div>
                        </div>

                        @if (RequestedDayPreviewState.Days is { } requestedDays)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                Seçilen tarih aralığı @FormatDayCount(requestedDays) iş günüdür. Hafta sonları ve tanımlı resmî tatiller hesaba katılmaz.
                                @if (SelectedLeaveRemainingDays is { } totalRemainingDays)
                                {
                                    @if (requestedDays > totalRemainingDays)
                                    {
                                        <text> Bu talep onaylanırsa seçili çalışanın @Form.LeaveOptionName bakiyesi @FormatDayCount(LeaveBalanceDashboardSummary.ProjectRemainingDays(totalRemainingDays, requestedDays)) gün olacak. (Uyarı: Talep edilen gün sayısı mevcut izin bakiyesinden fazla.)</text>
                                    }
                                    else
                                    {
                                        <text> Bu talep onaylanırsa seçili çalışanın @Form.LeaveOptionName bakiyesi @FormatDayCount(LeaveBalanceDashboardSummary.ProjectRemainingDays(totalRemainingDays, requestedDays)) gün olacak.</text>
                                    }
                                }
                            </MudAlert>
                        }
                        else if (RequestedDayPreviewState.Error is { } previewError)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@previewError</MudAlert>
                        }
                    </section>

                    <section class="leave-request-form-section" aria-labelledby="request-reason-title">
                        <div class="leave-request-form-section-heading">
                            <MudIcon Icon="@Icons.Material.Filled.Description" aria-hidden="true" />
                            <h2 id="request-reason-title">Açıklama</h2>
                        </div>
                        <MudTextField T="string"
                                      @bind-Value="Form.Reason"
                                      Label="İzin Talep Nedeni"
                                      Placeholder="İzin talebinizle ilgili eklemek istediklerinizi yazabilirsiniz..."
                                      Required="true"
                                      RequiredError="İzin talep nedeni zorunludur."
                                      Lines="4" />
                    </section>
                </main>

                <aside class="leave-request-summary-column">
                    <section class="leave-request-summary" aria-labelledby="leave-request-summary-title">
                        <div class="leave-request-summary-heading">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" aria-hidden="true" />
                            <h2 id="leave-request-summary-title">Talep Özeti</h2>
                        </div>
                        <dl>
                            <div>
                                <dt>Çalışan</dt>
                                <dd>@SelectedEmployeeDisplay</dd>
                            </div>
                            <div>
                                <dt>İzin Türü</dt>
                                <dd>@SelectedLeaveOptionDisplay</dd>
                            </div>
                            <div>
                                <dt>Tarih Aralığı</dt>
                                <dd>@SelectedDateRangeDisplay</dd>
                            </div>
                            <div>
                                <dt>İş Günü Sayısı</dt>
                                <dd class="leave-request-summary-days">@RequestedDaysDisplay</dd>
                            </div>
                            <div>
                                <dt>Mevcut Bakiye</dt>
                                <dd>@SelectedLeaveBalanceDisplay</dd>
                            </div>
                            <div class="leave-request-summary-result">
                                <dt>Kalan Bakiye</dt>
                                <dd>@(ProjectedRemainingDaysDisplay ?? "—")</dd>
                            </div>
                        </dl>
                        <div class="leave-request-summary-info">
                            <MudIcon Icon="@Icons.Material.Filled.Info" aria-hidden="true" />
                            <p>Cumartesi, Pazar ve tanımlı resmî tatiller izin süresinden sayılmaz.</p>
                        </div>
                    </section>

                    <div class="leave-request-editor-actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CloseLeaveRequestEditor">
                            Vazgeç
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.Send">
                            @(IsEditing ? "Değişiklikleri Kaydet" : "Talebi Gönder")
                        </MudButton>
                    </div>
                </aside>
            </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsCancellationDialogOpen" Options="LeaveRequestDialogOptions">
        <TitleContent><MudText Typo="Typo.h6">İzin İptal Talebi</MudText></TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-3">@FeedbackMessage</MudAlert>
            }
            <EditForm Model="CancellationForm" OnValidSubmit="CreateCancellationAsync" FormName="LeaveCancellationForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    Seçtiğiniz iptal aralığındaki kullanılmamış iş günleri,
                    @(CancellationForm.RequiresManagerApproval
                        ? "müdür ve İK onayından sonra"
                        : "atanmış müdür bulunmadığı için İK onayından sonra") bakiyeye iade edilir.
                </MudAlert>
                <MudDatePicker @bind-Date="CancellationForm.CancellationStartDate"
                               Label="İptal Başlangıç Tarihi"
                               MinDate="@CancellationForm.MinimumCancellationDate"
                               MaxDate="@CancellationForm.MaximumCancellationDate"
                               Required="true"
                               RequiredError="İptal başlangıç tarihi zorunludur." />
                <MudDatePicker @bind-Date="CancellationForm.CancellationEndDate"
                               Label="İptal Bitiş Tarihi"
                               MinDate="@CancellationForm.CancellationEndMinimumDate"
                               MaxDate="@CancellationForm.MaximumCancellationDate"
                               Required="true"
                               RequiredError="İptal bitiş tarihi zorunludur." />
                @if (CancellationForm.CancellationStartDate.HasValue)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="leave-cancellation-work-date">
                        İşe başlayacağı tarih: <strong>@CancellationForm.CancellationStartDate.Value.ToString("dd.MM.yyyy")</strong>
                    </MudAlert>
                }
                <MudTextField T="string"
                              @bind-Value="CancellationForm.Reason"
                              Label="İptal Nedeni"
                              Lines="3"
                              Required="true"
                              RequiredError="İptal nedeni zorunludur." />
                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" OnClick="CloseCancellationDialog">Vazgeç</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">İptal Talebini Gönder</MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

        <section class="management-page-header leave-request-page-header">
            <div>
                <MudText Typo="Typo.overline">Yönetim</MudText>
                <h1>İzin Talepleri</h1>
                <p>İzin taleplerini oluşturun, arayın ve yetkinize göre düzenleyin.</p>
            </div>
            @if (CanManageLeaveRequests)
            {
                <ManagementCreateButton Label="Talep Oluştur"
                                        AriaLabel="İzin talebi oluştur"
                                        OnClick="OpenLeaveRequestEditor" />
            }
        </section>

        <section class="management-page-filters" aria-label="İzin talebi filtreleri">
            <ManagementFilterButton AriaLabel="İzin taleplerini filtrele" OnClick="OpenSearchDialog" />
            <ManagementActiveFilters Filters="ActiveFilters" OnRemove="RemoveFilterAsync" OnClearAll="ClearFiltersAsync" />
        </section>

        @if (FeedbackMessage is not null && !IsLeaveRequestEditorOpen)
        {
            <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
        }

    <MudDialog @bind-Visible="IsSearchDialogOpen" Options="SearchDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">İzin Talebi Ara</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField T="int?" @bind-Value="SearchDraft.RequestId" Label="Talep ID" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.EmployeeName"
                             Label="Çalışan"
                             SearchFunc="SearchEmployeeNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudSelect T="int?" @bind-Value="SearchDraft.LeaveOptionId" Label="İzin Türü" Clearable="true">
                <MudSelectItem T="int?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var option in RequestFilterOptions)
                {
                    <MudSelectItem T="int?" Value="@((int?)option.OptionId)">@option.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="LeaveRequestStatus?" @bind-Value="SearchDraft.Status" Label="Durum" Clearable="true">
                <MudSelectItem T="LeaveRequestStatus?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var s in Enum.GetValues<LeaveRequestStatus>())
                {
                    <MudSelectItem T="LeaveRequestStatus?" Value="@(s)">@FormatRequestStatus(s)</MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="SearchDraft.StartDate" Label="Başlangıç Tarihi" />
            <MudDatePicker @bind-Date="SearchDraft.EndDate" Label="Bitiş Tarihi" />
            <div class="management-search-actions">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">Filtreleri Temizle</MudButton>
                <div class="management-search-actions-primary">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">Ara</MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsReasonDialogOpen">
        <TitleContent>
            <MudText Typo="Typo.h6">İzin Talep Nedeni</MudText>
        </TitleContent>
        <DialogContent>
            <MudText Style="white-space: pre-wrap; overflow-wrap: anywhere;">@SelectedReason</MudText>
            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseReasonDialog">Kapat</MudButton>
            </div>
        </DialogContent>
    </MudDialog>

        @if (IsPageReady)
        {
        <section class="leave-request-list-workspace" aria-label="İzin talebi listesi">
            <nav class="leave-request-status-tabs" aria-label="Talep durumu">
                <button type="button" class="@GetStatusTabClass(null)" aria-pressed="@(SearchForm.Status is null ? "true" : "false")" @onclick="@(() => SelectStatusFilterAsync(null))">Tümü</button>
                @foreach (var status in Enum.GetValues<LeaveRequestStatus>())
                {
                    <button type="button" class="@GetStatusTabClass(status)" aria-pressed="@(SearchForm.Status == status ? "true" : "false")" @onclick="@(() => SelectStatusFilterAsync(status))">@FormatRequestStatus(status)</button>
                }
            </nav>
            <MudTable @ref="LeaveRequestTable"
              ServerData="LoadLeaveRequestsAsync"
              RowsPerPage="25"
              Dense="true"
              Hover="true"
              Class="management-data-table">
        <ToolBarContent>
            <MudSpacer />
            <span class="leave-request-result-count">@TotalLeaveRequestCount talep</span>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Talep ID</MudTh>
            <MudTh>Çalışan</MudTh>
            <MudTh>İzin Türü</MudTh>
            <MudTh>Başlangıç Tarihi</MudTh>
            <MudTh>Bitiş Tarihi</MudTh>
            <MudTh>Talep Edilen Gün</MudTh>
            <MudTh>Neden</MudTh>
            <MudTh>Durum</MudTh>
            <MudTh>İptal Durumu</MudTh>
            <MudTh>İşlemler</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Talep ID">@context.RequestId</MudTd>
            <MudTd DataLabel="Çalışan">@FormatEmployeeName(context.Employee)</MudTd>
            <MudTd DataLabel="İzin Türü">@context.DisplayName()</MudTd>
            <MudTd DataLabel="Başlangıç Tarihi">@FormatDate(context.StartDate)</MudTd>
            <MudTd DataLabel="Bitiş Tarihi">@FormatDate(context.EndDate)</MudTd>
            <MudTd DataLabel="Talep Edilen Gün">@FormatDayCount(context.RequestedDays)</MudTd>
            <MudTd DataLabel="Neden">
                @if (string.IsNullOrWhiteSpace(context.Reason))
                {
                    @:-
                }
                else if (!RequiresExpandedTextDisplay(context.Reason))
                {
                    @context.Reason
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               aria-label="@($"Talep {context.RequestId} neden detayını görüntüle")"
                               OnClick="@(() => OpenReasonDialog(context.Reason))">
                        @BuildPreviewLabel(context.Reason)
                    </MudButton>
                }
            </MudTd>
            <MudTd DataLabel="Durum">
                <span class="@RequestStatusClass(context.CurrentStatus)">@FormatRequestStatus(context.CurrentStatus)</span>
            </MudTd>
            <MudTd DataLabel="İptal Durumu">@FormatCancellationStatus(context)</MudTd>
            <MudTd DataLabel="İşlemler">
                    <div class="d-flex gap-2">
                        @if (CanEditDeleteLeaveRequests && context.CurrentStatus == LeaveRequestStatus.ManagerReview)
                        {
                            <MudTooltip Text="Düzenle">
                                <MudIconButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               Icon="@Icons.Material.Filled.Edit"
                                               aria-label="@($"Talep {context.RequestId} kaydını düzenle")"
                                               OnClick="@(() => EditLeaveRequestAsync(context.RequestId))" />
                            </MudTooltip>
                        }
                        @if (CanDirectlyCancel(context))
                        {
                            <MudTooltip Text="Talebi İptal Et">
                                <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                               Icon="@Icons.Material.Filled.EventBusy"
                                               aria-label="@($"Talep {context.RequestId} doğrudan iptal et")"
                                               OnClick="@(() => CancelPendingRequestAsync(context))" />
                            </MudTooltip>
                        }
                        else if (CanRequestCancellation(context))
                        {
                            <MudTooltip Text="İptal Talebi Oluştur">
                                <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                               Icon="@Icons.Material.Filled.EventBusy"
                                               aria-label="@($"Talep {context.RequestId} için iptal talebi oluştur")"
                                               OnClick="@(() => OpenCancellationDialog(context))" />
                            </MudTooltip>
                        }
                        @if (CanEditDeleteLeaveRequests)
                        {
                            <MudTooltip Text="Sil">
                                <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                               Icon="@Icons.Material.Filled.Delete"
                                               aria-label="@($"Talep {context.RequestId} kaydını sil")"
                                               OnClick="@(() => DeleteLeaveRequestAsync(context.RequestId))" />
                            </MudTooltip>
                        }
                    </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Henüz kayıtlı izin talebi bulunmuyor.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                           RowsPerPageString="Sayfa başına kayıt:"
                           InfoFormat="{first_item}-{last_item} / {all_items}" />
        </PagerContent>
            </MudTable>
        </section>
        }
</div>


@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private bool IsEditing { get; set; }
    private bool IsLeaveRequestEditorOpen { get; set; }
    private bool IsSearchDialogOpen { get; set; }
    private bool IsReasonDialogOpen { get; set; }
    private bool IsCancellationDialogOpen { get; set; }
    private bool IsPageReady { get; set; }
    private static readonly DialogOptions SearchDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Medium, FullWidth = true
    };
    private static readonly DialogOptions LeaveRequestDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true
    };
    
    private LeaveRequestEntryForm Form { get; set; } = new();
    private LeaveCancellationForm CancellationForm { get; set; } = new();
    private LeaveRequestSearchForm SearchForm { get; set; } = new();
    private LeaveRequestSearchForm SearchDraft { get; set; } = new();
    private List<Employee> ExistingEmployees { get; set; } = [];
    private MudTable<LeaveRequest>? LeaveRequestTable { get; set; }
    private static readonly int[] ManagementPageSizeOptions = [10, 25, 50, 100];
    private int TotalLeaveRequestCount { get; set; }

    private Employee? SelectedEmployee { get; set; }
    private List<Employee> DelegateCandidates { get; set; } = [];
    private bool CanSelectDelegate { get; set; }
    private List<LeaveRequestOption> AvailableLeaveRequestOptions { get; set; } = [];
    private List<LeaveRequestOption> RequestFilterOptions { get; set; } = [];
    private decimal? SelectedLeaveRemainingDays { get; set; }

    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private string SelectedReason { get; set; } = string.Empty;
    private RequestedDayPreview RequestedDayPreviewState { get; set; } = new(null, null);
    private bool CanManageLeaveRequests => PageAccessService.CanManageLeaveRequests(CurrentUser);
    private bool CanEditDeleteLeaveRequests => PageAccessService.CanEditDeleteLeaveRequests(CurrentUser);
    private int? CurrentEmployeeId => CurrentUser.GetEmployeeId();
    private DateTime Today => DateTime.Today;
    private DateTime? MinimumRequestDate => Form.IsRetrospective ? null : Today;
    private bool CanViewAllLeaveRequests =>
        PageAccessService.CanViewLeaveRequests(CurrentUser)
        || CanEditDeleteLeaveRequests;
    private string SelectedEmployeeDisplay => SelectedEmployee is null
        ? "Çalışan seçilmedi"
        : FormatEmployeeName(SelectedEmployee);
    private string SelectedLeaveOptionDisplay => string.IsNullOrWhiteSpace(Form.LeaveOptionName)
        ? "İzin türü seçilmedi"
        : Form.LeaveOptionName;
    private string SelectedDateRangeDisplay => Form.StartDate is null || Form.EndDate is null
        ? "Tarih seçilmedi"
        : Form.StartDate.Value.Date == Form.EndDate.Value.Date
            ? FormatDate(Form.StartDate)
            : $"{FormatDate(Form.StartDate)} – {FormatDate(Form.EndDate)}";
    private string RequestedDaysDisplay => RequestedDayPreviewState.Days is { } days
        ? $"{FormatDayCount(days)} iş günü"
        : "Hesaplanmadı";
    private string SelectedLeaveBalanceDisplay => SelectedLeaveRemainingDays is { } remainingDays
        ? $"{FormatDayCount(remainingDays)} gün"
        : "—";
    private string? ProjectedRemainingDaysDisplay =>
