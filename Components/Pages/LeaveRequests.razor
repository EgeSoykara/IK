    private static bool RequiresExpandedTextDisplay(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
            && (value.Length > 20 || value.Contains('\n') || value.Contains('\r'));
    }

    private static string BuildPreviewLabel(string value)
    {
        const int previewLength = 20;
        var normalized = string.Join(" ", value.Split([' ', '\t', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries));

        if (normalized.Length <= previewLength)
        {
            return normalized;
        }

        return $"{normalized[..previewLength]}...";
    }

