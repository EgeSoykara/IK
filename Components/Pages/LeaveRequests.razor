    private IReadOnlyList<ManagementFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ManagementFilter>();
            if (SearchForm.RequestId.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.RequestId), $"Talep ID: {SearchForm.RequestId}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName)) filters.Add(new(nameof(LeaveRequestSearchForm.EmployeeName), $"Çalışan: {SearchForm.EmployeeName.Trim()}"));
            if (SearchForm.LeaveOptionId.HasValue)
            {
                var optionName = RequestFilterOptions
                    .Single(option => option.OptionId == SearchForm.LeaveOptionId.Value)
                    .Name;
                filters.Add(new(nameof(LeaveRequestSearchForm.LeaveOptionId), $"İzin türü: {optionName}"));
            }
            if (SearchForm.Status.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.Status), $"Durum: {FormatRequestStatus(SearchForm.Status.Value)}"));
            if (SearchForm.StartDate.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.StartDate), $"Başlangıç: {SearchForm.StartDate:yyyy-MM-dd}"));
            if (SearchForm.EndDate.HasValue) filters.Add(new(nameof(LeaveRequestSearchForm.EndDate), $"Bitiş: {SearchForm.EndDate:yyyy-MM-dd}"));
            return filters;
        }
    }

    private async Task<TableData<LeaveRequest>> LoadLeaveRequestsAsync(TableState state, CancellationToken cancellationToken)
    {
        var query = BuildLeaveRequestDisplayQuery(
            ApplyLeaveRequestSearch(
                ApplyLeaveRequestVisibilityScope(Database.LeaveRequests.AsNoTracking())));

        var tableData = await query
            .OrderByDescending(r => r.CreatedAt)
            .ThenByDescending(r => r.RequestId)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
        TotalLeaveRequestCount = tableData.TotalItems;
        return tableData;
    }

    private IQueryable<LeaveRequest> ApplyLeaveRequestSearch(IQueryable<LeaveRequest> query)
    {
        if (SearchForm.RequestId.HasValue)
            query = query.Where(r => r.RequestId == SearchForm.RequestId.Value);

        if (SearchForm.EmployeeId.HasValue)
        {
            query = query.Where(r => r.EmployeeId == SearchForm.EmployeeId.Value);
        }
        else if (!string.IsNullOrWhiteSpace(SearchForm.EmployeeName))
        {
            var employeeName = SearchForm.EmployeeName.Trim();
            query = query.Where(r =>
                r.Employee.FirstName.Contains(employeeName) ||
                r.Employee.LastName.Contains(employeeName) ||
                (r.Employee.FirstName + " " + r.Employee.LastName).Contains(employeeName));
        }

        if (SearchForm.LeaveOptionId == 0)
            query = query.Where(request => request.Category == LeaveRequestCategory.AnnualLeave);
        else if (SearchForm.LeaveOptionId is { } leaveTypeId)
            query = query.Where(request =>
                request.Category == LeaveRequestCategory.SpecificLeaveType
                && request.LeaveTypeId == leaveTypeId);

        if (SearchForm.Status.HasValue)
            query = query.Where(r => r.CurrentStatus == SearchForm.Status.Value);
        if (SearchForm.StartDate.HasValue)
        {
            var exactStart = SearchForm.StartDate.Value.Date;
            var nextDay = exactStart.AddDays(1);
            query = query.Where(r => r.StartDate >= exactStart && r.StartDate < nextDay);
        }
        if (SearchForm.EndDate.HasValue)
        {
            var exactEnd = SearchForm.EndDate.Value.Date;
            var nextDay = exactEnd.AddDays(1);
            query = query.Where(r => r.EndDate >= exactEnd && r.EndDate < nextDay);
        }

        return query;
    }

    private Task ReloadLeaveRequestTableAsync(bool resetPage = false)
    {
        if (LeaveRequestTable is null)
        {
            return Task.CompletedTask;
        }

        if (resetPage && LeaveRequestTable.CurrentPage != 0)
        {
            LeaveRequestTable.NavigateTo(0);
            return Task.CompletedTask;
        }

        return LeaveRequestTable.ReloadServerData();
    }

    private static IQueryable<LeaveRequest> BuildLeaveRequestDisplayQuery(IQueryable<LeaveRequest> query)
    {
        return query
            .Include(request => request.Employee)
            .Include(request => request.LeaveType)
            .Include(request => request.CancellationRequests);
    }

    private IQueryable<LeaveRequest> ApplyLeaveRequestVisibilityScope(IQueryable<LeaveRequest> query)
    {
        if (CanViewAllLeaveRequests)
        {
            return query;
        }

        var currentEmployeeId = CurrentUser.GetEmployeeId();
        return currentEmployeeId is null
            ? query.Where(_ => false)
            : query.Where(request => request.EmployeeId == currentEmployeeId.Value);
    }

    private static string FormatEmployeeName(Employee employee)
    {
        return $"{employee.FirstName} {employee.LastName}";
    }

    private string ActorId() => CurrentUser?.Identity?.Name ?? "System";

    private sealed class LeaveRequestEntryForm : IValidatableObject
    {
        public int? RequestId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Çalışan seçimi zorunludur.")]
        public int EmployeeId { get; set; }

        [Required(ErrorMessage = "İzin türü seçimi zorunludur.")]
        public int? LeaveOptionId { get; set; }
        public string LeaveOptionName { get; set; } = string.Empty;
        public LeaveRequestCategory Category => LeaveOptionId == 0
            ? LeaveRequestCategory.AnnualLeave
            : LeaveRequestCategory.SpecificLeaveType;
        public int? LeaveTypeId => LeaveOptionId is > 0 ? LeaveOptionId : null;

        public DateRange SelectedDateRange { get; set; } = new();
        public DateTime? StartDate => SelectedDateRange.Start?.Date;
        public DateTime? EndDate => (IsHalfDay ? SelectedDateRange.Start : SelectedDateRange.End)?.Date;
        public bool IsHalfDay { get; set; }
        public bool IsRetrospective { get; set; }
        public int? DelegateEmployeeId { get; set; }
        public bool DelegateRequired { get; set; }

        [Required(ErrorMessage = "İzin talep nedeni zorunludur.")]
        [MaxLength(500)]
        public string Reason { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (DelegateRequired && !DelegateEmployeeId.HasValue)
            {
                yield return new ValidationResult(
                    "Yönetici izin talebinde vekil seçimi zorunludur.",
                    [nameof(DelegateEmployeeId)]);
            }

            if (StartDate is null || EndDate is null)
            {
                yield return new ValidationResult(
                    "Başlangıç ve bitiş tarihleri zorunludur.",
                    [nameof(StartDate), nameof(EndDate)]);
                yield break;
            }

            var today = DateTime.Today;
            if (!IsRetrospective
                && (StartDate.Value.Date < today || EndDate.Value.Date < today))
            {
                yield return new ValidationResult(
                    "Geçmiş tarihli izin talebi oluşturulamaz.",
                    [nameof(StartDate), nameof(EndDate)]);
                yield break;
            }

            if (EndDate.Value.Date < StartDate.Value.Date)
            {
                yield return new ValidationResult(
                    "İzin bitiş tarihi, başlangıç tarihinden önce olamaz.",
                    [nameof(StartDate), nameof(EndDate)]);
            }

            if (IsHalfDay && StartDate.Value.Date != EndDate.Value.Date)
            {
                yield return new ValidationResult(
                    "Yarım gün izin yalnızca tek bir gün için seçilebilir.",
                    [nameof(StartDate), nameof(EndDate), nameof(IsHalfDay)]);
            }
        }

        public DateTime BuildStartDate()
        {
            if (StartDate is null)
            {
                throw new InvalidOperationException("Başlangıç tarihi zorunludur.");
            }

            return StartDate.Value.Date;
        }

        public DateTime BuildEndDate()
        {
            if (EndDate is null)
            {
                throw new InvalidOperationException("Bitiş tarihi zorunludur.");
            }

            return EndDate.Value.Date;
        }
    }

