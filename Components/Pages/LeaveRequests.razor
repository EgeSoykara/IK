    {
        switch (key)
        {
            case nameof(LeaveRequestSearchForm.RequestId): SearchForm.RequestId = null; break;
            case nameof(LeaveRequestSearchForm.EmployeeName): SearchForm.EmployeeName = null; break;
            case nameof(LeaveRequestSearchForm.Category): SearchForm.Category = null; break;
            case nameof(LeaveRequestSearchForm.Status): SearchForm.Status = null; break;
