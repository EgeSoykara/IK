    private async Task LoadAvailableLeaveRequestOptionsAsync()
    {
        AvailableLeaveRequestOptions = [];
        SelectedLeaveRemainingDays = null;
        if (SelectedEmployee is null || Form.StartDate is null)
        {
            Form.LeaveOptionId = null;
            Form.LeaveOptionName = string.Empty;
            return;
        }

        var balances = await Database.LeaveBalances
            .AsNoTracking()
            .Include(balance => balance.LeaveType)
            .Where(balance =>
                balance.EmployeeId == SelectedEmployee.EmployeeId
                && balance.Year == Form.StartDate.Value.Year
                && balance.RemainingDays > 0m)
            .OrderBy(balance => balance.LeaveType.Name)
            .ToListAsync();
        var annualRemaining = balances
            .Where(balance => LeaveEntitlementService.IsServiceTier(
                balance.LeaveType.EntitlementKind))
            .Sum(balance => balance.RemainingDays);
        if (annualRemaining > 0m)
        {
            AvailableLeaveRequestOptions.Add(
                new LeaveRequestOption(0, "Yıllık İzin", annualRemaining));
        }

        AvailableLeaveRequestOptions.AddRange(balances
            .Where(balance => !LeaveEntitlementService.IsServiceTier(
                balance.LeaveType.EntitlementKind))
            .Where(balance => EntitlementService.Calculate(
                SelectedEmployee,
                balance.LeaveType,
                balance.Year).Eligible)
            .Select(balance => new LeaveRequestOption(
                balance.LeaveTypeId,
                balance.LeaveType.Name,
                balance.RemainingDays)));

        if (!AvailableLeaveRequestOptions.Any(option => option.OptionId == Form.LeaveOptionId))
        {
            Form.LeaveOptionId = AvailableLeaveRequestOptions.FirstOrDefault()?.OptionId;
        }
        Form.LeaveOptionName = AvailableLeaveRequestOptions
            .SingleOrDefault(option => option.OptionId == Form.LeaveOptionId)?.Name ?? string.Empty;
    }

    private async Task LoadDelegateCandidatesAsync()
    {
        DelegateCandidates = [];
        CanSelectDelegate = false;
        Form.DelegateRequired = false;

        if (SelectedEmployee is null)
        {
            if (!IsEditing)
            {
                Form.DelegateEmployeeId = null;
            }
            return;
        }

        var managedDepartment = await Database.Departments
            .AsNoTracking()
            .SingleOrDefaultAsync(department =>
                department.ManagerEmployeeId == SelectedEmployee.EmployeeId
                || department.ActiveDelegateEmployeeId == SelectedEmployee.EmployeeId);
        if (managedDepartment is null)
        {
            Form.DelegateEmployeeId = null;
            return;
        }

        var unavailableEmployeeIds = (await Database.ManagerDelegations
                .AsNoTracking()
                .Where(item => item.DepartmentId == managedDepartment.DepartmentId
                               && item.RestoredAt == null)
                .ToListAsync())
            .SelectMany(item => new[] { item.ManagerEmployeeId, item.DelegateEmployeeId })
            .Append(managedDepartment.ManagerEmployeeId ?? 0)
            .ToHashSet();
        DelegateCandidates = await Database.Employees
            .AsNoTracking()
            .Where(employee =>
                employee.DepartmentId == SelectedEmployee.DepartmentId
                && employee.EmployeeId != SelectedEmployee.EmployeeId
                && !unavailableEmployeeIds.Contains(employee.EmployeeId)
                && employee.Status == EmploymentStatus.Active)
            .OrderBy(employee => employee.FirstName)
            .ThenBy(employee => employee.LastName)
            .ToListAsync();
        CanSelectDelegate = true;
        Form.DelegateRequired = true;
    }

