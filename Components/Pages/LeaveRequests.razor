    {
        public int? RequestId { get; set; }
        public int? EmployeeId { get; set; }
        public string? EmployeeName { get; set; }
        public int? LeaveOptionId { get; set; }
        public LeaveRequestStatus? Status { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }

        public LeaveRequestSearchForm Clone()
        {
            return new LeaveRequestSearchForm
            {
                RequestId = RequestId,
                EmployeeId = EmployeeId,
                EmployeeName = EmployeeName,
                LeaveOptionId = LeaveOptionId,
                Status = Status,
                StartDate = StartDate,
                EndDate = EndDate
            };
        }

        public LeaveRequestSearchForm Normalize()
        {
            var normalized = Clone();
            normalized.EmployeeName = ManagementFilterValue.Normalize(normalized.EmployeeName);
            return normalized;
        }
    }

    private sealed class LeaveCancellationForm : IValidatableObject
    {
        public int LeaveRequestId { get; set; }
        [Required(ErrorMessage = "İptal başlangıç tarihi zorunludur.")]
        public DateTime? CancellationStartDate { get; set; }
        [Required(ErrorMessage = "İptal bitiş tarihi zorunludur.")]
        public DateTime? CancellationEndDate { get; set; }
        public DateTime? MinimumCancellationDate { get; set; }
        public DateTime? MaximumCancellationDate { get; set; }
        public DateTime? CancellationEndMinimumDate =>
            CancellationStartDate ?? MinimumCancellationDate;
        public bool RequiresManagerApproval { get; set; }
        [Required(ErrorMessage = "İptal nedeni zorunludur.")]
        [MaxLength(500)]
        public string Reason { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (CancellationStartDate.HasValue
                && CancellationEndDate.HasValue
                && CancellationEndDate.Value.Date < CancellationStartDate.Value.Date)
            {
                yield return new ValidationResult(
                    "İptal bitiş tarihi, başlangıç tarihinden önce olamaz.",
                    [nameof(CancellationEndDate)]);
            }
        }
    }

