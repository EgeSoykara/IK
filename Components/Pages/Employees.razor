            if (!string.IsNullOrWhiteSpace(SearchForm.SicilNo)) filters.Add(new(nameof(EmployeeSearchForm.SicilNo), $"Sicil No: {SearchForm.SicilNo.Trim()}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.KktcKimlikNo)) filters.Add(new(nameof(EmployeeSearchForm.KktcKimlikNo), $"Kimlik No: {SearchForm.KktcKimlikNo.Trim()}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.DepartmentName)) filters.Add(new(nameof(EmployeeSearchForm.DepartmentName), $"Departman: {SearchForm.DepartmentName.Trim()}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.ManagerName)) filters.Add(new(nameof(EmployeeSearchForm.ManagerName), $"Yönetici: {SearchForm.ManagerName.Trim()}"));
            if (SearchForm.ApplicationRoleId.HasValue) filters.Add(new(nameof(EmployeeSearchForm.ApplicationRoleId), $"Rol: {FormatRoleName(SearchForm.ApplicationRoleId.Value)}"));
            if (SearchForm.StartDate.HasValue) filters.Add(new(nameof(EmployeeSearchForm.StartDate), $"İşe başlama ≥ {SearchForm.StartDate:yyyy-MM-dd}"));
            if (SearchForm.StaffDate.HasValue) filters.Add(new(nameof(EmployeeSearchForm.StaffDate), $"Kadro tarihi ≥ {SearchForm.StaffDate:yyyy-MM-dd}"));
