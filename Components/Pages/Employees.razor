        public string? KktcKimlikNo { get; set; }
        public string? SicilNo { get; set; }
        public string? DepartmentName { get; set; }
        public string? ManagerName { get; set; }
        public int? ApplicationRoleId { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? StaffDate { get; set; }
        public EmployeeGender? Gender { get; set; }
        public BloodGroup? BloodGroup { get; set; }
        public EmploymentStatus? Status { get; set; }

        public EmployeeSearchForm Clone()
        {
            return new EmployeeSearchForm
            {
                EmployeeId = EmployeeId,
                FirstName = FirstName,
                LastName = LastName,
                Email = Email,
                KktcKimlikNo = KktcKimlikNo,
                SicilNo = SicilNo,
                DepartmentName = DepartmentName,
                ManagerName = ManagerName,
                ApplicationRoleId = ApplicationRoleId,
                StartDate = StartDate,
                StaffDate = StaffDate,
                Gender = Gender,
                BloodGroup = BloodGroup,
                Status = Status
            };
        }

        public EmployeeSearchForm Normalize()
        {
            var normalized = Clone();
            normalized.FirstName = ManagementFilterValue.Normalize(normalized.FirstName);
            normalized.LastName = ManagementFilterValue.Normalize(normalized.LastName);
            normalized.Email = ManagementFilterValue.Normalize(normalized.Email);
            normalized.KktcKimlikNo = ManagementFilterValue.Normalize(normalized.KktcKimlikNo);
            normalized.SicilNo = ManagementFilterValue.Normalize(normalized.SicilNo);
            normalized.DepartmentName = ManagementFilterValue.Normalize(normalized.DepartmentName);
            normalized.ManagerName = ManagementFilterValue.Normalize(normalized.ManagerName);
            return normalized;
        }
    }
