@page "/Employees"
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using Microsoft.EntityFrameworkCore
@using IK.Web.Services
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService

<div class="management-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Yönetim</MudText>
            <h1>Çalışanlar</h1>
            <p>Çalışan kayıtlarını oluşturun; yönetici departman yapısından otomatik belirlenir.</p>
        </div>
    </section>

    @if (CanSearchEmployees)
    {
        <section class="management-page-filters" aria-label="Çalışan filtreleri">
            <ManagementFilterButton AriaLabel="Çalışanları filtrele" OnClick="OpenSearchDialog" />
            <ManagementActiveFilters Filters="ActiveFilters" OnRemove="RemoveFilterAsync" OnClearAll="ClearFiltersAsync" />
        </section>
    }

    @if (FeedbackMessage is not null && !IsEmployeeDialogOpen)
    {
        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }
    
    <MudDialog @bind-Visible="IsEmployeeDialogOpen" Options="EmployeeDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@(IsEditing ? "Çalışanı Düzenle" : "Çalışan Oluştur")</MudText>
        </TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
            }

            <EditForm Model="@Form" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit" FormName="EmployeesForm">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <MudTextField T="string" @bind-Value="Form.FirstName" Label="Ad" Required="true" RequiredError="Ad zorunludur."/>
                <MudTextField T="string" @bind-Value="Form.LastName" Label="Soyad" Required="true" RequiredError="Soyad zorunludur."/>
                <MudTextField T="string" @bind-Value="Form.Email" Label="E-posta" InputType="InputType.Email"/>
                <MudTextField T="string" @bind-Value="Form.KktcKimlikNo" Label="KKTC Kimlik No" Required="true" RequiredError="KKTC Kimlik No zorunludur."/>
                <MudTextField T="string" @bind-Value="Form.SicilNo" Label="Sicil No" Required="true" RequiredError="Sicil No zorunludur."/>

                <MudSelect T="int" @bind-Value="Form.DepartmentId" Label="Departman" Required="true" RequiredError="Departman seçimi zorunludur.">
                    @foreach (var dept in ExistingDepartments)
                    {
                        <MudSelectItem T="int" Value="@dept.DepartmentId">
                            @dept.DepartmentName
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int" @bind-Value="Form.ApplicationRoleId" Label="Rol" Required="true" RequiredError="Rol seçimi zorunludur." Disabled="@IsBootstrapMode">
                    @foreach (var role in ExistingRoles)
                    {
                        <MudSelectItem T="int" Value="@role.ApplicationRoleId">
                            @role.Name
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudAlert Severity="Severity.Info" Dense="true">
                    Çalışanın yöneticisi seçilen departmanın yöneticisinden otomatik atanır.
                </MudAlert>

                <MudDatePicker @bind-Date="Form.StartDate" Label="İşe Başlama Tarihi"/>
                <MudDatePicker @bind-Date="Form.StaffDate" Label="Kadro Tarihi"/>

                <MudSelect T="EmployeeGender?" @bind-Value="Form.Gender" Label="Cinsiyet" Clearable="true">
                    @foreach (var gender in Enum.GetValues<EmployeeGender>())
                    {
                        <MudSelectItem T="EmployeeGender?" Value="@(gender)">@FormatGender(gender)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="BloodGroup?" @bind-Value="Form.BloodGroup" Label="Kan Grubu" Clearable="true">
                    @foreach (var bloodGroup in Enum.GetValues<BloodGroup>())
                    {
                        <MudSelectItem T="BloodGroup?" Value="@(bloodGroup)">@FormatBloodGroup(bloodGroup)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="EmploymentStatus" @bind-Value="Form.Status" Label="Durum">
                    @foreach (var status in Enum.GetValues<EmploymentStatus>())
                    {
                        <MudSelectItem Value="@status">@FormatEmploymentStatus(status)</MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseEmployeeDialog">
                        İptal
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        @(IsEditing ? "Güncelle" : "Kaydet")
                    </MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsSearchDialogOpen" Options="EmployeeDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Çalışan Ara</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField T="int?" @bind-Value="SearchDraft.EmployeeId" Label="Çalışan ID"/>
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.FirstName"
                             Label="Ad"
                             SearchFunc="SearchFirstNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.LastName"
                             Label="Soyad"
                             SearchFunc="SearchLastNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.Email"
                             Label="E-posta"
                             SearchFunc="SearchEmailsAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.SicilNo"
                             Label="Sicil No"
                             SearchFunc="SearchSicilNumbersAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudSelect T="int?" @bind-Value="SearchDraft.ApplicationRoleId" Label="Rol" Clearable="true">
                <MudSelectItem T="int?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var role in ExistingRoles)
                {
                    <MudSelectItem T="int?" Value="@(role.ApplicationRoleId)">@role.Name</MudSelectItem>
                }
            </MudSelect>
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.KktcKimlikNo"
                             Label="Kimlik No"
                             SearchFunc="SearchIdentityNumbersAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.DepartmentName"
                             Label="Departman"
                             SearchFunc="SearchDepartmentNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudAutocomplete T="string"
                             @bind-Value="SearchDraft.ManagerName"
                             Label="Yönetici"
                             SearchFunc="SearchManagerNamesAsync"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             Clearable="true" />
            <MudDatePicker @bind-Date="SearchDraft.StartDate" Label="İşe Başlama Tarihi"/>
            <MudDatePicker @bind-Date="SearchDraft.StaffDate" Label="Kadro Tarihi"/>
            <MudSelect T="EmployeeGender?" @bind-Value="SearchDraft.Gender" Label="Cinsiyet" Clearable="true">
                <MudSelectItem T="EmployeeGender?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var gender in Enum.GetValues<EmployeeGender>())
                {
                    <MudSelectItem T="EmployeeGender?" Value="@(gender)">@FormatGender(gender)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="BloodGroup?" @bind-Value="SearchDraft.BloodGroup" Label="Kan Grubu" Clearable="true">
                <MudSelectItem T="BloodGroup?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var bloodGroup in Enum.GetValues<BloodGroup>())
                {
                    <MudSelectItem T="BloodGroup?" Value="@(bloodGroup)">@FormatBloodGroup(bloodGroup)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="EmploymentStatus?" @bind-Value="SearchDraft.Status" Label="Durum" Clearable="true">
                <MudSelectItem T="EmploymentStatus?" Value="@(null)">Tümü</MudSelectItem>
                @foreach (var s in Enum.GetValues<EmploymentStatus>())
                {
                    <MudSelectItem T="EmploymentStatus?" Value="@(s)">@FormatEmploymentStatus(s)</MudSelectItem>
                }
            </MudSelect>
            <div class="management-search-actions">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">
                    Filtreleri Temizle
                </MudButton>
                <div class="management-search-actions-primary">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">
                        İptal
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">
                        Ara
                    </MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>

    @if (IsPageReady)
    {
    <MudTable @ref="EmployeeTable"
              ServerData="LoadEmployeesAsync"
              RowsPerPage="25"
              Dense="true"
              Hover="true"
              Class="management-data-table">
        <ToolBarContent>
            <MudSpacer />
            @if (CanManageEmployees)
            {
                <ExcelImportExportActions Dataset="PersonnelExcelDataset.Employees"
                                          OnImported="OnEmployeesImportedAsync" />
                <ManagementCreateButton Label="Çalışan Oluştur" AriaLabel="Çalışan oluştur" OnClick="OpenEmployeeDialog" />
            }
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Çalışan ID</MudTh>
            <MudTh>Sicil No</MudTh>
            <MudTh>Ad</MudTh>
            <MudTh>Soyad</MudTh>
            <MudTh>E-posta</MudTh>
            <MudTh>KKTC Kimlik No</MudTh>
            <MudTh>Departman</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Yönetici</MudTh>
            <MudTh>İşe Başlama Tarihi</MudTh>
            <MudTh>Kadro Tarihi</MudTh>
            <MudTh>Cinsiyet</MudTh>
            <MudTh>Kan Grubu</MudTh>
            <MudTh>Durum</MudTh>
            @if (CanManageEmployees)
            {
                <MudTh>İşlemler</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Çalışan ID">@context.EmployeeId</MudTd>
            <MudTd DataLabel="Sicil No">@context.SicilNo</MudTd>
            <MudTd DataLabel="Ad">@context.FirstName</MudTd>
            <MudTd DataLabel="Soyad">@context.LastName</MudTd>
            <MudTd DataLabel="E-posta">@(context.Email ?? "-")</MudTd>
            <MudTd DataLabel="KKTC Kimlik No">@context.KktcKimlikNo</MudTd>
            <MudTd DataLabel="Departman">@FormatDepartmentName(context.Department)</MudTd>
            <MudTd DataLabel="Rol">@context.ApplicationRole.Name</MudTd>
            <MudTd DataLabel="Yönetici">@FormatEmployeeName(context.Manager)</MudTd>
            <MudTd DataLabel="İşe Başlama Tarihi">@FormatStartDate(context.StartDate)</MudTd>
            <MudTd DataLabel="Kadro Tarihi">@FormatStartDate(context.StaffDate)</MudTd>
            <MudTd DataLabel="Cinsiyet">@FormatGender(context.Gender)</MudTd>
            <MudTd DataLabel="Kan Grubu">@FormatBloodGroup(context.BloodGroup)</MudTd>
            <MudTd DataLabel="Durum">@FormatEmploymentStatus(context.Status)</MudTd>
            @if (CanManageEmployees)
            {
                <MudTd DataLabel="İşlemler">
                    <div class="d-flex gap-2">
                        <MudTooltip Text="Düzenle">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           Icon="@Icons.Material.Filled.Edit"
                                           aria-label="@($"{context.FirstName} {context.LastName} çalışanını düzenle")"
                                           OnClick="@(() => EditEmployeeAsync(context.EmployeeId))" />
                        </MudTooltip>
                        <MudTooltip Text="Sil">
                            <MudIconButton Size="Size.Small"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Icon="@Icons.Material.Filled.Delete"
                                           aria-label="@($"{context.FirstName} {context.LastName} çalışanını sil")"
                                           OnClick="@(() => DeleteEmployeeAsync(context.EmployeeId))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Henüz kayıtlı çalışan bulunmuyor.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@ManagementPageSizeOptions"
                           RowsPerPageString="Sayfa başına kayıt:"
                           InfoFormat="{first_item}-{last_item} / {all_items}" />
        </PagerContent>
    </MudTable>
    }
</div>

@code
{
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private bool IsSearchDialogOpen { get; set; }
    private bool IsEmployeeDialogOpen { get; set; }
    private bool IsPageReady { get; set; }
    private static readonly DialogOptions EmployeeDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Medium, FullWidth = true
    };
    
    private EmployeeEntryForm Form { get; set; } = new();
    private EmployeeSearchForm SearchForm { get; set; } = new();
    private EmployeeSearchForm SearchDraft { get; set; } = new();
    
    private bool IsEditing { get; set; }
    private List<Employee> ExistingEmployees { get; set; } = [];
    private List<Department> ExistingDepartments { get; set; } = [];
    private List<ApplicationRole> ExistingRoles { get; set; } = [];
    private MudTable<Employee>? EmployeeTable { get; set; }
    private static readonly int[] ManagementPageSizeOptions = [10, 25, 50, 100];
    
    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private bool IsBootstrapMode => CurrentUser?.Identity?.IsAuthenticated != true;
    private bool CanSearchEmployees => IsBootstrapMode || PageAccessService.CanSearchEmployees(CurrentUser);
    private bool CanManageEmployees => IsBootstrapMode || PageAccessService.CanManageEmployees(CurrentUser);

    [Inject]
    public HumanResourcesDbContext Database { get; set; } = null!;

    [Inject]
    public IDialogService DialogService { get; set; } = null!;

    [Inject]
    public AuditLogService AuditLogService { get; set; } = null!;

    [Inject]
    public DepartmentManagerService DepartmentManagerService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;
        var canAccess = await PageAccessService.CanAccessEmployeesAsync(CurrentUser);

        if (!canAccess)
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }

        if (CurrentUser.Identity?.IsAuthenticated != true)
        {
            SetFeedback(Severity.Info, "İlk kurulum modu aktif. Henüz departman yoksa önce bir departman, ardından yetkili yönetici kullanıcı için ilk çalışanı oluşturun.");
        }

        Form = CreateEmployeeEntryForm();
        await LoadDataAsync();
        IsPageReady = true;
    }

    private Task<IEnumerable<string>> SearchFirstNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(employee => employee.FirstName), value, token);

    private Task<IEnumerable<string>> SearchLastNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(employee => employee.LastName), value, token);

    private Task<IEnumerable<string>> SearchEmailsAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(
            ExistingEmployees
                .Select(employee => employee.Email)
                .Where(email => !string.IsNullOrWhiteSpace(email))
                .Select(email => email!),
            value,
            token);

    private Task<IEnumerable<string>> SearchSicilNumbersAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(employee => employee.SicilNo), value, token);

    private Task<IEnumerable<string>> SearchIdentityNumbersAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(employee => employee.KktcKimlikNo), value, token);

    private Task<IEnumerable<string>> SearchDepartmentNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingDepartments.Select(department => department.DepartmentName), value, token);

    private Task<IEnumerable<string>> SearchManagerNamesAsync(string value, CancellationToken token) =>
        ManagementFilterOptionSearch.SearchAsync(ExistingEmployees.Select(FormatEmployeeName), value, token);

    private async Task OnValidSubmit(EditContext context)
    {
        if (!EnsureCanManageEmployees())
        {
            return;
        }

        try
        {
            var selectedRoleId = IsBootstrapMode
                ? ApplicationRoleDefaults.AdministratorRoleId
                : Form.ApplicationRoleId;
            if (!await Database.ApplicationRoles
                    .AsNoTracking()
                    .AnyAsync(role => role.ApplicationRoleId == selectedRoleId))
            {
                SetFeedback(Severity.Error, "Seçilen rol bulunamadı.");
                return;
            }

            await using var transaction = await Database.Database.BeginTransactionAsync(
                IsBootstrapMode
                || (IsEditing && selectedRoleId == ApplicationRoleDefaults.EmployeeRoleId)
                    ? System.Data.IsolationLevel.Serializable
                    : System.Data.IsolationLevel.ReadCommitted);
            if (IsBootstrapMode && await Database.Employees.AnyAsync())
            {
                throw new InvalidOperationException(
                    "İlk kurulum çalışanı yalnızca çalışan tablosu boşken oluşturulabilir.");
            }

            if (IsEditing && Form.EmployeeId is not null)
            {
                var employee = await Database.Employees
                    .FirstOrDefaultAsync(e => e.EmployeeId == Form.EmployeeId.Value);

                if (employee is null)
                {
                    SetFeedback(Severity.Error, "Çalışan bulunamadı.");
                    return;
                }
                await DepartmentManagerService.EnsureEmployeeCanBeUpdatedAsync(
                    employee,
                    Form.DepartmentId,
                    Form.Status,
                    selectedRoleId);
                var previousApplicationRoleId = employee.ApplicationRoleId;
                employee.FirstName = Form.FirstName.Trim();
                employee.LastName = Form.LastName.Trim();
                employee.Email = NormalizeEmail(Form.Email);
                employee.KktcKimlikNo = Form.KktcKimlikNo.Trim();
                employee.SicilNo = Form.SicilNo.Trim();
                employee.DepartmentId = Form.DepartmentId;
                employee.ApplicationRoleId = selectedRoleId;
                employee.StartDate = Form.StartDate;
                employee.StaffDate = Form.StaffDate;
                employee.Gender = Form.Gender;
                employee.BloodGroup = Form.BloodGroup;
                employee.Status = Form.Status;
                await DepartmentManagerService.AssignEmployeeManagerAsync(employee);

                await AuditLogService.AppendAsync(
                    AuditActionType.EmployeeUpdated,
                    nameof(Employee),
                    employee.EmployeeId.ToString(),
                    ActorId(),
                    $"Name={employee.FirstName} {employee.LastName}; ApplicationRoleId={previousApplicationRoleId}->{employee.ApplicationRoleId}");
                await Database.SaveChangesAsync();
                SetFeedback(Severity.Success, $"{employee.FirstName} {employee.LastName} adlı çalışan (ID: {employee.EmployeeId}) başarıyla güncellendi.");
            }
            else
            {
                var employee = new Employee
                {
                    FirstName = Form.FirstName.Trim(),
                    LastName = Form.LastName.Trim(),
                    Email = NormalizeEmail(Form.Email),
                    KktcKimlikNo = Form.KktcKimlikNo.Trim(),
                    SicilNo = Form.SicilNo.Trim(),
                    DepartmentId = Form.DepartmentId,
                    ApplicationRoleId = selectedRoleId,
                    StartDate = Form.StartDate,
                    StaffDate = Form.StaffDate,
                    Gender = Form.Gender,
                    BloodGroup = Form.BloodGroup,
                    Status = Form.Status
                };

                Database.Employees.Add(employee);
                await DepartmentManagerService.AssignEmployeeManagerAsync(employee);
                await Database.SaveChangesAsync();
                if (IsBootstrapMode)
                {
                    await AuditLogService.AppendSystemAsync(
                        AuditActionType.EmployeeCreated,
                        nameof(Employee),
                        employee.EmployeeId.ToString(),
                        SystemActorKeys.InitialConfiguration,
                        $"Name={employee.FirstName} {employee.LastName}; ApplicationRoleId={employee.ApplicationRoleId}; InitialConfiguration=true");
                }
                else
                {
                    await AuditLogService.AppendAsync(
                        AuditActionType.EmployeeCreated,
                        nameof(Employee),
                        employee.EmployeeId.ToString(),
                        ActorId(),
                        $"Name={employee.FirstName} {employee.LastName}; ApplicationRoleId={employee.ApplicationRoleId}");
                }
                await Database.SaveChangesAsync();
                SetFeedback(Severity.Success, $"{employee.FirstName} {employee.LastName} adlı çalışan (ID: {employee.EmployeeId}) başarıyla kaydedildi.");
            }

            await transaction.CommitAsync();
            if (IsBootstrapMode)
            {
                NavigationManager.NavigateTo("/login", replace: true);
                return;
            }

            Form = CreateEmployeeEntryForm();
            IsEditing = false;
            IsEmployeeDialogOpen = false;
            await LoadDataAsync();
            await ReloadEmployeeTableAsync();
        }
        catch (InvalidOperationException ex)
        {
            Database.ChangeTracker.Clear();
            SetFeedback(Severity.Error, ex.Message);
        }
        catch (DbUpdateException ex)
        {
            Database.ChangeTracker.Clear();
            if (ex.InnerException is Microsoft.Data.SqlClient.SqlException sqlEx && (sqlEx.Number == 2601 || sqlEx.Number == 2627))
            {
                SetFeedback(Severity.Error, "Bu kimlik numarası, sicil numarası veya e-posta ile kayıtlı bir çalışan zaten mevcut.");
            }
            else
            {
                SetFeedback(Severity.Error, "Çalışan kaydedilirken beklenmeyen bir veritabanı hatası oluştu.");
            }
        }
    }

    private void OnInvalidSubmit(EditContext context)
    {
        SetFeedback(Severity.Error, "Lütfen doğrulama hatalarını düzeltip yeniden gönderin.");
    }

    private void OpenEmployeeDialog()
    {
        if (!EnsureCanManageEmployees())
        {
            return;
        }

        Form = CreateEmployeeEntryForm();
        IsEditing = false;
        FeedbackMessage = null;
        IsEmployeeDialogOpen = true;
    }

    private void CloseEmployeeDialog()
    {
        Form = CreateEmployeeEntryForm();
        IsEditing = false;
        FeedbackMessage = null;
        IsEmployeeDialogOpen = false;
    }

    private async Task EditEmployeeAsync(int employeeId)
    {
        if (!EnsureCanManageEmployees())
        {
            return;
        }

        var employee = await Database.Employees
            .AsNoTracking()
            .FirstOrDefaultAsync(e => e.EmployeeId == employeeId);

        if (employee is null)
        {
            SetFeedback(Severity.Error, "Çalışan bulunamadı.");
            return;
        }

        Form = new EmployeeEntryForm
        {
            EmployeeId = employee.EmployeeId,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            Email = employee.Email,
            KktcKimlikNo = employee.KktcKimlikNo,
            SicilNo = employee.SicilNo,
            DepartmentId = employee.DepartmentId,
            ApplicationRoleId = employee.ApplicationRoleId,
            StartDate = employee.StartDate,
            StaffDate = employee.StaffDate,
            Gender = employee.Gender,
            BloodGroup = employee.BloodGroup,
            Status = employee.Status
        };

        IsEditing = true;
        FeedbackMessage = null;
        IsEmployeeDialogOpen = true;
    }

    private async Task DeleteEmployeeAsync(int employeeId)
    {
        if (!EnsureCanManageEmployees())
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Silmeyi Onayla",
            "Bu çalışanı silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            yesText: "Sil", cancelText: "İptal");
        if (confirmed != true) return;

        try
        {
            var employee = await Database.Employees
                .FirstOrDefaultAsync(e => e.EmployeeId == employeeId);

            if (employee is null) { SetFeedback(Severity.Error, "Çalışan bulunamadı."); return; }

            var hasRequests = await Database.LeaveRequests.AnyAsync(r => r.EmployeeId == employeeId);
            if (hasRequests) { SetFeedback(Severity.Error, $"{employee.FirstName} {employee.LastName} silinemiyor; izin talepleri bulunuyor. Önce onları silin."); return; }

            var hasBalances = await Database.LeaveBalances.AnyAsync(b => b.EmployeeId == employeeId);
            if (hasBalances) { SetFeedback(Severity.Error, $"{employee.FirstName} {employee.LastName} silinemiyor; izin bakiyeleri bulunuyor. Önce onları silin."); return; }

            var hasApprovals = await Database.LeaveApprovals.AnyAsync(a => a.ApproverEmployeeId == employeeId);
            if (hasApprovals) { SetFeedback(Severity.Error, $"{employee.FirstName} {employee.LastName} silinemiyor; izin onaylarıyla ilişkilendirilmiş durumda. Önce bu bağlantıları kaldırın."); return; }

            var hasPersonalFiles = await Database.EmployeeProfilePhotos
                .AnyAsync(photo => photo.EmployeeId == employeeId)
                || await Database.EmployeeDocuments
                    .AnyAsync(document => document.EmployeeId == employeeId);
            if (hasPersonalFiles)
            {
                SetFeedback(
                    Severity.Error,
                    $"{employee.FirstName} {employee.LastName} silinemiyor; profil fotoğrafı veya kişisel belgeleri bulunuyor.");
                return;
            }

            var hasPersonnelInformation =
                await Database.EmployeeBankAccounts.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeeIdentityDocuments.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeePhones.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeeAddresses.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeeEducations.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeeCourseCertificates.AnyAsync(item => item.EmployeeId == employeeId)
                || await Database.EmployeeTerminations.AnyAsync(item => item.EmployeeId == employeeId);
            if (hasPersonnelInformation)
            {
                SetFeedback(
                    Severity.Error,
                    $"{employee.FirstName} {employee.LastName} silinemiyor; ilişkili personel bilgileri bulunuyor.");
                return;
            }

            Database.Employees.Remove(employee);
            await AuditLogService.AppendAsync(AuditActionType.EmployeeDeleted, nameof(Employee), employeeId.ToString(), ActorId(), $"Name={employee.FirstName} {employee.LastName}");

            await Database.SaveChangesAsync();
            if (Form.EmployeeId == employeeId)
            {
        Form = CreateEmployeeEntryForm();
                IsEditing = false;
                IsEmployeeDialogOpen = false;
            }

            SetFeedback(Severity.Success, $"{employee.FirstName} {employee.LastName} adlı çalışan başarıyla silindi.");
            await LoadDataAsync();
            await ReloadEmployeeTableAsync();
        }
        catch (DbUpdateException)
        {
            SetFeedback(Severity.Error, "Bu çalışan silinemiyor; başka kayıtlar tarafından hâlâ kullanılıyor.");
        }
    }

