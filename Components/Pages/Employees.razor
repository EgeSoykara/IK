            case nameof(EmployeeSearchForm.LastName): SearchForm.LastName = null; break;
            case nameof(EmployeeSearchForm.Email): SearchForm.Email = null; break;
            case nameof(EmployeeSearchForm.KktcKimlikNo): SearchForm.KktcKimlikNo = null; break;
            case nameof(EmployeeSearchForm.SicilNo): SearchForm.SicilNo = null; break;
            case nameof(EmployeeSearchForm.DepartmentName): SearchForm.DepartmentName = null; break;
            case nameof(EmployeeSearchForm.ManagerName): SearchForm.ManagerName = null; break;
            case nameof(EmployeeSearchForm.ApplicationRoleId): SearchForm.ApplicationRoleId = null; break;
            case nameof(EmployeeSearchForm.StartDate): SearchForm.StartDate = null; break;
            case nameof(EmployeeSearchForm.StaffDate): SearchForm.StaffDate = null; break;
            case nameof(EmployeeSearchForm.Gender): SearchForm.Gender = null; break;
