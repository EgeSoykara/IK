    private async Task LoadDataAsync()
    {
        ExistingDepartments = await Database.Departments
            .AsNoTracking()
            .OrderBy(d => d.DepartmentName)
            .ToListAsync();

        ExistingRoles = await Database.ApplicationRoles
            .AsNoTracking()
            .OrderBy(role => role.Name)
            .ToListAsync();

        ExistingEmployees = await Database.Employees
            .AsNoTracking()
            .OrderBy(e => e.FirstName)
            .ToListAsync();
    }

    private async Task<TableData<Employee>> LoadEmployeesAsync(TableState state, CancellationToken cancellationToken)
    {
        var query = ApplyEmployeeSearch(Database.Employees
            .AsNoTracking()
            .Include(employee => employee.Department)
            .Include(employee => employee.Manager)
            .Include(employee => employee.ApplicationRole)
            .AsQueryable());

        return await query
            .OrderByDescending(employee => employee.EmployeeId)
            .ToTableDataAsync(state.Page, state.PageSize, cancellationToken);
    }

    private IQueryable<Employee> ApplyEmployeeSearch(IQueryable<Employee> query)
    {
        if (SearchForm.EmployeeId.HasValue)
            query = query.Where(e => e.EmployeeId == SearchForm.EmployeeId.Value);

        if (!string.IsNullOrWhiteSpace(SearchForm.FirstName))
            query = query.Where(e => e.FirstName.Contains(SearchForm.FirstName));

        if (!string.IsNullOrWhiteSpace(SearchForm.LastName))
            query = query.Where(e => e.LastName.Contains(SearchForm.LastName));

        if (!string.IsNullOrWhiteSpace(SearchForm.Email))
            query = query.Where(e => e.Email != null && e.Email.Contains(SearchForm.Email));

        if (!string.IsNullOrWhiteSpace(SearchForm.KktcKimlikNo))
            query = query.Where(e => e.KktcKimlikNo.Contains(SearchForm.KktcKimlikNo));

        if (!string.IsNullOrWhiteSpace(SearchForm.SicilNo))
            query = query.Where(e => e.SicilNo.Contains(SearchForm.SicilNo));

        if (!string.IsNullOrWhiteSpace(SearchForm.DepartmentName))
            query = query.Where(e => e.Department.DepartmentName.Contains(SearchForm.DepartmentName));

        if (!string.IsNullOrWhiteSpace(SearchForm.ManagerName))
            query = query.Where(e => e.Manager != null &&
                (e.Manager.FirstName.Contains(SearchForm.ManagerName) ||
                 e.Manager.LastName.Contains(SearchForm.ManagerName) ||
                 (e.Manager.FirstName + " " + e.Manager.LastName).Contains(SearchForm.ManagerName)));

        if (SearchForm.ApplicationRoleId.HasValue)
            query = query.Where(e => e.ApplicationRoleId == SearchForm.ApplicationRoleId.Value);

        if (SearchForm.Status.HasValue)
            query = query.Where(e => e.Status == SearchForm.Status.Value);

        if (SearchForm.Gender.HasValue)
            query = query.Where(e => e.Gender == SearchForm.Gender.Value);

        if (SearchForm.BloodGroup.HasValue)
            query = query.Where(e => e.BloodGroup == SearchForm.BloodGroup.Value);

        if (SearchForm.StartDate.HasValue)
            query = query.Where(e => e.StartDate >= SearchForm.StartDate.Value);

        if (SearchForm.StaffDate.HasValue)
            query = query.Where(e => e.StaffDate >= SearchForm.StaffDate.Value);

        return query;
    }

    private Task ReloadEmployeeTableAsync(bool resetPage = false)
    {
        if (EmployeeTable is null)
        {
            return Task.CompletedTask;
        }

        if (resetPage && EmployeeTable.CurrentPage != 0)
        {
            EmployeeTable.NavigateTo(0);
            return Task.CompletedTask;
        }

        return EmployeeTable.ReloadServerData();
    }

    private async Task OnEmployeesImportedAsync()
    {
        await LoadDataAsync();
        await ReloadEmployeeTableAsync(resetPage: true);
    }

    private void SetFeedback(Severity severity, string message)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = message;
    }

    private bool EnsureCanSearchEmployees()
    {
        if (CanSearchEmployees)
        {
            return true;
        }

        SetFeedback(Severity.Error, "Çalışan arama yetkiniz bulunmuyor.");
        return false;
    }

    private bool EnsureCanManageEmployees()
    {
        if (CanManageEmployees)
        {
            return true;
        }

        SetFeedback(Severity.Error, "Çalışan kaydı oluşturma veya güncelleme yetkiniz bulunmuyor.");
        return false;
    }

    private static string FormatStartDate(DateTime? startDate)
    {
        return startDate?.ToString("yyyy-MM-dd") ?? "-";
    }

    private static string FormatDepartmentName(Department? department)
    {
        return department?.DepartmentName ?? "-";
    }

    private static string FormatEmployeeName(Employee? employee)
    {
        return employee is null ? "-" : $"{employee.FirstName} {employee.LastName}";
    }

    private static string FormatEmploymentStatus(EmploymentStatus status)
    {
        return status switch
        {
            EmploymentStatus.Active => "Aktif",
            EmploymentStatus.Passive => "Pasif",
            _ => status.ToString()
        };
    }

    private string FormatRoleName(int applicationRoleId)
    {
        return ExistingRoles.FirstOrDefault(role => role.ApplicationRoleId == applicationRoleId)?.Name
            ?? applicationRoleId.ToString();
    }

    private static string? NormalizeEmail(string? email)
    {
        return string.IsNullOrWhiteSpace(email) ? null : email.Trim();
    }

    private static string FormatGender(EmployeeGender? gender)
    {
        return gender switch
        {
            EmployeeGender.Female => "Kadın",
            EmployeeGender.Male => "Erkek",
            null => "-",
            _ => gender.ToString()!
        };
    }

    private static string FormatBloodGroup(BloodGroup? bloodGroup)
    {
        return bloodGroup switch
        {
            BloodGroup.APositive => "A Rh+",
            BloodGroup.ANegative => "A Rh-",
            BloodGroup.BPositive => "B Rh+",
            BloodGroup.BNegative => "B Rh-",
            BloodGroup.ABPositive => "AB Rh+",
            BloodGroup.ABNegative => "AB Rh-",
            BloodGroup.OPositive => "0 Rh+",
            BloodGroup.ONegative => "0 Rh-",
            null => "-",
            _ => bloodGroup.ToString()!
        };
    }

