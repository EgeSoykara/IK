@using IK.Web.Services
@attribute [Authorize(Policy = AuthenticationPolicyNames.PasswordChangeRequired)]
@layout IK.Web.Components.Layout.LoginLayout
@page "/change-password"

@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav

<PageTitle>Şifre Belirle</PageTitle>

<MudPaper Class="login-card p-6 pa-5" Elevation="12" Square="false">
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @Error
        </MudAlert>
    }

    <form method="post" action="/auth/change-password" novalidate>
        <AntiforgeryToken />
        <MudStack Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h5" Align="Align.Center">Yeni Şifrenizi Belirleyin</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Geçici şifreniz yalnızca ilk giriş içindir. Devam etmek için en az
                @EmployeeCredentialService.MinimumPasswordLength karakterli yeni bir şifre belirleyin.
            </MudText>
            <MudTextField T="string"
                          @bind-Value="NewPassword"
                          Label="Yeni Şifre"
                          name="NewPassword"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password" />
            <MudTextField T="string"
                          @bind-Value="ConfirmPassword"
                          Label="Yeni Şifre Tekrar"
                          name="ConfirmPassword"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password" />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       ButtonType="ButtonType.Submit"
                       FullWidth="true">
                ŞİFREYİ KAYDET
            </MudButton>
            <div class="text-center">
                <MudLink Href="/logout">Oturumu kapat</MudLink>
            </div>
        </MudStack>
    </form>
</MudPaper>

@code {
    private string NewPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private string? Error { get; set; }

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("error", out var error))
        {
            return;
        }

        Error = error.ToString() switch
        {
            "missing" => "Lütfen yeni şifrenizi iki alana da girin.",
            "mismatch" => "Yeni şifreler eşleşmiyor.",
            "invalid" => $"Yeni şifre {EmployeeCredentialService.MinimumPasswordLength}-"
                         + $"{EmployeeCredentialService.MaximumPasswordLength} karakter arasında olmalı "
                         + "ve KKTC kimlik numaranızla aynı olmamalıdır.",
            _ => "Şifre değiştirilemedi. Lütfen yeniden deneyin."
        };
    }
}
