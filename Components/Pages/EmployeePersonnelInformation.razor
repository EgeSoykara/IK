@page "/EmployeePersonnelInformation"
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject HumanResourcesDbContext Database
@inject PageAccessService PageAccessService
@inject EmployeeFileService EmployeeFileService
@inject NavigationManager NavigationManager
@inject AuditLogService AuditLogService
@inject ILogger<EmployeePersonnelInformation> Logger

<div class="management-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Personel Bilgileri</MudText>
            <h1>Personel Bilgileri</h1>
            <p>Sicil, kişisel ve organizasyon bilgilerini görüntüleyin; ad, soyad, kimlik, profil fotoğrafı, cinsiyet ve kan grubu bilgilerini yönetin.</p>
        </div>
        @if (CanSelectEmployees)
        {
            <MudButton Href="/Employees"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Groups">
                Çalışanları Yönet
            </MudButton>
        }
    </section>

    <PersonnelInformationTabs ActivePath="/EmployeePersonnelInformation"
                              EmployeeId="SelectedEmployeeId"
                              ShowTermination="CanSelectEmployees" />

    @if (FeedbackMessage is not null && !IsEditDialogOpen)
    {
        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }

    <MudDialog @bind-Visible="IsEditDialogOpen" Options="EditDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Kişisel Bilgileri Düzenle</MudText>
        </TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert>
            }

            <EditForm Model="@Form"
                      OnValidSubmit="SavePersonalDetailsAsync"
                      FormName="EmployeePersonalDetailsForm">
                <DataAnnotationsValidator />

                <MudTextField T="string"
                              @bind-Value="Form.FirstName"
                              Label="Ad"
                              Disabled="@IsSaving"
                              MaxLength="80" />

                <MudTextField T="string"
                              @bind-Value="Form.LastName"
                              Label="Soyad"
                              Disabled="@IsSaving"
                              MaxLength="80" />

                <MudTextField T="string"
                              @bind-Value="Form.KktcKimlikNo"
                              Label="KKTC Kimlik No"
                              Disabled="@IsSaving"
                              MaxLength="10"
                              HelperText="10 karakter olmalıdır." />

                <MudSelect T="EmployeeGender?"
                           @bind-Value="Form.Gender"
                           Label="Cinsiyet"
                           Disabled="@IsSaving"
                           Clearable="true">
                    @foreach (var gender in Enum.GetValues<EmployeeGender>())
                    {
                        <MudSelectItem T="EmployeeGender?" Value="@(gender)">@FormatGender(gender)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="BloodGroup?"
                           @bind-Value="Form.BloodGroup"
                           Label="Kan Grubu"
                           Disabled="@IsSaving"
                           Clearable="true">
                    @foreach (var bloodGroup in Enum.GetValues<BloodGroup>())
                    {
                        <MudSelectItem T="BloodGroup?" Value="@(bloodGroup)">@FormatBloodGroup(bloodGroup)</MudSelectItem>
                    }
                </MudSelect>

                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Disabled="@IsSaving"
                               OnClick="CloseEditDialog">
                        İptal
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@IsSaving">
                        @(IsSaving ? "Kaydediliyor…" : "Kaydet")
                    </MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    @if (IsReady)
    {
        <section class="personnel-context" aria-label="Seçili çalışan">
            @if (CanSelectEmployees)
            {
                <MudSelect T="int?"
                           Value="SelectedEmployeeId"
                           ValueChanged="SelectEmployeeAsync"
                           Label="Çalışan"
                           Clearable="false">
                    @foreach (var employee in Employees)
                    {
                        <MudSelectItem T="int?" Value="@employee.EmployeeId">@FormatEmployee(employee)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">Kendi bilgileriniz</MudText>
                <MudText>@SelectedEmployeeDisplay</MudText>
            }
        </section>

        @if (SelectedEmployee is not null)
        {
            <section class="dashboard-card">
                <div class="dashboard-card-header">
                    <MudText Typo="Typo.overline">Sicil Özeti</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="OpenEditDialog">
                        Kişisel Bilgileri Düzenle
                    </MudButton>
                </div>
                <dl class="dashboard-definition-grid">
                    <div><dt>Çalışan ID</dt><dd>@SelectedEmployee.EmployeeId</dd></div>
                    <div><dt>Sicil No</dt><dd>@SelectedEmployee.SicilNo</dd></div>
                    <div><dt>Ad</dt><dd>@SelectedEmployee.FirstName</dd></div>
                    <div><dt>Soyad</dt><dd>@SelectedEmployee.LastName</dd></div>
                    <div><dt>KKTC Kimlik No</dt><dd>@SelectedEmployee.KktcKimlikNo</dd></div>
                    <div><dt>Cinsiyet</dt><dd>@FormatGender(SelectedEmployee.Gender)</dd></div>
                    <div><dt>Kan Grubu</dt><dd>@FormatBloodGroup(SelectedEmployee.BloodGroup)</dd></div>
                    <div><dt>Kayıt Tarihi</dt><dd>@SelectedEmployee.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd></div>
                </dl>
            </section>

            <div class="dashboard-detail-grid">
                <section class="dashboard-card dashboard-profile-card">
                    <div class="dashboard-card-header">
                        <MudText Typo="Typo.overline">Profil Fotoğrafı</MudText>
                        <span>En fazla 5 MB</span>
                    </div>
                    <div class="dashboard-profile-preview">
                        @if (SelectedEmployee.ProfilePhoto is not null)
                        {
                            <img src="@ProfilePhotoUrl"
                                 alt="@SelectedEmployee.FirstName @SelectedEmployee.LastName profil fotoğrafı" />
                        }
                        else
                        {
                            <span aria-hidden="true">@ProfileInitials</span>
                        }
                    </div>
                    <div class="dashboard-upload-copy">
                        <strong>@(SelectedEmployee.ProfilePhoto is null ? "Fotoğraf ekleyin" : "Fotoğrafı değiştirin")</strong>
                        <p>JPG, PNG veya WEBP dosyası seçin. Yeni yükleme mevcut fotoğrafın yerini alır.</p>
                    </div>
                    <InputFile OnChange="UploadProfilePhotoAsync"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               disabled="@IsProfilePhotoUploading"
                               class="dashboard-file-input"
                               aria-label="Profil fotoğrafı seç" />
                    @if (IsProfilePhotoUploading)
                    {
                        <MudProgressLinear Indeterminate="true"
                                           Color="Color.Primary"
                                           Class="dashboard-upload-progress" />
                    }
                </section>

                <section class="dashboard-card">
                    <div class="dashboard-card-header">
                        <MudText Typo="Typo.overline">Organizasyon Bilgileri</MudText>
                    </div>
                    <dl class="dashboard-definition-grid">
                        <div><dt>Departman</dt><dd>@SelectedEmployee.Department.DepartmentName</dd></div>
                        <div><dt>Yönetici</dt><dd>@ManagerDisplayName</dd></div>
                        <div><dt>İşe Başlama Tarihi</dt><dd>@FormatDate(SelectedEmployee.StartDate)</dd></div>
                        <div><dt>Çalışma Durumu</dt><dd>@FormatStatus(SelectedEmployee.Status)</dd></div>
                    </dl>
                </section>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "employeeId")]
    public int? RequestedEmployeeId { get; set; }

    private ClaimsPrincipal CurrentUser { get; set; } = new();
    private List<Employee> Employees { get; set; } = [];
    private Employee? SelectedEmployee { get; set; }
    private int? SelectedEmployeeId { get; set; }
    private bool CanSelectEmployees { get; set; }
    private bool IsReady { get; set; }
    private bool IsEditDialogOpen { get; set; }
    private bool IsSaving { get; set; }
    private bool IsProfilePhotoUploading { get; set; }
    private PersonalDetailsForm Form { get; set; } = new();
    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private static readonly DialogOptions EditDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private string SelectedEmployeeDisplay => SelectedEmployee is null
        ? "Çalışan kaydı bulunamadı."
        : FormatEmployee(SelectedEmployee);
    private string ManagerDisplayName => SelectedEmployee?.Manager is null
        ? "Atanmadı"
        : $"{SelectedEmployee.Manager.FirstName} {SelectedEmployee.Manager.LastName}";
    private string ProfileInitials => SelectedEmployee is null
        ? string.Empty
        : $"{SelectedEmployee.FirstName.FirstOrDefault()}{SelectedEmployee.LastName.FirstOrDefault()}".ToUpperInvariant();
    private string? ProfilePhotoUrl => SelectedEmployee?.ProfilePhoto is null
        ? null
        : $"/employee-files/profile-photo/{SelectedEmployee.EmployeeId}?v={SelectedEmployee.ProfilePhoto.UploadedAt.ToUnixTimeMilliseconds()}";

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;
        if (!PageAccessService.CanAccessPersonnelInformation(CurrentUser))
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }

        CanSelectEmployees = PageAccessService.CanManageEmployees(CurrentUser);
        var currentEmployeeId = CurrentUser.GetEmployeeId();
        Employees = await Database.Employees
            .AsNoTracking()
            .Where(employee => CanSelectEmployees || employee.EmployeeId == currentEmployeeId)
            .OrderBy(employee => employee.FirstName)
            .ThenBy(employee => employee.LastName)
            .ToListAsync();

        SelectedEmployeeId = RequestedEmployeeId.HasValue
            && PageAccessService.CanEditPersonnelInformation(CurrentUser, RequestedEmployeeId.Value)
            && Employees.Any(employee => employee.EmployeeId == RequestedEmployeeId.Value)
                ? RequestedEmployeeId
                : currentEmployeeId.HasValue
                    && Employees.Any(employee => employee.EmployeeId == currentEmployeeId.Value)
                        ? currentEmployeeId
                        : Employees.FirstOrDefault()?.EmployeeId;
        await LoadAsync();
        IsReady = true;
    }

    private async Task SelectEmployeeAsync(int? employeeId)
    {
        if (!employeeId.HasValue
            || !PageAccessService.CanEditPersonnelInformation(CurrentUser, employeeId.Value))
        {
            return;
        }

        SelectedEmployeeId = employeeId;
        IsEditDialogOpen = false;
        FeedbackMessage = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        SelectedEmployee = SelectedEmployeeId.HasValue
            && PageAccessService.CanEditPersonnelInformation(CurrentUser, SelectedEmployeeId.Value)
                ? await Database.Employees
                    .AsNoTracking()
                    .Include(employee => employee.Department)
                    .Include(employee => employee.Manager)
                    .Include(employee => employee.ProfilePhoto)
                    .SingleOrDefaultAsync(employee => employee.EmployeeId == SelectedEmployeeId.Value)
                : null;
    }

    private async Task UploadProfilePhotoAsync(InputFileChangeEventArgs eventArgs)
    {
        if (!SelectedEmployeeId.HasValue
            || !PageAccessService.CanEditPersonnelInformation(CurrentUser, SelectedEmployeeId.Value)
            || IsProfilePhotoUploading)
        {
            return;
        }

        IsProfilePhotoUploading = true;
        FeedbackMessage = null;
        try
        {
            var file = eventArgs.File;
            await using var content = file.OpenReadStream(EmployeeFileContentPolicy.MaxProfilePhotoBytes);
            await EmployeeFileService.UploadProfilePhotoAsync(
                CurrentUser,
                SelectedEmployeeId.Value,
                new EmployeeFileUpload(content, file.Name, file.Size));
            await LoadAsync();
            SetFeedback(Severity.Success, "Profil fotoğrafı güncellendi.");
        }
        catch (EmployeeFileValidationException exception)
        {
            SetFeedback(Severity.Warning, exception.Message);
        }
        catch (IOException)
        {
            SetFeedback(Severity.Warning, "Profil fotoğrafı en fazla 5 MB olabilir.");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Profil fotoğrafı yüklenemedi.");
            SetFeedback(Severity.Error, "Profil fotoğrafı yüklenemedi. Lütfen yeniden deneyin.");
        }
        finally
        {
            IsProfilePhotoUploading = false;
        }
    }

    private void OpenEditDialog()
    {
        if (!SelectedEmployeeId.HasValue
            || SelectedEmployee is null
            || !PageAccessService.CanEditPersonnelInformation(CurrentUser, SelectedEmployeeId.Value))
        {
            SetFeedback(Severity.Error, "Bu çalışanın kişisel bilgilerini değiştirme yetkiniz yok.");
            return;
        }

        Form = new PersonalDetailsForm
        {
            FirstName = SelectedEmployee.FirstName,
            LastName = SelectedEmployee.LastName,
            KktcKimlikNo = SelectedEmployee.KktcKimlikNo,
            Gender = SelectedEmployee.Gender,
            BloodGroup = SelectedEmployee.BloodGroup,
            RowVersion = SelectedEmployee.RowVersion.ToArray()
        };
        FeedbackMessage = null;
        IsEditDialogOpen = true;
    }

    private void CloseEditDialog()
    {
        if (IsSaving)
        {
            return;
        }

        Form = new PersonalDetailsForm();
        FeedbackMessage = null;
        IsEditDialogOpen = false;
    }

    private async Task SavePersonalDetailsAsync()
    {
        if (IsSaving)
        {
            return;
        }

        if (!SelectedEmployeeId.HasValue
            || !PageAccessService.CanEditPersonnelInformation(CurrentUser, SelectedEmployeeId.Value))
        {
            SetFeedback(Severity.Error, "Bu çalışanın kişisel bilgilerini değiştirme yetkiniz yok.");
            return;
        }

        if ((Form.Gender.HasValue && !Enum.IsDefined(Form.Gender.Value))
            || (Form.BloodGroup.HasValue && !Enum.IsDefined(Form.BloodGroup.Value)))
        {
            SetFeedback(Severity.Error, "Lütfen geçerli bir cinsiyet ve kan grubu seçin.");
            return;
        }

        IsSaving = true;
        try
        {
            var employee = await Database.Employees
                .SingleOrDefaultAsync(item => item.EmployeeId == SelectedEmployeeId.Value);
            if (employee is null)
            {
                SetFeedback(Severity.Error, "Çalışan kaydı bulunamadı.");
                return;
            }

            if (!employee.RowVersion.SequenceEqual(Form.RowVersion))
            {
                Database.ChangeTracker.Clear();
                await ReloadEditFormAsync();
                SetFeedback(
                    Severity.Warning,
                    "Bu bilgiler başka bir işlem tarafından güncellendi. Güncel değerler forma yüklendi; lütfen tekrar kontrol edin.");
                return;
            }

            var firstName = Form.FirstName.Trim();
            var lastName = Form.LastName.Trim();
            var kktcKimlikNo = Form.KktcKimlikNo.Trim();
            var identityNumberTaken = await Database.Employees
                .AsNoTracking()
                .AnyAsync(item =>
                    item.EmployeeId != employee.EmployeeId
                    && item.KktcKimlikNo == kktcKimlikNo);
            if (identityNumberTaken)
            {
                SetFeedback(Severity.Error, "Bu KKTC kimlik numarası başka bir çalışan tarafından kullanılıyor.");
                return;
            }

            var changedFields = new List<string>(5);
            if (employee.FirstName != firstName)
            {
                employee.FirstName = firstName;
                changedFields.Add(nameof(Employee.FirstName));
            }

            if (employee.LastName != lastName)
            {
                employee.LastName = lastName;
                changedFields.Add(nameof(Employee.LastName));
            }

            if (employee.KktcKimlikNo != kktcKimlikNo)
            {
                employee.KktcKimlikNo = kktcKimlikNo;
                changedFields.Add(nameof(Employee.KktcKimlikNo));
            }

            if (employee.Gender != Form.Gender)
            {
                employee.Gender = Form.Gender;
                changedFields.Add(nameof(Employee.Gender));
            }

            if (employee.BloodGroup != Form.BloodGroup)
            {
                employee.BloodGroup = Form.BloodGroup;
                changedFields.Add(nameof(Employee.BloodGroup));
            }

            if (changedFields.Count == 0)
            {
                IsEditDialogOpen = false;
                Form = new PersonalDetailsForm();
                SetFeedback(Severity.Info, "Herhangi bir değişiklik yapılmadı.");
                return;
            }

            employee.UpdatedAt = DateTimeOffset.UtcNow;
            await AuditLogService.AppendAsync(
                AuditActionType.EmployeeUpdated,
                nameof(Employee),
                employee.EmployeeId.ToString(),
                ActorId(),
                $"Fields={string.Join(',', changedFields)}");
            await Database.SaveChangesAsync();

            IsEditDialogOpen = false;
            Form = new PersonalDetailsForm();
            await LoadAsync();
            SetFeedback(Severity.Success, "Kişisel bilgiler güncellendi.");
        }
        catch (DbUpdateConcurrencyException)
        {
            Database.ChangeTracker.Clear();
            await ReloadEditFormAsync();
            SetFeedback(
                Severity.Warning,
                "Bu bilgiler başka bir işlem tarafından güncellendi. Güncel değerler forma yüklendi; lütfen tekrar kontrol edin.");
        }
        catch (DbUpdateException exception)
        {
            Database.ChangeTracker.Clear();
            if (exception.InnerException is Microsoft.Data.SqlClient.SqlException { Number: 2601 or 2627 })
            {
                SetFeedback(Severity.Error, "Bu KKTC kimlik numarası başka bir çalışan tarafından kullanılıyor.");
            }
            else
            {
                SetFeedback(Severity.Error, "Kişisel bilgiler kaydedilirken beklenmeyen bir veritabanı hatası oluştu.");
            }
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ReloadEditFormAsync()
    {
        await LoadAsync();
        Form = SelectedEmployee is null
            ? new PersonalDetailsForm()
            : new PersonalDetailsForm
            {
                FirstName = SelectedEmployee.FirstName,
                LastName = SelectedEmployee.LastName,
                KktcKimlikNo = SelectedEmployee.KktcKimlikNo,
                Gender = SelectedEmployee.Gender,
                BloodGroup = SelectedEmployee.BloodGroup,
                RowVersion = SelectedEmployee.RowVersion.ToArray()
            };
    }

    private void SetFeedback(Severity severity, string message)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = message;
    }

    private static string FormatGender(EmployeeGender? gender) =>
        gender switch
        {
            EmployeeGender.Female => "Kadın",
            EmployeeGender.Male => "Erkek",
            null => "-",
            _ => gender.ToString()!
        };

    private static string FormatBloodGroup(BloodGroup? bloodGroup) =>
        bloodGroup switch
        {
            BloodGroup.APositive => "A Rh+",
            BloodGroup.ANegative => "A Rh-",
            BloodGroup.BPositive => "B Rh+",
            BloodGroup.BNegative => "B Rh-",
            BloodGroup.ABPositive => "AB Rh+",
            BloodGroup.ABNegative => "AB Rh-",
            BloodGroup.OPositive => "0 Rh+",
            BloodGroup.ONegative => "0 Rh-",
            null => "-",
            _ => bloodGroup.ToString()!
        };

    private static string FormatEmployee(Employee employee) =>
        $"{employee.FirstName} {employee.LastName} ({employee.SicilNo})";

    private static string FormatDate(DateTime? value) => value?.ToString("dd.MM.yyyy") ?? "-";

    private static string FormatStatus(EmploymentStatus status) =>
        status == EmploymentStatus.Active ? "Aktif" : "Pasif";

    private string ActorId() => CurrentUser.Identity?.Name ?? "System";

    private sealed class PersonalDetailsForm
    {
        [Required(ErrorMessage = "Ad zorunludur.")]
        [MaxLength(80, ErrorMessage = "Ad en fazla 80 karakter olabilir.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Soyad zorunludur.")]
        [MaxLength(80, ErrorMessage = "Soyad en fazla 80 karakter olabilir.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "KKTC kimlik numarası zorunludur.")]
        [StringLength(10, MinimumLength = 10, ErrorMessage = "KKTC kimlik numarası 10 karakter olmalıdır.")]
        public string KktcKimlikNo { get; set; } = string.Empty;

        public EmployeeGender? Gender { get; set; }
        public BloodGroup? BloodGroup { get; set; }
        public byte[] RowVersion { get; set; } = [];
    }
}
