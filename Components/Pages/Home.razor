@attribute [Authorize]
@page "/"
@using System.Security.Claims
@using IK.Web.Database
@using IK.Web.Models
@using Microsoft.EntityFrameworkCore
@using IK.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService

<PageTitle>İK Personel Sicil ve İzin Modülü</PageTitle>

@if (SelectedEmployee is not null)
{
    <div class="dashboard-shell">
        <section class="dashboard-hero">
            <div class="dashboard-hero-content">
                <div class="dashboard-hero-copy">
                    <div class="dashboard-hero-brand">
                        <span class="dashboard-hero-accent" aria-hidden="true"></span>
                        <MudText Typo="Typo.overline">KOOPBANK · İK Operasyon Kontrol Merkezi</MudText>
                    </div>
                    <h1>Hoş geldiniz, @SelectedEmployee.FirstName @SelectedEmployee.LastName</h1>
                    <p>
                        Personel, izin bakiyesi ve talep akışı tek ekranda toplandı. Günlük takibinizi hızlandıran özet metrikler ve aksiyon bağlantıları aşağıda hazır.
                    </p>
                    <div class="dashboard-chip-row">
                        <span class="dashboard-chip dashboard-chip-secondary">@SelectedEmployee.Department.DepartmentName</span>
                        <span class="@EmployeeStatusChipClass">@FormatEmploymentStatus(SelectedEmployee.Status)</span>
                    </div>
                </div>
                <div class="dashboard-hero-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="@CreateLeaveRequestUrl"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="dashboard-primary-action">
                        Yeni Talep Oluştur
                    </MudButton>
                    <div class="dashboard-hero-avatar">
                        @if (CanViewSelectedProfilePhoto && SelectedEmployee.ProfilePhoto is not null)
                        {
                            <img src="@ProfilePhotoUrl"
                                 alt="@SelectedEmployee.FirstName @SelectedEmployee.LastName profil fotoğrafı" />
                        }
                        else
                        {
                            <span aria-hidden="true">@ProfileInitials</span>
                        }
                    </div>
                </div>
            </div>
        </section>

        <div class="dashboard-stats-grid">
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />
                </div>
                <div class="dashboard-stat-content">
                    <span>Toplam Kalan Gün</span>
                    <strong>@FormatDayCount(TotalRemainingDays)</strong>
                    <p>@SelectedEmployeeLeaveBalances.Count aktif izin türü</p>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Timelapse" />
                </div>
                <div class="dashboard-stat-content">
                    <span>Kullanılan Gün</span>
                    <strong>@FormatDayCount(TotalUsedDays)</strong>
                    <p>Güncel izin bakiyeleri toplamı</p>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" />
                </div>
                <div class="dashboard-stat-content">
                    <span>Bekleyen Talepler</span>
                    <strong>@PendingRequestCount</strong>
                    <p>@PendingRequestCaption</p>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.TaskAlt" />
                </div>
                <div class="dashboard-stat-content">
                    <span>Tamamlanan Talepler</span>
                    <strong>@CompletedRequestCount</strong>
                    <p>@CompletedRequestCaption</p>
                </div>
            </div>
        </div>

        <div class="dashboard-detail-grid dashboard-overview-grid">
            <section class="dashboard-card dashboard-balance-card">
                <div class="dashboard-card-header">
                    <div>
                        <MudText Typo="Typo.overline">İzin Durumu</MudText>
                        <p>Güncel hak ediş ve kullanım özeti</p>
                    </div>
                </div>
                @if (SelectedEmployeeLeaveBalances.Count == 0)
                {
                    <div class="dashboard-empty-state">
                        <MudIcon Icon="@Icons.Material.Outlined.EventBusy" aria-hidden="true" />
                        <p>Henüz güncel izin bakiyesi bulunmuyor.</p>
                    </div>
                }
                else
                {
                    <div class="dashboard-balance-list">
                        @foreach (var balance in SelectedEmployeeLeaveBalances)
                        {
                            <article class="dashboard-balance-row">
                                <div class="dashboard-balance-row-heading">
                                    <div>
                                        <strong>@balance.LeaveType.Name</strong>
                                        <span>@balance.Year dönemi</span>
                                    </div>
                                    <div class="dashboard-balance-values">
                                        <span><strong>@FormatDayCount(balance.UsedDays)</strong> kullanılan</span>
                                        <span><strong>@FormatDayCount(balance.RemainingDays)</strong> kalan</span>
                                    </div>
                                </div>
                                <MudProgressLinear Value="@GetBalanceUsagePercentage(balance)"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Rounded="true"
                                                   aria-label="@($"{balance.LeaveType.Name} kullanım oranı")" />
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-card dashboard-employee-summary-card">
                <div class="dashboard-card-header">
                    <div>
                        <MudText Typo="Typo.overline">Çalışan Özeti</MudText>
                        <p>Günlük işlemler için temel bilgiler</p>
                    </div>
                </div>
                <dl class="dashboard-summary-list">
                    <div><dt>Sicil No</dt><dd>@SelectedEmployee.SicilNo</dd></div>
                    <div><dt>Departman</dt><dd>@SelectedEmployee.Department.DepartmentName</dd></div>
                    <div><dt>Yönetici</dt><dd>@ManagerDisplayName</dd></div>
                    <div><dt>İşe Başlama Tarihi</dt><dd>@FormatStartDate(SelectedEmployee.StartDate)</dd></div>
                    <div><dt>Durum</dt><dd><span class="@EmployeeStatusChipClass">@FormatEmploymentStatus(SelectedEmployee.Status)</span></dd></div>
                </dl>
            </section>
        </div>

        <section class="dashboard-card dashboard-requests-card">
            <div class="dashboard-card-header">
                <div>
                    <MudText Typo="Typo.overline">Bekleyen Talepler</MudText>
                    <p>Karar süreci devam eden en yakın talepler</p>
                </div>
                <span>@PendingRequestCount kayıt</span>
            </div>
            @if (SelectedEmployeePendingLeaveRequests.Count == 0)
            {
                <div class="dashboard-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" aria-hidden="true" />
                    <p>Bekleyen izin talebi bulunmuyor.</p>
                </div>
            }
            else
            {
                <div class="dashboard-request-list">
                    @foreach (var request in SelectedEmployeePendingLeaveRequests)
                    {
                        <article class="dashboard-request-row">
                            <div class="dashboard-request-icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Outlined.EventNote" />
                            </div>
                            <div class="dashboard-request-main">
                                <strong>@request.DisplayName()</strong>
                                <span>#@request.RequestId · @FormatDateRange(request.StartDate, request.EndDate)</span>
                            </div>
                            <div class="dashboard-request-days">
                                <strong>@FormatDayCount(request.RequestedDays)</strong>
                                <span>gün</span>
                            </div>
                            <span class="@GetRequestStatusClass(request.CurrentStatus)">
                                @FormatRequestStatus(request.CurrentStatus)
                            </span>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="dashboard-card dashboard-history-card">
            <div class="dashboard-history-copy">
                <div class="dashboard-history-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.History" />
                </div>
                <div>
                    <MudText Typo="Typo.overline">Talep Geçmişi</MudText>
                    <h2>@CompletedRequestCount tamamlanan talep</h2>
                    <p>@CompletedRequestCaption</p>
                </div>
            </div>
            <div class="dashboard-history-stats" aria-label="Tamamlanan talep dağılımı">
                <div><span>Onaylanan</span><strong>@ApprovedRequestCount</strong></div>
                <div><span>Reddedilen</span><strong>@RejectedRequestCount</strong></div>
            </div>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Href="@LeaveRequestHistoryUrl"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       Class="dashboard-history-action">
                Tüm Talepleri Görüntüle
            </MudButton>
        </section>
    </div>
}
else if (!string.IsNullOrWhiteSpace(FeedbackMessage))
{
    <MudAlert Severity="@FeedbackSeverity" Variant="Variant.Filled" Class="dashboard-feedback">
        @FeedbackMessage
    </MudAlert>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private Employee? SelectedEmployee { get; set; }
    private List<LeaveBalance> SelectedEmployeeLeaveBalances { get; set; } = [];
    private List<LeaveRequest> SelectedEmployeePendingLeaveRequests { get; set; } = [];
    private Severity FeedbackSeverity { get; set; } = Severity.Info;
    private string? FeedbackMessage { get; set; }
    private string ManagerDisplayName { get; set; } = "Atanmadı";
    private int PendingRequestCount { get; set; }
    private int CompletedRequestCount { get; set; }
    private int ApprovedRequestCount { get; set; }
    private int RejectedRequestCount { get; set; }
    private DateTimeOffset? LatestCompletedRequestDate { get; set; }
    private bool CanViewSelectedProfilePhoto => SelectedEmployee is not null
        && (CurrentUser.GetEmployeeId() == SelectedEmployee.EmployeeId
            || PageAccessService.CanManageEmployees(CurrentUser));
    private string ProfileInitials =>
        SelectedEmployee is null
            ? string.Empty
            : $"{SelectedEmployee.FirstName.FirstOrDefault()}{SelectedEmployee.LastName.FirstOrDefault()}".ToUpperInvariant();
    private string? ProfilePhotoUrl =>
        SelectedEmployee?.ProfilePhoto is null
            ? null
            : $"/employee-files/profile-photo/{SelectedEmployee.EmployeeId}?v={SelectedEmployee.ProfilePhoto.UploadedAt.ToUnixTimeMilliseconds()}";
    private decimal TotalRemainingDays => SelectedEmployeeLeaveBalances.Sum(balance => balance.RemainingDays);
    private decimal TotalUsedDays => SelectedEmployeeLeaveBalances.Sum(balance => balance.UsedDays);
    private LeaveRequest? NearestPendingRequest => SelectedEmployeePendingLeaveRequests
        .OrderBy(request => request.StartDate ?? DateTime.MaxValue)
        .ThenBy(request => request.RequestId)
        .FirstOrDefault();
    private string EmployeeStatusChipClass => SelectedEmployee?.Status == EmploymentStatus.Active
        ? "dashboard-chip dashboard-chip-success"
        : "dashboard-chip dashboard-chip-muted";
    private string PendingRequestCaption => NearestPendingRequest is null
        ? "Açık talep bulunmuyor"
        : $"{NearestPendingRequest.DisplayName()} için sonraki adım hazır";
    private string CompletedRequestCaption => LatestCompletedRequestDate is null
        ? "Henüz sonuçlanan talep bulunmuyor"
        : $"Son karar {LatestCompletedRequestDate.Value:dd.MM.yyyy} tarihinde verildi";
    private string LeaveRequestHistoryUrl => SelectedEmployee is null
        ? "/LeaveRequests"
        : LeaveRequestPageLink.ForEmployee(SelectedEmployee.EmployeeId);
    private string CreateLeaveRequestUrl => SelectedEmployee is null
        ? "/LeaveRequests?create=true"
        : LeaveRequestPageLink.ForEmployee(SelectedEmployee.EmployeeId, create: true);

    [Inject]
    public HumanResourcesDbContext Database { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "employeeId")]
    public int? RequestedEmployeeId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        CurrentUser = (await AuthTask).User;

        if (!PageAccessService.CanAccessDashboardEmployee(
            CurrentUser,
            RequestedEmployeeId))
        {
            NavigationManager.NavigateTo("/unauthorized", replace: true);
            return;
        }

        await LoadSelectedEmployeeAsync();
    }

    private async Task LoadSelectedEmployeeAsync()
    {
        var employeeId = RequestedEmployeeId ?? CurrentUser.GetEmployeeId();

        if (employeeId is null)
        {
            SelectedEmployee = null;
            SelectedEmployeeLeaveBalances = [];
            SelectedEmployeePendingLeaveRequests = [];
            ResetRequestSummary();
            ManagerDisplayName = "Atanmadı";
            SetFeedback(Severity.Warning, "Çalışan kimliği oturumdan veya sorgu parametresinden çözümlenemedi.");
            return;
        }

        SelectedEmployee = await Database.Employees
            .AsNoTracking()
            .Include(employee => employee.Department)
            .Include(employee => employee.Manager)
            .Include(employee => employee.ProfilePhoto)
            .SingleOrDefaultAsync(employee => employee.EmployeeId == employeeId.Value);

        SelectedEmployeeLeaveBalances = await DashboardPageQuery.LoadCurrentBalancesAsync(
            Database,
            employeeId.Value);
        SelectedEmployeePendingLeaveRequests = await DashboardPageQuery.LoadPendingRequestPreviewsAsync(
            Database,
            employeeId.Value);
        var requestSummary = await DashboardPageQuery.LoadRequestSummaryAsync(
            Database,
            employeeId.Value);

        PendingRequestCount = requestSummary.PendingCount;
        CompletedRequestCount = requestSummary.CompletedCount;
        ApprovedRequestCount = requestSummary.ApprovedCount;
        RejectedRequestCount = requestSummary.RejectedCount;
        LatestCompletedRequestDate = requestSummary.LatestCompletedRequestDate;

        if (SelectedEmployee is null)
        {
            SelectedEmployee = null;
            SelectedEmployeeLeaveBalances = [];
            SelectedEmployeePendingLeaveRequests = [];
            ResetRequestSummary();
            ManagerDisplayName = "Atanmadı";
            SetFeedback(Severity.Error, $"{employeeId.Value} kimlik numaralı çalışan bulunamadı.");
            return;
        }

        ManagerDisplayName = SelectedEmployee.Manager is null
            ? "Atanmadı"
            : $"{SelectedEmployee.Manager.FirstName} {SelectedEmployee.Manager.LastName} (ID: {SelectedEmployee.Manager.EmployeeId})";

        SetFeedback(
            Severity.Success,
            $"{SelectedEmployee.FirstName} {SelectedEmployee.LastName} adlı çalışan (ID: {SelectedEmployee.EmployeeId}) başarıyla yüklendi.");
    }

    private static string FormatStartDate(DateTime? startDate)
    {
        return startDate?.ToString("dd.MM.yyyy") ?? "-";
    }

    private static string FormatDateRange(DateTime? startDate, DateTime? endDate)
    {
        return startDate?.Date == endDate?.Date
            ? FormatStartDate(startDate)
            : $"{FormatStartDate(startDate)} – {FormatStartDate(endDate)}";
    }

    private static double GetBalanceUsagePercentage(LeaveBalance balance)
    {
        var totalDays = balance.UsedDays + balance.RemainingDays;
        return totalDays <= 0m
            ? 0d
            : Math.Clamp((double)(balance.UsedDays / totalDays * 100m), 0d, 100d);
    }

    private void ResetRequestSummary()
    {
        PendingRequestCount = 0;
        CompletedRequestCount = 0;
        ApprovedRequestCount = 0;
        RejectedRequestCount = 0;
        LatestCompletedRequestDate = null;
    }

    private static string FormatDayCount(decimal days)
    {
        return decimal.Truncate(days) == days
            ? days.ToString("0")
            : days.ToString("0.##");
    }

    private static string FormatRequestStatus(LeaveRequestStatus status)
    {
        return status switch
        {
            LeaveRequestStatus.ManagerReview => "Yönetici onayı bekleniyor",
            LeaveRequestStatus.HumanResourcesReview => "İK onayı bekleniyor",
            LeaveRequestStatus.Approved => "Onaylandı",
            LeaveRequestStatus.Rejected => "Reddedildi",
            _ => status.ToString()
        };
    }

    private static string GetRequestStatusClass(LeaveRequestStatus status)
    {
        return status switch
        {
            LeaveRequestStatus.Approved => "dashboard-status dashboard-status-approved",
            LeaveRequestStatus.Rejected => "dashboard-status dashboard-status-rejected",
            _ => "dashboard-status dashboard-status-pending"
        };
    }

    private static string FormatEmploymentStatus(EmploymentStatus status)
    {
        return status switch
        {
            EmploymentStatus.Active => "Aktif",
            EmploymentStatus.Passive => "Pasif",
            _ => status.ToString()
        };
    }

    private void SetFeedback(Severity severity, string message)
    {
        FeedbackSeverity = severity;
        FeedbackMessage = message;
    }

}
