@page "/EmployeeIdentityDocuments"
@using System.ComponentModel.DataAnnotations
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@using Microsoft.EntityFrameworkCore
@inject HumanResourcesDbContext Database
@inject PageAccessService PageAccessService
@inject PersonnelAuthorizationService PersonnelAuthorizationService
@inject PersonnelEmployeeLookupService PersonnelEmployeeLookupService
@inject AuditLogService AuditLogService
@inject EmployeeFileService EmployeeFileService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ILogger<EmployeeIdentityDocuments> Logger

<div class="management-shell">
    <section class="management-page-header">
        <div><MudText Typo="Typo.overline">Personel Bilgileri</MudText><h1>Kimlik ve Belgeler</h1><p>Kimlik, pasaport ve ilgili belge dosyalarını kayıt bazında yönetin.</p></div>
    </section>
    <PersonnelInformationTabs ActivePath="/EmployeeIdentityDocuments" EmployeeId="SelectedEmployeeId" />

    @if (FeedbackMessage is not null && !IsEntryDialogOpen && !IsDocumentDialogOpen)
    {
        <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }

    <MudDialog @bind-Visible="IsEntryDialogOpen" Options="DialogOptions">
        <TitleContent><MudText Typo="Typo.h6">@(Form.Id.HasValue ? "Kimlik/Belge Kaydını Düzenle" : "Kimlik/Belge Kaydı Ekle")</MudText></TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null) { <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert> }
            <EditForm Model="Form" OnValidSubmit="SaveAsync" FormName="EmployeeIdentityDocumentForm">
                <DataAnnotationsValidator /><ValidationSummary />
                <MudSelect T="string"
                           @bind-Value="Form.DocumentType"
                           Label="Belge Türü"
                           Required="true"
                           RequiredError="Belge türü zorunludur."
                           Disabled="@(!PersonnelSelectOptions.DocumentTypes.Any())"
                           HelperText="@DocumentTypeHelperText">
                    @foreach (var option in PersonnelSelectOptions.DocumentTypes)
                    {
                        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="Form.DocumentNumber" Label="Belge Numarası" Required="true" RequiredError="Belge numarası zorunludur." />
                <MudTextField T="string" @bind-Value="Form.IssuingAuthority" Label="Düzenleyen Kurum" Required="true" RequiredError="Düzenleyen kurum zorunludur." />
                <MudDatePicker @bind-Date="Form.IssueDate" Label="Düzenlenme Tarihi" Required="true" RequiredError="Düzenlenme tarihi zorunludur." />
                <MudDatePicker @bind-Date="Form.ExpiryDate" Label="Geçerlilik Sonu" />
                <MudTextField T="string" @bind-Value="Form.Description" Label="Açıklama" Lines="2" />
                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseEntryDialog">İptal</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!PersonnelSelectOptions.DocumentTypes.Any())">@(Form.Id.HasValue ? "Güncelle" : "Kaydet")</MudButton>
                </div>
            </EditForm>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsDocumentDialogOpen" Options="DialogOptions">
        <TitleContent><MudText Typo="Typo.h6">@SelectedIdentityLabel Dosyaları</MudText></TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null) { <MudAlert Severity="@FeedbackSeverity" Dense="true" Class="mb-4">@FeedbackMessage</MudAlert> }
            <RelatedDocumentFiles InputId="identity-document-file-input" Documents="SelectedRecordDocuments" IsUploading="IsDocumentUploading" OnFileSelected="UploadDocumentAsync" />
            <div class="d-flex justify-end mt-4"><MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseDocumentDialog">Kapat</MudButton></div>
        </DialogContent>
    </MudDialog>

    @if (IsReady)
    {
        <section class="personnel-context" aria-label="Seçili çalışan">
            @if (CanSelectEmployees)
            {
                <PersonnelEmployeeSelector CurrentUser="CurrentUser" SelectedEmployeeId="SelectedEmployeeId" SelectedEmployeeIdChanged="SelectEmployeeAsync" />
            }
            else { <MudText Typo="Typo.subtitle2">Kendi bilgileriniz</MudText><MudText>@SelectedEmployeeDisplay</MudText> }
        </section>

        @if (SelectedEmployeeId.HasValue)
        {
            <MudTable Items="Records" Dense="true" Hover="true" Class="management-data-table">
                <ToolBarContent><MudText Typo="Typo.subtitle2">Kimlik ve Belge Kayıtları</MudText><MudSpacer />@if (Access.CanEditSensitive) { <ManagementCreateButton Label="Kayıt Ekle" AriaLabel="Kimlik veya belge kaydı ekle" OnClick="OpenEntryDialog" /> }</ToolBarContent>
                <HeaderContent><MudTh>Tür</MudTh><MudTh>Numara</MudTh><MudTh>Kurum</MudTh><MudTh>Düzenlenme</MudTh><MudTh>Geçerlilik Sonu</MudTh><MudTh>Dosya</MudTh><MudTh>İşlemler</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tür">@context.DocumentType</MudTd><MudTd DataLabel="Numara">@Sensitive(context.DocumentNumber)</MudTd><MudTd DataLabel="Kurum">@Display(context.IssuingAuthority)</MudTd><MudTd DataLabel="Düzenlenme">@Date(context.IssueDate)</MudTd><MudTd DataLabel="Geçerlilik Sonu">@Date(context.ExpiryDate)</MudTd><MudTd DataLabel="Dosya">@DocumentCount(context.EmployeeIdentityDocumentId)</MudTd>
                    <MudTd DataLabel="İşlemler">
                        @if (Access.CanEditSensitive)
                        {
                            <div class="d-flex gap-2">
                                <MudTooltip Text="Düzenle"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" aria-label="Kimlik veya belge kaydını düzenle" OnClick="@(() => Edit(context))" /></MudTooltip>
                                <MudTooltip Text="Dosyalar"><MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" aria-label="Kimlik veya belge dosyalarını yönet" OnClick="@(() => OpenDocumentDialog(context))" /></MudTooltip>
                                <MudTooltip Text="Sil"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" aria-label="Kimlik veya belge kaydını sil" OnClick="@(() => DeleteAsync(context))" /></MudTooltip>
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>Bu çalışan için kimlik veya belge kaydı bulunmuyor.</MudText></NoRecordsContent>
            </MudTable>

            @if (UnlinkedDocuments.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Önceki sistemden kalan @UnlinkedDocuments.Count belge veri kaybı olmadan korunuyor. Tek bir ilgili kayıt güvenle belirlenemediği için bu dosyalar salt okunur gösterilir.
                    @foreach (var document in UnlinkedDocuments)
                    {
                        <a class="personnel-legacy-document-link" href="@($"/employee-files/documents/{document.EmployeeDocumentId}")">@document.OriginalFileName</a>
                    }
                </MudAlert>
            }
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "employeeId")] public int? RequestedEmployeeId { get; set; }
    private ClaimsPrincipal CurrentUser { get; set; } = new();
    private List<EmployeeIdentityDocument> Records { get; set; } = [];
    private List<EmployeeDocument> Documents { get; set; } = [];
    private int? SelectedEmployeeId { get; set; }
    private int? SelectedIdentityDocumentId { get; set; }
    private IdentityDocumentForm Form { get; set; } = new();
    private bool IsReady { get; set; }
    private PersonnelAccessDecision Access { get; set; } = PersonnelAccessDecision.Denied;
    private bool CanSelectEmployees { get; set; }
    private bool IsEntryDialogOpen { get; set; }
    private bool IsDocumentDialogOpen { get; set; }
    private string SelectedEmployeeDisplay { get; set; } = "Çalışan kaydı bulunamadı.";
    private bool IsDocumentUploading { get; set; }
    private string? FeedbackMessage { get; set; }
    private Severity FeedbackSeverity { get; set; }
    private static readonly DialogOptions DialogOptions = new() { BackdropClick = false, CloseOnEscapeKey = false, MaxWidth = MaxWidth.Medium, FullWidth = true };
    private string? DocumentTypeHelperText => PersonnelSelectOptions.DocumentTypes.Any()
        ? null
        : "Belge türü seçenekleri sistem yöneticisi tarafından henüz tanımlanmadı.";
    private IReadOnlyList<EmployeeDocument> SelectedRecordDocuments => SelectedIdentityDocumentId.HasValue ? Documents.Where(document => document.EmployeeIdentityDocumentId == SelectedIdentityDocumentId.Value).ToList() : [];
    private IReadOnlyList<EmployeeDocument> UnlinkedDocuments => Documents
        .Where(document => !document.IsLinkedToRecord
            && document.CategoryCanonicalKey != EmployeeDocumentCategories.Education)
        .ToList();
    private string SelectedIdentityLabel
    {
        get
        {
            var record = Records.SingleOrDefault(item => item.EmployeeIdentityDocumentId == SelectedIdentityDocumentId);
            return record is null ? "Kimlik/Belge" : $"{record.DocumentType} {record.DocumentNumber}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;
        if (!PageAccessService.CanAccessPersonnelInformation(CurrentUser)) { NavigationManager.NavigateTo(CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login", replace: true); return; }
        CanSelectEmployees = PageAccessService.HasPermission(CurrentUser, PermissionNames.CanViewAllPersonnelInformation);
        var initialSelection = await PersonnelEmployeeLookupService.ResolveInitialAsync(CurrentUser, RequestedEmployeeId);
        if (initialSelection is not null && !(await PersonnelAuthorizationService.ResolveAsync(CurrentUser, initialSelection.EmployeeId)).CanViewSensitive)
        {
            initialSelection = await PersonnelEmployeeLookupService.FindAsync(CurrentUser, CurrentUser.GetEmployeeId());
        }
        SelectedEmployeeId = initialSelection?.EmployeeId;
        SelectedEmployeeDisplay = initialSelection?.DisplayName ?? "Çalışan kaydı bulunamadı.";
        await LoadAsync(); IsReady = true;
    }

    private async Task SelectEmployeeAsync(int? id)
    {
        if (id.HasValue && !(await PersonnelAuthorizationService.ResolveAsync(CurrentUser, id.Value)).CanViewSensitive) { SetFeedback(Severity.Error, "Bu çalışanın hassas bilgilerini görüntüleme yetkiniz yok."); return; }
        SelectedEmployeeId = id; CloseEntryDialog(); CloseDocumentDialog(); await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Access = SelectedEmployeeId.HasValue ? await PersonnelAuthorizationService.ResolveAsync(CurrentUser, SelectedEmployeeId.Value) : PersonnelAccessDecision.Denied;
        if (!SelectedEmployeeId.HasValue || !Access.CanViewSensitive) { Records = []; Documents = []; return; }
        Records = await Database.EmployeeIdentityDocuments.AsNoTracking().Where(record => record.EmployeeId == SelectedEmployeeId.Value).OrderBy(record => record.DocumentType).ThenBy(record => record.DocumentNumber).ToListAsync();
        Documents = (await EmployeeFileService.GetDocumentsAsync(CurrentUser, SelectedEmployeeId.Value)).ToList();
    }

    private async Task SaveAsync()
    {
        if (!SelectedEmployeeId.HasValue || !(await PersonnelAuthorizationService.ResolveAsync(CurrentUser, SelectedEmployeeId.Value)).CanEditSensitive) { SetFeedback(Severity.Error, "Bu çalışanın hassas bilgilerini değiştirme yetkiniz yok."); return; }
        if (Form.IssueDate.HasValue && Form.ExpiryDate.HasValue && Form.ExpiryDate < Form.IssueDate) { SetFeedback(Severity.Error, "Geçerlilik sonu düzenlenme tarihinden önce olamaz."); return; }
        try
        {
            var entity = Form.Id.HasValue ? await Database.EmployeeIdentityDocuments.SingleAsync(record => record.EmployeeIdentityDocumentId == Form.Id.Value && record.EmployeeId == SelectedEmployeeId.Value) : new EmployeeIdentityDocument { EmployeeId = SelectedEmployeeId.Value };
            entity.DocumentType = Form.DocumentType.Trim(); entity.DocumentNumber = Form.DocumentNumber.Trim(); entity.IssuingAuthority = Normalize(Form.IssuingAuthority); entity.IssueDate = ToDateOnly(Form.IssueDate); entity.ExpiryDate = ToDateOnly(Form.ExpiryDate); entity.Description = Normalize(Form.Description);
            if (!Form.Id.HasValue) Database.EmployeeIdentityDocuments.Add(entity);
            await AuditAsync("Kimlik/belge bilgisi güncellendi."); await Database.SaveChangesAsync(); IsEntryDialogOpen = false; ResetForm(); await LoadAsync(); SetFeedback(Severity.Success, "Kimlik/belge bilgisi kaydedildi.");
        }
        catch (Exception exception) when (exception is DbUpdateException or InvalidOperationException)
        {
            Database.ChangeTracker.Clear(); await LoadAsync(); SetFeedback(Severity.Error, "Aynı tür ve numarada bir belge zaten bulunuyor veya kayıt kaydedilemedi.");
        }
    }

    private void OpenEntryDialog() { Form = new(); FeedbackMessage = null; IsEntryDialogOpen = true; }
    private void CloseEntryDialog() { Form = new(); FeedbackMessage = null; IsEntryDialogOpen = false; }
    private void Edit(EmployeeIdentityDocument record) { Form = new() { Id = record.EmployeeIdentityDocumentId, DocumentType = record.DocumentType, DocumentNumber = record.DocumentNumber, IssuingAuthority = record.IssuingAuthority, IssueDate = ToDateTime(record.IssueDate), ExpiryDate = ToDateTime(record.ExpiryDate), Description = record.Description }; FeedbackMessage = null; IsEntryDialogOpen = true; }
    private void OpenDocumentDialog(EmployeeIdentityDocument record) { SelectedIdentityDocumentId = record.EmployeeIdentityDocumentId; FeedbackMessage = null; IsDocumentDialogOpen = true; }
    private void CloseDocumentDialog() { SelectedIdentityDocumentId = null; FeedbackMessage = null; IsDocumentDialogOpen = false; }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs eventArgs)
    {
        if (!SelectedEmployeeId.HasValue || !SelectedIdentityDocumentId.HasValue || IsDocumentUploading) return;
        IsDocumentUploading = true; FeedbackMessage = null;
        try
        {
            var file = eventArgs.File;
            await using var content = file.OpenReadStream(EmployeeFileContentPolicy.MaxDocumentBytes);
            await EmployeeFileService.UploadIdentityDocumentAsync(CurrentUser, SelectedEmployeeId.Value, SelectedIdentityDocumentId.Value, new EmployeeFileUpload(content, file.Name, file.Size));
            await LoadAsync(); SetFeedback(Severity.Success, $"{file.Name} kimlik/belge kaydına eklendi.");
        }
        catch (EmployeeFileValidationException exception) { SetFeedback(Severity.Warning, exception.Message); }
        catch (IOException) { SetFeedback(Severity.Warning, "Belge en fazla 20 MB olabilir."); }
        catch (Exception exception) { Logger.LogError(exception, "Kimlik/belge dosyası yüklenemedi."); SetFeedback(Severity.Error, "Kimlik/belge dosyası yüklenemedi. Lütfen yeniden deneyin."); }
        finally { IsDocumentUploading = false; }
    }

    private async Task DeleteAsync(EmployeeIdentityDocument record)
    {
        if (!SelectedEmployeeId.HasValue || !(await PersonnelAuthorizationService.ResolveAsync(CurrentUser, SelectedEmployeeId.Value)).CanEditSensitive) { SetFeedback(Severity.Error, "Bu çalışanın hassas bilgilerini değiştirme yetkiniz yok."); return; }
        if (await DialogService.ShowMessageBoxAsync("Kaydı Sil", "Kimlik/belge kaydını silmek istediğinizden emin misiniz?", yesText: "Sil", cancelText: "İptal") != true) return;
        try
        {
            Database.EmployeeIdentityDocuments.Remove(await Database.EmployeeIdentityDocuments.SingleAsync(entity => entity.EmployeeIdentityDocumentId == record.EmployeeIdentityDocumentId && entity.EmployeeId == SelectedEmployeeId.Value));
            await AuditAsync("Kimlik/belge bilgisi silindi."); await Database.SaveChangesAsync(); ResetForm(); await LoadAsync(); SetFeedback(Severity.Success, "Kimlik/belge kaydı silindi.");
        }
        catch (Exception exception) when (exception is DbUpdateException or InvalidOperationException)
        {
            Database.ChangeTracker.Clear(); await LoadAsync(); SetFeedback(Severity.Error, "Kimlik/belge kaydı silinemedi. Kayda bağlı dosya bulunuyor veya kayıt yenilenmiş olabilir.");
        }
    }

    private int DocumentCount(int identityDocumentId) => Documents.Count(document => document.EmployeeIdentityDocumentId == identityDocumentId);
    private Task AuditAsync(string detail) => AuditLogService.AppendAsync(AuditActionType.EmployeeUpdated, nameof(EmployeeIdentityDocument), SelectedEmployeeId!.Value.ToString(), CurrentUser.GetRequiredEmployeeId(), detail);
    private void ResetForm() => Form = new();
    private void SetFeedback(Severity severity, string message) { FeedbackSeverity = severity; FeedbackMessage = message; }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string Sensitive(string? value) => CurrentUser.GetEmployeeId() == SelectedEmployeeId
        ? Display(value)
        : PersonnelSensitiveValue.Mask(value);
    private static string Date(DateOnly? value) => value?.ToString("dd.MM.yyyy") ?? "-";
    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static DateOnly? ToDateOnly(DateTime? value) => value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    private static DateTime? ToDateTime(DateOnly? value) => value?.ToDateTime(TimeOnly.MinValue);

    private sealed class IdentityDocumentForm : IValidatableObject
    {
        public int? Id { get; set; }
        [Required(ErrorMessage = "Belge türü zorunludur.")][MaxLength(80)] public string DocumentType { get; set; } = string.Empty;
        [Required(ErrorMessage = "Belge numarası zorunludur.")][MaxLength(80)] public string DocumentNumber { get; set; } = string.Empty;
        [Required(ErrorMessage = "Düzenleyen kurum zorunludur.")][MaxLength(120)] public string? IssuingAuthority { get; set; }
        [Required(ErrorMessage = "Düzenlenme tarihi zorunludur.")]
        public DateTime? IssueDate { get; set; }
        public DateTime? ExpiryDate { get; set; }
        [MaxLength(500)] public string? Description { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext) =>
            PersonnelRecordValidator.ValidateIdentityDocument(IssuingAuthority, IssueDate, ExpiryDate);
    }
}
