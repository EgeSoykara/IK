@attribute [Authorize]
@page "/AuditLogs"
@using System.Globalization
@using IK.Web.Database
@using IK.Web.Models
@using IK.Web.Services
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccessService

<div class="management-shell">
    <section class="management-page-header">
        <div>
            <MudText Typo="Typo.overline">Yönetim</MudText>
            <h1>Denetim Kayıtları</h1>
            <p>Sistemde gerçekleşen işlemleri, çalışan ve zaman bilgileriyle kronolojik olarak izleyin.</p>
        </div>
    </section>

    @if (_canViewAuditLogs)
    {
        <section class="management-page-filters" aria-label="Denetim kaydı filtreleri">
            <ManagementFilterButton AriaLabel="Denetim kayıtlarını filtrele" OnClick="OpenSearchDialog" />
            <ManagementActiveFilters Filters="ActiveFilters"
                                     OnRemove="RemoveFilterAsync"
                                     OnClearAll="ClearFiltersAsync" />
        </section>

        <section class="audit-quick-presets" aria-label="Hızlı denetim görünümleri">
            <MudText Typo="Typo.caption">Hızlı Görünümler</MudText>
            <div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Today" OnClick="@(() => ApplyQuickDateRangeAsync(1))">Bugün</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DateRange" OnClick="@(() => ApplyQuickDateRangeAsync(7))">Son 7 Gün</MudButton>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Person"
                           Disabled="@(CurrentActorOption is null)"
                           OnClick="ApplyMyActionsAsync">
                    Benim İşlemlerim
                </MudButton>
            </div>
        </section>
    }

    @if (FeedbackMessage is not null && !IsSearchDialogOpen)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="management-feedback">@FeedbackMessage</MudAlert>
    }

    <MudDialog @bind-Visible="IsSearchDialogOpen" Options="SearchDialogOptions">
        <TitleContent><MudText Typo="Typo.h6">Denetim Kaydı Ara</MudText></TitleContent>
        <DialogContent>
            @if (FeedbackMessage is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@FeedbackMessage</MudAlert>
            }
            <MudAutocomplete T="AuditActorOption"
                             @bind-Value="SearchDraft.Actor"
                             Label="Çalışan"
                             SearchFunc="SearchAuditEmployeesAsync"
                             ToStringFunc="@(option => option?.Label ?? string.Empty)"
                             CoerceValue="false"
                             ResetValueOnEmptyText="true"
                             Clearable="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                             HelperText="İşlemi yapan çalışanın adını, soyadını veya sicil numarasını yazıp listeden seçin." />
            <MudSelect T="AuditActionType?" @bind-Value="SearchDraft.ActionType" Label="İşlem" Clearable="true">
                @foreach (var actionType in Enum.GetValues<AuditActionType>())
                {
                    <MudSelectItem T="AuditActionType?" Value="@((AuditActionType?)actionType)">
                        @FormatAuditActionType(actionType)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudDatePicker @bind-Date="SearchDraft.StartDate" Label="Başlangıç Tarihi" Clearable="true" />
            <MudDatePicker @bind-Date="SearchDraft.EndDate" Label="Bitiş Tarihi" Clearable="true" />
            <div class="audit-quick-date-filters" aria-label="Hızlı tarih seçimi">
                <MudText Typo="Typo.caption">Hızlı tarih seçimi</MudText>
                <div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuickDateRange(1))">Bugün</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuickDateRange(7))">Son 7 Gün</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuickDateRange(30))">Son 30 Gün</MudButton>
                </div>
            </div>
            <MudTextField T="string"
                          @bind-Value="SearchDraft.Text"
                          Label="Detayda geçen ifade"
                          Placeholder="Örn. çalışan adı, izin günü veya departman"
                          Immediate="true"
                          Clearable="true" />
            <div class="management-search-actions">
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearFiltersAsync">Filtreleri Temizle</MudButton>
                <div class="management-search-actions-primary">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CloseSearchDialog">İptal</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PerformSearchAsync">Ara</MudButton>
                </div>
            </div>
        </DialogContent>
    </MudDialog>

    <MudDialog @bind-Visible="IsDetailDialogOpen" Options="DetailDialogOptions">
        <TitleContent><MudText Typo="Typo.h6">Denetim Kaydı Detayı</MudText></TitleContent>
        <DialogContent>
            @if (SelectedAuditLog is not null)
            {
                <dl class="audit-detail-list">
                    <div><dt>İşlemi yapan</dt><dd>@SelectedAuditLog.ActorDisplayName</dd></div>
                    <div><dt>Yapılan işlem</dt><dd>@FormatAuditActionType(SelectedAuditLog.ActionType)</dd></div>
                    <div><dt>İşlem zamanı</dt><dd>@FormatActionDate(SelectedAuditLog.ActionDate)</dd></div>
                    <div class="audit-detail-description"><dt>İşlem açıklaması</dt><dd>@AuditLogPresentation.FormatDetails(SelectedAuditLog)</dd></div>
                </dl>
                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseDetailDialog">Kapat</MudButton>
                </div>
            }
        </DialogContent>
    </MudDialog>

@if (_canViewAuditLogs && HasSearched)
{
    <MudTable @ref="AuditLogTable"
              ServerData="LoadAuditLogsAsync"
              RowsPerPage="25"
              Dense="true"
              Hover="true"
              Class="management-data-table">
        <HeaderContent>
            <MudTh>İşlemi yapan</MudTh>
            <MudTh>İşlem</MudTh>
            <MudTh>Detay</MudTh>
            <MudTh>Tarih</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="İşlemi yapan">
                <MudText Typo="Typo.body2">@context.ActorDisplayName</MudText>
            </MudTd>
            <MudTd DataLabel="İşlem">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Primary">
                    @FormatAuditActionType(context.ActionType)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Detay">
                <div class="audit-detail-preview">
                    <MudText Typo="Typo.body2">@BuildDetailPreview(context)</MudText>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               aria-label="@($"{context.AuditLogId} numaralı denetim kaydının detayını görüntüle")"
                               OnClick="@(() => OpenDetailDialog(context))">
                        Detayı Gör
                    </MudButton>
                </div>
            </MudTd>
            <MudTd DataLabel="Tarih">
                <MudText Typo="Typo.body2">@FormatActionDate(context.ActionDate)</MudText>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@AuditLogPageSizeOptions"
                           RowsPerPageString="Sayfa başına kayıt:"
                           InfoFormat="{first_item}-{last_item} / {all_items}" />
        </PagerContent>
        <NoRecordsContent>
            <MudText>Seçtiğiniz filtrelere uygun denetim kaydı bulunamadı.</MudText>
        </NoRecordsContent>
    </MudTable>
}
else if (_canViewAuditLogs)
{
    <MudPaper Class="management-search-empty-state" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.ManageSearch" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6">Kayıtları arayarak görüntüleyin</MudText>
        <MudText Typo="Typo.body2">Tüm kayıtlar otomatik yüklenmez. Çalışan, işlem, tarih veya detay filtresi seçin.</MudText>
    </MudPaper>
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private ClaimsPrincipal? CurrentUser { get; set; }
    private static readonly int[] AuditLogPageSizeOptions = [10, 25, 50, 100];
    private static readonly DialogOptions SearchDialogOptions = new()
    {
        BackdropClick = false,
        CloseOnEscapeKey = false,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };
    private bool _canViewAuditLogs;
    private bool IsSearchDialogOpen { get; set; }
    private bool IsDetailDialogOpen { get; set; }
    private bool HasSearched { get; set; }
    private string? FeedbackMessage { get; set; }
    private MudTable<AuditLog>? AuditLogTable { get; set; }
    private AuditLogSearchForm SearchForm { get; set; } = new();
    private AuditLogSearchForm SearchDraft { get; set; } = new();
    private AuditLog? SelectedAuditLog { get; set; }
    private AuditActorOption? CurrentActorOption { get; set; }

    private static readonly DialogOptions DetailDialogOptions = new()
    {
        BackdropClick = true,
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    [Inject]
    public AuditLogPageService AuditLogPageService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = (await AuthTask).User;

        _canViewAuditLogs = await PageAccessService.CanAccessAuditLogsAsync(CurrentUser);

        if (!_canViewAuditLogs)
        {
            NavigationManager.NavigateTo(
                CurrentUser.Identity?.IsAuthenticated == true ? "/unauthorized" : "/login",
                replace: true);
            return;
        }

        if (CurrentUser.GetEmployeeId() is { } employeeId)
        {
            CurrentActorOption = await AuditLogPageService.GetEmployeeOptionAsync(CurrentUser, employeeId);
        }
    }

    private async Task<TableData<AuditLog>> LoadAuditLogsAsync(TableState state, CancellationToken cancellationToken)
    {
        var pageSize = Math.Max(1, state.PageSize);
        var page = Math.Max(0, state.Page);

        var pageResult = await AuditLogPageService.GetPageAsync(
            CurrentUser,
            page,
            pageSize,
            SearchForm.ToCriteria(),
            cancellationToken);

        return new TableData<AuditLog>
        {
            Items = pageResult.Items,
            TotalItems = pageResult.TotalItems
        };
    }

    private void OpenSearchDialog()
    {
        SearchDraft = SearchForm.Clone();
        FeedbackMessage = null;
        IsSearchDialogOpen = true;
    }

    private void CloseSearchDialog() => IsSearchDialogOpen = false;

    private Task<IEnumerable<AuditActorOption>> SearchAuditEmployeesAsync(string value, CancellationToken cancellationToken) =>
        SearchAuditEmployeesCoreAsync(value, cancellationToken);

    private async Task<IEnumerable<AuditActorOption>> SearchAuditEmployeesCoreAsync(string value, CancellationToken cancellationToken) =>
        await AuditLogPageService.SearchEmployeesAsync(CurrentUser, value, cancellationToken: cancellationToken);

    private static DateTime Today => DateTime.Today;

    private void SetQuickDateRange(int dayCount)
    {
        SearchDraft.StartDate = Today.AddDays(-(dayCount - 1));
        SearchDraft.EndDate = Today;
    }

    private async Task ApplyQuickDateRangeAsync(int dayCount)
    {
        SearchForm.StartDate = Today.AddDays(-(dayCount - 1));
        SearchForm.EndDate = Today;
        SearchDraft = SearchForm.Clone();
        HasSearched = true;
        FeedbackMessage = null;
        await ReloadTableAsync(resetPage: true);
    }

    private async Task ApplyMyActionsAsync()
    {
        if (CurrentActorOption is null)
        {
            return;
        }

        SearchForm.Actor = CurrentActorOption;
        SearchDraft = SearchForm.Clone();
        HasSearched = true;
        FeedbackMessage = null;
        await ReloadTableAsync(resetPage: true);
    }

    private void OpenDetailDialog(AuditLog auditLog)
    {
        SelectedAuditLog = auditLog;
        IsDetailDialogOpen = true;
    }

    private void CloseDetailDialog()
    {
        IsDetailDialogOpen = false;
        SelectedAuditLog = null;
    }

    private static string BuildDetailPreview(AuditLog auditLog)
    {
        const int maxLength = 95;
        var detail = AuditLogPresentation.FormatDetails(auditLog);
        return detail.Length <= maxLength ? detail : $"{detail[..maxLength].TrimEnd()}…";
    }

    private async Task PerformSearchAsync()
    {
        var normalized = SearchDraft.Normalize();
        if (!normalized.ToCriteria().HasAny)
        {
            FeedbackMessage = "Arama yapmak için en az bir filtre seçin.";
            return;
        }
        if (normalized.StartDate.HasValue
            && normalized.EndDate.HasValue
            && normalized.EndDate.Value.Date < normalized.StartDate.Value.Date)
        {
            FeedbackMessage = "Bitiş tarihi başlangıç tarihinden önce olamaz.";
            return;
        }

        SearchForm = normalized;
        HasSearched = true;
        FeedbackMessage = null;
        IsSearchDialogOpen = false;
        await ReloadTableAsync(resetPage: true);
    }

    private async Task RemoveFilterAsync(string key)
    {
        switch (key)
        {
            case nameof(AuditLogSearchForm.Actor): SearchForm.Actor = null; break;
            case nameof(AuditLogSearchForm.ActionType): SearchForm.ActionType = null; break;
            case nameof(AuditLogSearchForm.StartDate): SearchForm.StartDate = null; break;
            case nameof(AuditLogSearchForm.EndDate): SearchForm.EndDate = null; break;
            case nameof(AuditLogSearchForm.Text): SearchForm.Text = null; break;
            default: return;
        }

        SearchDraft = SearchForm.Clone();
        HasSearched = SearchForm.ToCriteria().HasAny;
        await ReloadTableAsync(resetPage: true);
    }

    private async Task ClearFiltersAsync()
    {
        SearchForm = new();
        SearchDraft = new();
        HasSearched = false;
        FeedbackMessage = null;
        IsSearchDialogOpen = false;
        await ReloadTableAsync(resetPage: true);
    }

    private Task ReloadTableAsync(bool resetPage)
    {
        if (AuditLogTable is null) return Task.CompletedTask;
        if (resetPage && AuditLogTable.CurrentPage != 0)
        {
            AuditLogTable.NavigateTo(0);
            return Task.CompletedTask;
        }
        return AuditLogTable.ReloadServerData();
    }

    private IReadOnlyList<ManagementFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ManagementFilter>();
            if (SearchForm.Actor is not null) filters.Add(new(nameof(AuditLogSearchForm.Actor), $"Çalışan: {SearchForm.Actor.DisplayName}"));
            if (SearchForm.ActionType.HasValue) filters.Add(new(nameof(AuditLogSearchForm.ActionType), $"İşlem: {FormatAuditActionType(SearchForm.ActionType.Value)}"));
            if (SearchForm.StartDate.HasValue) filters.Add(new(nameof(AuditLogSearchForm.StartDate), $"Başlangıç: {SearchForm.StartDate:dd.MM.yyyy}"));
            if (SearchForm.EndDate.HasValue) filters.Add(new(nameof(AuditLogSearchForm.EndDate), $"Bitiş: {SearchForm.EndDate:dd.MM.yyyy}"));
            if (!string.IsNullOrWhiteSpace(SearchForm.Text)) filters.Add(new(nameof(AuditLogSearchForm.Text), $"Detay: {SearchForm.Text}"));
            return filters;
        }
    }

    private static string FormatAuditActionType(AuditActionType actionType)
    {
        return actionType switch
        {
            AuditActionType.Login => "Giriş",
            AuditActionType.EmployeeCreated => "Çalışan Oluşturuldu",
            AuditActionType.EmployeeUpdated => "Çalışan Güncellendi",
            AuditActionType.LeaveBalanceRenewed => "İzin Bakiyesi Yenilendi",
            AuditActionType.LeaveCarryOverUpdated => "İzin Devri Güncellendi",
            AuditActionType.LeaveRequestCreated => "İzin Talebi Oluşturuldu",
            AuditActionType.LeaveRequestManagerApproved => "Yönetici Talebi Onayladı",
            AuditActionType.LeaveRequestManagerRejected => "Yönetici Talebi Reddetti",
            AuditActionType.LeaveRequestHumanResourcesApproved => "İK Talebi Onayladı",
            AuditActionType.LeaveRequestHumanResourcesRejected => "İK Talebi Reddetti",
            AuditActionType.EmployeeDeleted => "Çalışan Silindi",
            AuditActionType.DepartmentCreated => "Departman Oluşturuldu",
            AuditActionType.DepartmentUpdated => "Departman Güncellendi",
            AuditActionType.DepartmentDeleted => "Departman Silindi",
            AuditActionType.LeaveTypeCreated => "İzin Türü Oluşturuldu",
            AuditActionType.LeaveTypeUpdated => "İzin Türü Güncellendi",
            AuditActionType.LeaveTypeDeleted => "İzin Türü Silindi",
            AuditActionType.LeaveRequestUpdated => "İzin Talebi Güncellendi",
            AuditActionType.LeaveRequestDeleted => "İzin Talebi Silindi",
            AuditActionType.LeaveBalanceUpdated => "İzin Bakiyesi Güncellendi",
            AuditActionType.LeaveBalanceDeleted => "İzin Bakiyesi Silindi",
            AuditActionType.LeaveApprovalDeleted => "İzin Onayı Silindi",
            AuditActionType.ProfilePhotoUploaded => "Profil Fotoğrafı Yüklendi",
            AuditActionType.EmployeeDocumentUploaded => "Çalışan Belgesi Yüklendi",
            AuditActionType.PublicHolidayCreated => "Resmî Tatil Eklendi",
            AuditActionType.PublicHolidayUpdated => "Resmî Tatil Güncellendi",
            AuditActionType.PublicHolidayDeleted => "Resmî Tatil Silindi",
            AuditActionType.PersonnelExcelImported => "Excel Verileri İçe Aktarıldı",
            AuditActionType.DepartmentManagerChanged => "Departman Yöneticisi Değiştirildi",
            AuditActionType.ManagerDelegationActivated => "Yönetici Vekâleti Başlatıldı",
            AuditActionType.ManagerDelegationRestored => "Yönetici Vekâleti Sona Erdi",
            AuditActionType.ManagerDelegationTransferred => "Yönetici Vekâleti Devredildi",
            AuditActionType.LeaveRequestCancelled => "İzin Talebi İptal Edildi",
            AuditActionType.LeaveCancellationRequested => "İzin İptal Talebi Oluşturuldu",
            AuditActionType.LeaveCancellationManagerApproved => "Müdür İptal Talebini Onayladı",
            AuditActionType.LeaveCancellationManagerRejected => "Müdür İptal Talebini Reddetti",
            AuditActionType.LeaveCancellationHumanResourcesApproved => "İK İptal Talebini Onayladı",
            AuditActionType.LeaveCancellationHumanResourcesRejected => "İK İptal Talebini Reddetti",
            AuditActionType.EmployeeTerminationCreated => "İşten Ayrılma Kaydı Oluşturuldu",
            AuditActionType.EmployeeTerminationUpdated => "İşten Ayrılma Kaydı Güncellendi",
            AuditActionType.EmployeeTerminationDeleted => "İşten Ayrılma Kaydı Silindi",
            AuditActionType.EmployeeDocumentViewed => "Çalışan Belgesi Görüntülendi",
            AuditActionType.EmployeeDocumentDownloaded => "Çalışan Belgesi İndirildi",
            AuditActionType.PasswordChanged => "Şifre Değiştirildi",
            _ => actionType.ToString()
        };
    }

    private static string FormatActionDate(DateTimeOffset actionDate) =>
        actionDate.ToLocalTime().ToString(
            "d MMMM yyyy, HH:mm",
            CultureInfo.GetCultureInfo("tr-TR"));

    private sealed class AuditLogSearchForm
    {
        public AuditActorOption? Actor { get; set; }
        public AuditActionType? ActionType { get; set; }
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? Text { get; set; }

        public AuditLogSearchForm Clone() => (AuditLogSearchForm)MemberwiseClone();

        public AuditLogSearchForm Normalize()
        {
            var clone = Clone();
            clone.Text = NormalizeText(clone.Text);
            clone.StartDate = clone.StartDate?.Date;
            clone.EndDate = clone.EndDate?.Date;
            return clone;
        }

        public AuditLogSearchCriteria ToCriteria() => new(
            Actor?.EmployeeId,
            ActionType,
            StartDate.HasValue ? DateOnly.FromDateTime(StartDate.Value) : null,
            EndDate.HasValue ? DateOnly.FromDateTime(EndDate.Value) : null,
            Text);

        private static string? NormalizeText(string? value) =>
            string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }
}
