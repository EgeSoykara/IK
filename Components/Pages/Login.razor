@attribute [AllowAnonymous]
@layout IK.Web.Components.Layout.LoginLayout
@page "/login"

@using Microsoft.AspNetCore.WebUtilities
@using IK.Web.Services
@inject NavigationManager Nav

<PageTitle>Giriş</PageTitle>

<MudPaper Class="login-card p-6 pa-5" Elevation="12" Square="false">
    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            @Error
        </MudAlert>
    }

    <form method="post" action="@FormAction" novalidate>
        <AntiforgeryToken />
        <MudStack Spacing="2" Class="mb-2">
            <MudText Typo="Typo.h5" Align="Align.Center">Kullanıcı Girişi</MudText>
            <MudTextField T="string"
                          @bind-Value="Identifier"
                          Label="Kullanıcı adı"
                          InputType="InputType.Text"
                          Variant="Variant.Outlined"
                          name="Identifier" />
            <MudTextField T="string"
                          @bind-Value="Password"
                          Label="Şifre"
                          name="Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password" />
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       ButtonType="ButtonType.Submit"
                       FullWidth="true">
                GİRİŞ YAP
            </MudButton>
        </MudStack>
    </form>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthTask { get; set; } = default!;

    private string Identifier { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string? Error { get; set; }
    private string FormAction { get; set; } = "/auth/login";

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);

        var returnUrl = query.TryGetValue("ReturnUrl", out var value)
            ? LoginReturnUrl.Normalize(value.ToString())
            : null;
        if (returnUrl is not null)
        {
            FormAction = $"/auth/login?ReturnUrl={Uri.EscapeDataString(returnUrl)}";
        }

        if (query.TryGetValue("error", out var error))
        {
            Error = error.ToString() switch
            {
                "invalid" => "Kullanıcı adı veya şifre hatalı.",
                "missing" => "Lütfen kullanıcı adı ve şifre giriniz.",
                _ => error.ToString()
            };
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState = await AuthTask;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
            var returnUrl = query.TryGetValue("ReturnUrl", out var value)
                ? LoginReturnUrl.Normalize(value.ToString()) ?? "/"
                : "/";

            Nav.NavigateTo(returnUrl, forceLoad: true);
        }
    }
}
